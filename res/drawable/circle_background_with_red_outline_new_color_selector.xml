<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?uikitBackgroundGroup" />
                    <stroke android:width="1.0dip" android:color="?uikitStaticRed" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?uikitBackgroundGroup" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>