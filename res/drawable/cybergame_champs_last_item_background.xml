<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?uikitBackgroundGroup" />
            <corners android:bottomLeftRadius="@dimen/space_10" android:bottomRightRadius="@dimen/space_10" />
        </shape>
    </item>
    <item android:left="@dimen/space_4" android:top="@dimen/space_8" android:right="@dimen/space_4" android:bottom="@dimen/space_2">
        <shape android:shape="rectangle">
            <gradient android:startColor="#00ff0000" android:endColor="@color/static_black_10" android:angle="90.0" android:centerX="3.9999962%" android:centerColor="@color/static_black_10" />
            <corners android:bottomLeftRadius="@dimen/radius_8" android:bottomRightRadius="@dimen/radius_8" />
        </shape>
    </item>
    <item android:left="@dimen/space_4" android:right="@dimen/space_4" android:bottom="@dimen/space_4">
        <ripple android:color="?uikitRipple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?uikitBackgroundContent" />
                    <corners android:radius="@dimen/radius_8" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>