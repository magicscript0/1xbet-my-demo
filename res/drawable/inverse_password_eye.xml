<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:id="@id/visible" android:drawable="@drawable/ic_glyph_hide" />
    <item android:id="@id/masked" android:drawable="@drawable/ic_glyph_show" />
    <transition android:drawable="@drawable/ic_glyph_show" android:toId="@id/masked" android:fromId="@id/visible" />
    <transition android:drawable="@drawable/ic_glyph_show" android:toId="@id/visible" android:fromId="@id/masked" />
</animated-selector>