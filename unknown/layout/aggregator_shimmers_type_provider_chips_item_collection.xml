<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmersParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical">

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer1"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:radius="@dimen/radius_16" />

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer2"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:layout_marginTop="@dimen/size_8"
        android:radius="@dimen/radius_16" />

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer3"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:layout_marginTop="@dimen/size_8"
        android:radius="@dimen/radius_16" />

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer4"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:layout_marginTop="@dimen/size_8"
        android:radius="@dimen/radius_16" />

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer5"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:layout_marginTop="@dimen/size_8"
        android:radius="@dimen/radius_16" />

</LinearLayout>