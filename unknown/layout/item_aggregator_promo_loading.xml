        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_strong_shimmer_item"
            android:backgroundTint="?attr/uikitSecondary" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/firstSocialBody"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_64"
        android:layout_marginHorizontal="@dimen/space_12"
        android:layout_marginTop="@dimen/space_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/socialTitle">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_strong_shimmer_item"
            android:backgroundTint="?attr/uikitSecondary" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/secondSocialBody"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_64"
        android:layout_marginHorizontal="@dimen/space_12"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/firstSocialBody">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_strong_shimmer_item"
