<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/tournamentTitle"
        android:layout_width="@dimen/size_120"
        android:layout_height="@dimen/size_20"
        android:layout_marginHorizontal="@dimen/space_12"
        android:layout_marginTop="@dimen/space_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_strong_shimmer_item"
            android:backgroundTint="?attr/uikitSecondary" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/tournamentBody"
        android:layout_width="@dimen/size_256"
        android:layout_height="@dimen/size_190"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginTop="@dimen/space_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tournamentTitle">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_strong_shimmer_item"
            android:backgroundTint="?attr/uikitSecondary" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/secondTournamentBody"
        android:layout_height="@dimen/size_190"
        android:layout_width="@dimen/size_256"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tournamentBody"
        app:layout_constraintStart_toEndOf="@+id/tournamentBody"
