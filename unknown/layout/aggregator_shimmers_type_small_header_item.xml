<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llShimmerParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical">

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmerHeader"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="@dimen/size_96"
        android:layout_height="@dimen/size_12"
        android:layout_marginVertical="@dimen/size_12"
        android:layout_marginStart="@dimen/size_16"

        android:radius="@dimen/radius_16" />

    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmerBody"
        style="@style/Widget.DSShimmer.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_8"
        android:radius="@dimen/radius_16" />

</LinearLayout>