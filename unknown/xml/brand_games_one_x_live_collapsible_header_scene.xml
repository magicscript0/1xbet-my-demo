<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1000"
        motion:motionInterpolator="linear" />

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/ivBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_200"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/navigationBarAggregator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent" />
        <Constraint
            android:id="@+id/tvTitleStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_72"
            android:alpha="1.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/btnBackBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnBack"
            motion:layout_constraintEnd_toEndOf="@id/btnBack"
            motion:layout_constraintStart_toStartOf="@id/btnBack"
            motion:layout_constraintTop_toTopOf="@id/btnBack" />
        <Constraint
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_56"
            android:alpha="1.0"
            android:layout_marginStart="@dimen/space_10"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="0" />
        </Constraint>

        <Constraint
            android:id="@+id/btnSearchBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnSearch"
            motion:layout_constraintEnd_toEndOf="@id/btnSearch"
            motion:layout_constraintStart_toStartOf="@id/btnSearch"
            motion:layout_constraintTop_toTopOf="@id/btnSearch"
            motion:visibilityMode="ignore" />
        <Constraint
            android:id="@+id/btnSearch"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_56"
            android:layout_marginEnd="@dimen/space_12"
            android:alpha="1.0"
            motion:layout_constraintEnd_toStartOf="@id/btnInfo"
            motion:layout_constraintTop_toTopOf="parent"
            motion:visibilityMode="ignore">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="0" />
        </Constraint>

        <Constraint
            android:id="@+id/btnInfoBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnInfo"
            motion:layout_constraintEnd_toEndOf="@id/btnInfo"
            motion:layout_constraintStart_toStartOf="@id/btnInfo"
            motion:layout_constraintTop_toTopOf="@id/btnInfo"
            motion:visibilityMode="ignore" />
        <Constraint
            android:id="@+id/btnInfo"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_56"
            android:layout_marginEnd="@dimen/space_6"
            android:alpha="1.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:visibilityMode="ignore">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="0" />
        </Constraint>

        <Constraint
            android:id="@+id/accountSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="1.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/tvTitleStart"
            motion:visibilityMode="ignore" />

        <Constraint
            android:id="@+id/authButtonsGroup"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_16"
            android:alpha="1.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/tvTitleStart"
            motion:visibilityMode="ignore" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/ivBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_200"
            android:alpha="0"
            android:scaleX="1.1"
            android:scaleY="1.1"
            android:translationX="0dp"
            android:translationY="100dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@+id/navigationBarAggregator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="1.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent" />
        <Constraint
            android:id="@+id/tvTitleStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_72"
            android:alpha="0.0"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/btnBackBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnBack"
            motion:layout_constraintEnd_toEndOf="@id/btnBack"
            motion:layout_constraintStart_toStartOf="@id/btnBack"
            motion:layout_constraintTop_toTopOf="@id/btnBack" />
        <Constraint
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_56"
            android:layout_marginStart="@dimen/space_10"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="1" />
        </Constraint>

        <Constraint
            android:id="@+id/btnSearchBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnSearch"
            motion:layout_constraintEnd_toEndOf="@id/btnSearch"
            motion:layout_constraintStart_toStartOf="@id/btnSearch"
            motion:layout_constraintTop_toTopOf="@id/btnSearch"
            motion:visibilityMode="ignore" />
        <Constraint
            android:id="@+id/btnSearch"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_56"
            android:layout_marginEnd="@dimen/space_12"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toStartOf="@id/btnInfo"
            motion:visibilityMode="ignore">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="1" />
        </Constraint>

        <Constraint
            android:id="@+id/btnInfoBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnInfo"
            motion:layout_constraintEnd_toEndOf="@id/btnInfo"
            motion:layout_constraintStart_toStartOf="@id/btnInfo"
            motion:layout_constraintTop_toTopOf="@id/btnInfo"
            motion:visibilityMode="ignore" />
        <Constraint
            android:id="@+id/btnInfo"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_56"
            android:layout_marginEnd="@dimen/space_6"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:visibilityMode="ignore">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="1" />
        </Constraint>

        <Constraint
            android:id="@+id/accountSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_8"
            android:alpha="0.0"
            android:visibility="invisible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/tvTitleStart" />

        <Constraint
            android:id="@+id/authButtonsGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_16"
            android:alpha="0.0"
            android:visibility="invisible"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/tvTitleStart" />
    </ConstraintSet>

</MotionScene>