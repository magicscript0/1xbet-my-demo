<?xml version="1.0" encoding="utf-8"?>
<set android:ordering="together"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator android:interpolator="@android:anim/linear_interpolator" android:duration="1500" android:repeatCount="infinite">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="fillAlpha">
            <keyframe android:value="0.2" android:fraction="0.0" />
            <keyframe android:value="0.4" android:fraction="0.15" />
            <keyframe android:value="0.8" android:fraction="0.3" />
            <keyframe android:value="0.4" android:fraction="0.45" />
            <keyframe android:value="0.2" android:fraction="0.6" />
            <keyframe android:value="0.2" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator android:interpolator="@android:anim/linear_interpolator" android:duration="1500" android:repeatCount="infinite">
        <propertyValuesHolder android:valueType="floatType" android:propertyName="strokeAlpha">
            <keyframe android:value="0.2" android:fraction="0.0" />
            <keyframe android:value="0.4" android:fraction="0.15" />
            <keyframe android:value="0.8" android:fraction="0.3" />
            <keyframe android:value="0.4" android:fraction="0.45" />
            <keyframe android:value="0.2" android:fraction="0.6" />
            <keyframe android:value="0.2" android:fraction="1.0" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
