<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1000"
        motion:motionInterpolator="linear" />

    <ConstraintSet android:id="@+id/start">

        <Constraint
            android:id="@+id/ivBackground"
            android:alpha="1.0"
            android:scaleX="1.0"
            android:scaleY="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@+id/vBlackoutTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_80"
            android:alpha="1"
            motion:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@+id/vBlackoutBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_108"
            android:alpha="1"
            motion:layout_constraintBottom_toBottomOf="parent" />

        <Constraint
            android:id="@+id/tvTitleEnd"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:layout_marginStart="@dimen/space_48"
            android:layout_marginEnd="@dimen/space_48"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />

        <Constraint
            android:id="@+id/tvTitleStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_80"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_4"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />

        <Constraint
            android:id="@+id/btnBackBackground"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnBack"
            motion:layout_constraintEnd_toEndOf="@id/btnBack"
            motion:layout_constraintStart_toStartOf="@id/btnBack"
            motion:layout_constraintTop_toTopOf="@id/btnBack" />

        <Constraint
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_size_56"
            android:layout_height="@dimen/icon_size_56"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="0" />
        </Constraint>

        <Constraint
            android:id="@+id/chipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:alpha="1.0"
            motion:layout_constraintBottom_toTopOf="@id/tvTitleStart"
            motion:visibilityMode="ignore" />

    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/ivBackground"
            android:alpha="0"
            android:scaleX="1.0"
            android:scaleY="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@+id/vBlackoutTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_80"
            android:alpha="0"
            motion:layout_constraintTop_toTopOf="parent" />

        <Constraint
            android:id="@+id/vBlackoutBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_108"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="parent" />

        <Constraint
            android:id="@+id/tvTitleEnd"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"
            android:layout_marginStart="@dimen/space_48"
            android:layout_marginEnd="@dimen/space_48"
            android:layout_marginBottom="@dimen/space_4"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />

        <Constraint
            android:id="@+id/tvTitleStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />

        <Constraint
            android:id="@+id/btnBackBackground"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnBack"
            motion:layout_constraintEnd_toEndOf="@id/btnBack"
            motion:layout_constraintStart_toStartOf="@id/btnBack"
            motion:layout_constraintTop_toTopOf="@id/btnBack" />

        <Constraint
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_size_56"
            android:layout_height="@dimen/icon_size_56"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="1" />
        </Constraint>

        <Constraint
            android:id="@+id/chipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:alpha="0.0"
            motion:layout_constraintBottom_toTopOf="@id/tvTitleStart"
            motion:visibilityMode="ignore" />
    </ConstraintSet>
</MotionScene>
