<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1000"
        motion:motionInterpolator="linear" />

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/ivBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_228"
            android:alpha="1.0"
            android:scaleX="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/vBlackoutBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_228"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/tvTitleEnd"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_48"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />
        <Constraint
            android:id="@+id/tvTitleStart"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_84"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginTop="@dimen/size_64"
            android:alpha="1.0"
            motion:layout_constraintBottom_toTopOf="@+id/tagGroup"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />
        <Constraint
            android:id="@+id/btnBackBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnBack"
            motion:layout_constraintEnd_toEndOf="@id/btnBack"
            motion:layout_constraintStart_toStartOf="@id/btnBack"
            motion:layout_constraintTop_toTopOf="@id/btnBack" />
        <Constraint
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_size_48"
            android:layout_height="@dimen/icon_size_56"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="0" />
        </Constraint>
        <Constraint
            android:id="@+id/tagGroup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:alpha="1.0"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/ivBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_228"
            android:alpha="0"
            android:scaleX="1.0"
            android:scaleY="1.0"
            android:translationX="0dp"
            android:translationY="100dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/vBlackoutBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_228"
            android:alpha="0"
            android:scaleX="1.0"
            android:scaleY="1.0"
            android:translationX="0dp"
            android:translationY="100dp"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toTopOf="parent" />
        <Constraint
            android:id="@+id/tvTitleEnd"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_48"
            android:layout_marginBottom="@dimen/space_4"
            android:alpha="1.0"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />
        <Constraint
            android:id="@+id/tvTitleStart"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_84"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:alpha="0.0"
            motion:layout_constraintBottom_toTopOf="@+id/tagGroup"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />
        <Constraint
            android:id="@+id/btnBackBackground"
            android:layout_width="@dimen/icon_size_36"
            android:layout_height="@dimen/icon_size_36"
            android:alpha="0.0"
            motion:layout_constraintBottom_toBottomOf="@id/btnBack"
            motion:layout_constraintEnd_toEndOf="@id/btnBack"
            motion:layout_constraintStart_toStartOf="@id/btnBack"
            motion:layout_constraintTop_toTopOf="@id/btnBack" />
        <Constraint
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_size_48"
            android:layout_height="@dimen/icon_size_56"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintStart_toStartOf="parent">
            <CustomAttribute
                motion:attributeName="crossfade"
                motion:customFloatValue="1" />
        </Constraint>

        <Constraint
            android:id="@+id/tagGroup"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:alpha="0.0"
            android:visibility="invisible"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toStartOf="parent" />
    </ConstraintSet>
</MotionScene>
