<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="top"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <size android:height="22dp"/>
            <gradient
                android:startColor="@color/static_black_20"
                android:endColor="#00000000"
                android:angle="90"
                android:type="linear"
                android:centerColor="@color/static_black_20"/>
        </shape>
    </item>
    <item android:gravity="top|left">
        <shape android:shape="rectangle">
            <size
                android:height="22dp"
                android:width="16dp"/>
            <gradient
                android:startColor="@color/static_black_20"
                android:endColor="#00000000"
                android:angle="0"
                android:type="radial"
                android:centerX="1"
                android:centerY="1"
                android:gradientRadius="22dp"
                android:centerColor="@color/static_black_20"/>
        </shape>
    </item>
    <item android:gravity="top|right">
        <shape android:shape="rectangle">
            <size
                android:height="22dp"
                android:width="16dp"/>
            <gradient
                android:startColor="@color/static_black_20"
                android:endColor="#00000000"
                android:angle="0"
                android:type="radial"
                android:centerX="0"
                android:centerY="1"
                android:gradientRadius="22dp"
                android:centerColor="@color/static_black_20"/>
        </shape>
    </item>
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/uikitBackgroundContent"/>
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"/>
        </shape>
    </item>
</layer-list>
