        android:left="@dimen/space_8"
        android:right="@dimen/space_8">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp"/>
            <solid android:color="@color/static_white"/>
