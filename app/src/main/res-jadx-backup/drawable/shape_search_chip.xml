    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/static_black_10"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:right="0dp"
        android:bottom="@dimen/chip_shadow_size">
