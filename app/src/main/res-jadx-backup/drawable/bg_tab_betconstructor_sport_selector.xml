<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/uikitTextPrimary">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_radius_16"/>
            <solid android:color="?attr/uikitBackgroundContent"/>
        </shape>
    </item>
    <item>
        <selector>
            <item
                android:state_selected="true"
                android:drawable="@drawable/bg_tab_betconstructor_sport_selected"/>
            <item
                android:state_selected="false"
                android:drawable="@drawable/bg_tab_betconstructor_sport_unselected"/>
        </selector>
    </item>
</layer-list>
