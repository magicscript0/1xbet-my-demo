<?xml version="1.0" encoding="utf-8"?>
<org.xplatform.ui_core.viewcomponents.motion.AppBarMotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/actionBarSize"
    app:layoutDescription="@xml/special_event_header_scene"
    app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>
    <ImageView
        android:id="@+id/ivLeft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:foregroundGravity="left"
        android:contentDescription="@null"/>
    <ImageView
        android:id="@+id/ivRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:foregroundGravity="right"
        android:contentDescription="@null"/>
    <View
        android:id="@+id/gradient"
        android:background="@drawable/special_event_header_gradient"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <View
        android:id="@+id/btnBackBackground"
        android:background="@drawable/bg_btn_back"
        android:layout_width="@dimen/icon_size_36"
        android:layout_height="@dimen/icon_size_36"/>
    <View
        android:id="@+id/btnSearchBackground"
        android:background="@drawable/bg_btn_back"
        android:layout_width="@dimen/icon_size_36"
        android:layout_height="@dimen/icon_size_36"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/btnBack"
        android:background="@null"
        android:layout_width="@dimen/size_48"
        android:layout_height="@dimen/size_48"
        app:altSrc="@drawable/ic_arrow_back_primary"
        app:srcCompat="@drawable/ic_arrow_back"/>
    <androidx.constraintlayout.utils.widget.ImageFilterButton
        android:id="@+id/btnSearch"
        android:background="@null"
        android:layout_width="@dimen/size_48"
        android:layout_height="@dimen/size_48"
        app:altSrc="@drawable/ic_glyph_search_primary"
        app:srcCompat="@drawable/ic_glyph_search"/>
    <TextView
        android:textSize="@dimen/text_32"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/expandTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        app:autoSizeMaxTextSize="@dimen/text_32"
        app:autoSizeMinTextSize="@dimen/text_20"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        style="@style/TextAppearance.Title.Bold.XL"/>
    <TextView
        android:textColor="@color/static_white_80"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/timerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/time_before_event"
        android:maxLines="1"
        style="@style/TextAppearance.Caption.Bold.Caps.M"/>
    <TextView
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:id="@+id/timerValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/TextAppearance.Text.Regular"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/collapseTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        app:autoSizeMaxTextSize="@dimen/text_20"
        app:autoSizeMinTextSize="@dimen/text_14"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        style="@style/TextAppearance.Title.Medium.M"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/collapseTimerValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        style="@style/TextAppearance.Caption.Regular.L"/>
</org.xplatform.ui_core.viewcomponents.motion.AppBarMotionLayout>
