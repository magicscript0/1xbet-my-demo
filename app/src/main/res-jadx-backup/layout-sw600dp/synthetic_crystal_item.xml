<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cybergame_crystal_view_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.cyber.game.universal.impl.presentation.timerView.SyntheticTimerView
        android:id="@+id/syntheticTimerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMedium"
        android:textColor="@color/static_white"
        android:id="@+id/tvPlayerOneName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        app:layout_constraintStart_toStartOf="@+id/guidelineStart"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMedium"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvMatchDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
        app:layout_constraintStart_toStartOf="@+id/guidelineStart"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMedium"
        android:textColor="@color/static_white"
        android:id="@+id/tvPlayerTwoName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.cyber.game.universal.impl.presentation.crystal.view.CrystalFieldView
        android:id="@+id/vCrystalField"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_14"
        android:layout_marginBottom="@dimen/space_20"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/guidelineGameFieldRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineGameFieldLeft"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"/>
    <ImageView
        android:id="@+id/ivCrystalFieldBackground"
        android:background="@drawable/cybergame_crystal_field_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/vCrystalField"
        app:layout_constraintEnd_toEndOf="@+id/vCrystalField"
        app:layout_constraintStart_toStartOf="@+id/vCrystalField"
        app:layout_constraintTop_toTopOf="@+id/vCrystalField"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMedium"
        android:textSize="@dimen/text_10"
        android:textStyle="bold"
        android:textColor="@color/static_white"
        android:id="@+id/tvFieldDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/ivCrystalFieldBackground"
        app:layout_constraintEnd_toEndOf="@+id/ivCrystalFieldBackground"
        app:layout_constraintStart_toStartOf="@+id/ivCrystalFieldBackground"
        app:layout_constraintTop_toTopOf="@+id/ivCrystalFieldBackground"/>
    <org.xplatform.cyber.game.universal.impl.presentation.crystal.view.CrystalPlayerLogView
        android:gravity="start"
        android:id="@+id/viewPlayerOneGameLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/guidelineStart"
        app:layout_constraintTop_toTopOf="@+id/vCrystalField"/>
    <org.xplatform.cyber.game.universal.impl.presentation.crystal.view.CrystalPlayerLogView
        android:gravity="end"
        android:id="@+id/viewPlayerTwoGameLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
        app:layout_constraintTop_toTopOf="@+id/vCrystalField"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.148"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.852"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineGameFieldLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.316"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineGameFieldRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.684"/>
    <org.xplatform.cyber.game.universal.impl.presentation.crystal.CrystalFieldInfoView
        android:id="@+id/vCrystalFieldInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_marginVertical="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/guidelineStart"
        app:layout_constraintRight_toRightOf="@+id/guidelineEnd"
        app:layout_constraintTop_toBottomOf="@+id/vCrystalField"/>
</androidx.constraintlayout.widget.ConstraintLayout>
