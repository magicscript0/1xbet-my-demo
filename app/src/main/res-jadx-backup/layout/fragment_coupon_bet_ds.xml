<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/bottomSheet"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/space_12">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clExpandedContent"
            android:paddingBottom="@dimen/space_28"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/coefHeader"
                layout="@layout/coupon_makebet_header_layout"/>
            <TextView
                android:id="@+id/tvBetType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/coupon_make_bet_type"
                app:layout_constraintStart_toStartOf="@+id/coefHeader"
                app:layout_constraintTop_toBottomOf="@+id/coefHeader"
                style="@style/TextStyle.Text.Medium.TextPrimary"/>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btnChangeBetType"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_36"
                android:layout_marginEnd="@dimen/space_8"
                app:dsButtonIconRes="@drawable/glyph_chevron_right_small"
                app:layout_constraintBottom_toBottomOf="@+id/tvBetType"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvBetType"
                style="@style/DSButton.Medium.Tertiary.IconRight"/>
            <FrameLayout
                android:id="@+id/shimmerBetType"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_22"
                app:layout_constraintBottom_toBottomOf="@+id/tvBetType"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvBetType">
                <org.xplatform.uikit.components.shimmer.DsShimmerView
                    android:layout_width="@dimen/size_112"
                    android:layout_height="@dimen/size_14"
                    android:radius="@dimen/radius_16"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierBetType"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:barrierAllowsGoneWidgets="true"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tvBetType, btnChangeBetType, shimmerBetType"/>
            <TextView
                android:id="@+id/tvCoefChangingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/bet_coef_change_title"
                android:maxLines="2"
                app:layout_constraintEnd_toStartOf="@+id/btnSettings"
                app:layout_constraintStart_toStartOf="@+id/coefHeader"
                app:layout_constraintTop_toBottomOf="@+id/barrierBetType"
                style="@style/TextStyle.Text.Medium.TextPrimary"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvCoefChangeSubTitle"
                android:paddingBottom="@dimen/space_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:maxLines="2"
                app:layout_constraintEnd_toStartOf="@+id/btnSettings"
                app:layout_constraintStart_toStartOf="@+id/tvCoefChangingTitle"
                app:layout_constraintTop_toBottomOf="@+id/tvCoefChangingTitle"
                style="@style/TextStyle.Caption.Regular.L.Secondary"/>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_36"
                android:layout_marginEnd="@dimen/space_8"
                app:dsButtonIconRes="@drawable/ic_glyph_chevron_right_small"
                app:dsButtonLabel="@string/settings"
                app:layout_constraintBottom_toBottomOf="@+id/tvCoefChangeSubTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCoefChangingTitle"
                style="@style/DSButton.Medium.Tertiary.IconRight"/>
            <org.xplatform.uikit.components.segmented_control.DsSegmentedGroup
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginHorizontal="@dimen/space_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCoefChangeSubTitle"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginHorizontal="@dimen/space_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupBetType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvBetType, btnChangeBetType, shimmerBetType"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCollapsedContent"
            android:paddingBottom="@dimen/space_32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llUnAuthEvents"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_40"
                android:layout_marginStart="@dimen/space_16"
                android:paddingHorizontal="@dimen/space_4"
                app:layout_constraintEnd_toStartOf="@+id/llUnAuthCoef"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/llUnAuthCoef">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivUnAuthEvents"
                        android:layout_width="@dimen/size_18"
                        android:layout_height="@dimen/size_18"
                        android:src="@drawable/ic_events_count_new"
                        app:tint="?attr/uikitSecondary"/>
                    <TextView
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tvUnAuthEventsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/size_22"
                        android:maxLines="1"
                        android:layout_marginStart="@dimen/size_2"
                        app:autoSizeMaxTextSize="@dimen/text_18"
                        app:autoSizeMinTextSize="@dimen/text_10"
                        app:autoSizeStepGranularity="@dimen/text_2"
                        app:autoSizeTextType="uniform"
                        style="@style/TextStyle.Title.Medium.S.TextPrimary"/>
                </LinearLayout>
                <TextView
                    android:textColor="?attr/uikitSecondary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tvUnAuthEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/events"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvUnAuthCoef"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/TextStyle.Caption.Medium.M"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/llUnAuthCoef"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_40"
                android:layout_marginTop="@dimen/space_28"
                android:paddingHorizontal="@dimen/space_4"
                app:layout_constraintEnd_toStartOf="@+id/btnUnAuthAction"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/llUnAuthEvents"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tvUnAuthCoefValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_22"
                    android:minWidth="@dimen/size_14"
                    android:maxLines="1"
                    android:textAlignment="center"
                    android:layoutDirection="ltr"
                    app:autoSizeMaxTextSize="@dimen/text_18"
                    app:autoSizeMinTextSize="@dimen/text_10"
                    app:autoSizeStepGranularity="@dimen/text_2"
                    app:autoSizeTextType="uniform"
                    style="@style/TextStyle.Title.Medium.S.TextPrimary"/>
                <org.xplatform.uikit.components.shimmer.DsShimmerView
                    android:id="@+id/shimmerUnAuthCoef"
                    android:visibility="gone"
                    android:layout_width="@dimen/size_56"
                    android:layout_height="@dimen/size_22"
                    android:radius="@dimen/shimmer_size_360"/>
                <TextView
                    android:textColor="?attr/uikitSecondary"
                    android:ellipsize="end"
                    android:gravity="bottom"
                    android:id="@+id/tvUnAuthCoef"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/size_2"
                    android:text="@string/coefficient"
                    android:maxLines="1"
                    style="@style/TextStyle.Caption.Medium.M"/>
            </LinearLayout>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btnUnAuthAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_40"
                android:layout_marginEnd="@dimen/space_16"
                app:dsButtonLabel="@string/coupon_make_bet_make"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/llUnAuthCoef"
                app:layout_constraintTop_toTopOf="@+id/llUnAuthCoef"
                style="@style/DSButton.Large.Commerce"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/oldCollapsedViewGroup"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:constraint_referenced_ids="btnUnAuthAction, llUnAuthCoef, llUnAuthEvents"/>
            <include
                android:id="@+id/coefColapsedHeader"
                layout="@layout/coupon_makebet_header_layout"/>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btnWideUnAuthAction"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_40"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_24"
                android:layout_marginHorizontal="@dimen/space_16"
                app:dsButtonLabel="@string/coupon_make_bet_make"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/coefColapsedHeader"
                style="@style/DSButton.Large.Commerce"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/divider"
            android:background="@drawable/bg_bottom_sheet_top_view"
            android:layout_width="@dimen/size_36"
            android:layout_height="@dimen/size_4"
            android:layout_marginTop="@dimen/space_8"
            android:backgroundTint="?attr/uikitSeparator"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
