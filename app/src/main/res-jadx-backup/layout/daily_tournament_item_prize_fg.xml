<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/prizeHolder"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumHighlightNew"
        android:textSize="@dimen/text_10"
        android:gravity="center"
        android:id="@+id/prizeDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/dt_today_prize"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline5MediumNew"
        android:gravity="center"
        android:id="@+id/prizeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/dt_today_prize"
        app:layout_constraintTop_toBottomOf="@+id/prizeDetail"
        app:layout_goneMarginTop="0dp"/>
    <ImageView
        android:id="@+id/prizeImage"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_marginTop="@dimen/space_8"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prizeName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
