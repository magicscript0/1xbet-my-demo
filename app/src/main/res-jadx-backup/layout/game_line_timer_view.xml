<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/lineTimerGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="lineTimerSeconds,lineTimerColonTwo,lineTimerHours,lineTimerMinute,lineTimerColonOne"/>
    <TextView
        android:textColor="@color/static_white"
        android:id="@+id/lineTimerDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/lineTimerMinute"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/lineTimerHours"
        android:background="@drawable/cybergame_line_timer_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/lineTimerColonOne"
        app:layout_constraintHeight_min="@dimen/space_18"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lineTimerMinute"
        app:layout_constraintWidth_min="@dimen/space_26"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:id="@+id/lineTimerColonOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_2"
        android:layout_marginRight="@dimen/space_2"
        android:text="@string/colon_symbol"
        android:layout_marginHorizontal="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/lineTimerMinute"
        app:layout_constraintEnd_toStartOf="@+id/lineTimerMinute"
        app:layout_constraintStart_toEndOf="@+id/lineTimerHours"
        app:layout_constraintTop_toTopOf="@+id/lineTimerHours"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/lineTimerMinute"
        android:background="@drawable/cybergame_line_timer_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        app:layout_constraintBottom_toTopOf="@+id/lineTimerDate"
        app:layout_constraintEnd_toStartOf="@+id/lineTimerColonTwo"
        app:layout_constraintHeight_min="@dimen/space_18"
        app:layout_constraintStart_toEndOf="@+id/lineTimerColonOne"
        app:layout_constraintTop_toBottomOf="@+id/lineTimerDays"
        app:layout_constraintWidth_min="@dimen/space_26"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:id="@+id/lineTimerColonTwo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_2"
        android:layout_marginRight="@dimen/space_2"
        android:text="@string/colon_symbol"
        android:layout_marginHorizontal="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/lineTimerMinute"
        app:layout_constraintEnd_toStartOf="@+id/lineTimerSeconds"
        app:layout_constraintStart_toEndOf="@+id/lineTimerMinute"
        app:layout_constraintTop_toTopOf="@+id/lineTimerMinute"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/lineTimerSeconds"
        android:background="@drawable/cybergame_line_timer_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/space_18"
        app:layout_constraintStart_toEndOf="@+id/lineTimerColonTwo"
        app:layout_constraintTop_toTopOf="@+id/lineTimerMinute"
        app:layout_constraintWidth_min="@dimen/space_26"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:id="@+id/lineTimerDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lineTimerMinute"/>
</merge>
