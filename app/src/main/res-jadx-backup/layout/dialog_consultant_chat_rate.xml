<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1New"
            android:gravity="center"
            android:id="@+id/hintIssueSolved"
            android:background="?attr/uikitBackgroundContent"
            android:paddingLeft="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/rate_consultant_is_issue_solved"
            android:textAlignment="center"
            android:paddingHorizontal="@dimen/space_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/issueSolvedLineTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/hintIssueSolved"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/issueContainerPositive"
            android:padding="@dimen/space_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            app:layout_constraintEnd_toStartOf="@+id/centerVerticalLine"
            app:layout_constraintTop_toBottomOf="@+id/issueSolvedLineTop">
            <ImageView
                android:id="@+id/issueImagePositive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/radio_btn_unselected"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1New"
                android:id="@+id/issueTextPositive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yes"
                android:layout_marginStart="@dimen/space_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/issueImagePositive"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/radio_btn_unselected"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/centerVerticalLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/issueContainerNegative"
            android:padding="@dimen/space_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginStart="@dimen/space_16"
            app:layout_constraintStart_toEndOf="@+id/centerVerticalLine"
            app:layout_constraintTop_toBottomOf="@+id/issueSolvedLineTop">
            <ImageView
                android:id="@+id/issueImageNegative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/radio_btn_unselected"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1New"
                android:id="@+id/issueTextNegative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no"
                android:layout_marginStart="@dimen/space_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/issueImageNegative"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/radio_btn_unselected"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/issueChoiceLineBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/issueContainerPositive"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1New"
            android:gravity="center"
            android:id="@+id/hintStars"
            android:background="?attr/uikitBackgroundContent"
            android:paddingLeft="@dimen/space_24"
            android:paddingRight="@dimen/space_24"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/rate_consultant_how_satisfied"
            android:textAlignment="center"
            android:paddingHorizontal="@dimen/space_24"
            app:layout_constraintTop_toBottomOf="@+id/issueChoiceLineBottom"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/stars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            app:layout_constraintTop_toBottomOf="@+id/hintStars">
            <ImageView
                android:id="@+id/star1"
                android:padding="@dimen/space_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_supplib_star_inactive"/>
            <ImageView
                android:id="@+id/star2"
                android:padding="@dimen/space_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/space_16"
                app:srcCompat="@drawable/ic_supplib_star_inactive"/>
            <ImageView
                android:id="@+id/star3"
                android:padding="@dimen/space_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/space_16"
                app:srcCompat="@drawable/ic_supplib_star_inactive"/>
            <ImageView
                android:id="@+id/star4"
                android:padding="@dimen/space_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/space_16"
                app:srcCompat="@drawable/ic_supplib_star_inactive"/>
            <ImageView
                android:id="@+id/star5"
                android:padding="@dimen/space_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:layout_marginStart="@dimen/space_16"
                app:srcCompat="@drawable/ic_supplib_star_inactive"/>
        </LinearLayout>
        <Button
            android:enabled="false"
            android:id="@+id/rateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginRight="@dimen/space_16"
            android:text="@string/rate_consultant_button"
            android:layout_marginHorizontal="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@+id/stars"
            style="@style/Widget.AppTheme.SolidButton.New"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_16"
            app:layout_constraintTop_toBottomOf="@+id/rateButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
