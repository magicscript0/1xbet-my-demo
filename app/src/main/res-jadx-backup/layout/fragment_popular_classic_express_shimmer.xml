<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:paddingBottom="@dimen/space_26"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_8">
    <org.xplatform.uikit.components.header.DsHeader
        android:id="@+id/shimmerTitleOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:horizontalMargin="@dimen/space_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerExpressOne"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_138"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerTitleOne"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerExpressTwo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_138"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerExpressOne"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerExpressThree"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_138"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerExpressTwo"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerExpressFour"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_138"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerExpressThree"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerExpressFive"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_138"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerExpressFour"/>
</androidx.constraintlayout.widget.ConstraintLayout>
