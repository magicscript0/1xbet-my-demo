<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme.AppWidgetContainerParent"
    android:background="@drawable/bg_widget_radius"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16">
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textColor="?attr/uikitWidgetText"
                android:layout_gravity="start"
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="locale"
                android:layoutDirection="locale"
                android:layout_marginEnd="@dimen/space_16"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/imageViewLogo"
                android:layout_width="@dimen/icon_size_76"
                android:layout_height="@dimen/icon_size_16"
                android:src="?attr/xLogo"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <GridLayout
            android:id="@+id/gridQuick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rowCount="2"
            android:columnCount="2">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:orientation="horizontal"
                android:id="@+id/tabOne"
                android:background="@drawable/rounded_background_8"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="?attr/uikitWidgetContent"
                android:paddingHorizontal="@dimen/space_16">
                <ImageView
                    android:id="@+id/imageViewOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_filter_clock"
                    android:tint="?attr/uikitWidgetIcon"
                    app:tint="?attr/uikitWidgetIcon"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textColor="?attr/uikitWidgetText"
                    android:id="@+id/textViewOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:orientation="horizontal"
                android:id="@+id/tabTwo"
                android:background="@drawable/rounded_background_8"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/space_4"
                android:layout_marginStart="@dimen/space_4"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="?attr/uikitWidgetContent"
                android:paddingHorizontal="@dimen/space_16">
                <ImageView
                    android:id="@+id/imageViewTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_filter_clock"
                    android:tint="?attr/uikitWidgetIcon"
                    app:tint="?attr/uikitWidgetIcon"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textColor="?attr/uikitWidgetText"
                    android:id="@+id/textViewTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:orientation="horizontal"
                android:id="@+id/tabThree"
                android:background="@drawable/rounded_background_8"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginBottom="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="?attr/uikitWidgetContent"
                android:paddingHorizontal="@dimen/space_16">
                <ImageView
                    android:id="@+id/imageViewThree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_filter_clock"
                    android:tint="?attr/uikitWidgetIcon"
                    app:tint="?attr/uikitWidgetIcon"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textColor="?attr/uikitWidgetText"
                    android:id="@+id/textViewThree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:orientation="horizontal"
                android:id="@+id/tabFour"
                android:background="@drawable/rounded_background_8"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginBottom="@dimen/space_4"
                android:layout_marginStart="@dimen/space_4"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="?attr/uikitWidgetContent"
                android:paddingHorizontal="@dimen/space_16">
                <ImageView
                    android:id="@+id/imageViewFour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_filter_clock"
                    android:tint="?attr/uikitWidgetIcon"
                    app:tint="?attr/uikitWidgetIcon"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textColor="?attr/uikitWidgetText"
                    android:id="@+id/textViewFour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:orientation="horizontal"
                android:id="@+id/tabThreeDouble"
                android:background="@drawable/rounded_background_8"
                android:paddingLeft="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_4"
                android:layout_columnSpan="2"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:backgroundTint="?attr/uikitWidgetContent"
                android:paddingHorizontal="@dimen/space_16">
                <ImageView
                    android:id="@+id/imageViewThreeDouble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_filter_clock"
                    android:tint="?attr/uikitWidgetIcon"
                    app:tint="?attr/uikitWidgetIcon"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textColor="?attr/uikitWidgetText"
                    android:id="@+id/textViewThreeDouble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"/>
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/settings"
        android:background="@drawable/rounded_background_12"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        android:layout_width="@dimen/size_38"
        android:layout_height="@dimen/size_26"
        android:layout_marginBottom="@dimen/space_12"
        android:src="@drawable/ic_glyph_settings_inactive"
        android:tint="?attr/uikitWidgetIcon"
        android:layout_marginEnd="@dimen/space_12"
        android:backgroundTint="?attr/uikitWidgetUpdateButton"
        android:paddingVertical="@dimen/space_4"/>
</FrameLayout>
