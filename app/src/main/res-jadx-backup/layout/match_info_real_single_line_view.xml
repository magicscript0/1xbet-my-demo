<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:background="@color/static_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textSize="@dimen/text_14"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_50"
        android:lines="3"
        android:textDirection="ltr"
        app:layout_constraintBottom_toTopOf="@+id/timeDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.ui_core.viewcomponents.views.TimerView
        android:id="@+id/gameTimerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/timeDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/timeDescription"
        app:layout_constraintTop_toTopOf="@+id/timeDescription"
        app:timeTextColor="@color/static_white"
        app:timeTextSize="@dimen/text_12"
        app:timerCompact="true"
        app:timerShowLabels="false"
        app:timerShowSec="false"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:id="@+id/timeDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_6"
        android:maxLines="1"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gameTimerView"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
