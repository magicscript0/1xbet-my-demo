<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/size_100">
    <ImageView
        android:id="@+id/ivField"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_78"
        android:src="@drawable/cybergame_card_football_field_bg"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivGate"
        android:layout_width="@dimen/size_58"
        android:layout_height="@dimen/size_28"
        android:src="@drawable/cybergame_card_football_gate_bg"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/space_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivBall"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginBottom="@dimen/space_8"
        android:src="@drawable/cybergame_card_football_ball_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivFirstDefCard"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_24"
        android:layout_marginBottom="@dimen/space_10"
        android:layout_marginStart="@dimen/space_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/card_back"/>
    <ImageView
        android:id="@+id/ivFirstAttCard"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="@+id/ivFirstDefCard"
        app:layout_constraintStart_toStartOf="@+id/ivFirstDefCard"/>
    <ImageView
        android:id="@+id/ivSecondDefCard"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_24"
        android:layout_marginBottom="@dimen/space_2"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toTopOf="@+id/ivFirstDefCard"
        app:layout_constraintStart_toStartOf="@+id/ivFirstDefCard"
        app:srcCompat="@drawable/card_back"/>
    <ImageView
        android:id="@+id/ivSecondAttCard"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="@+id/ivSecondDefCard"
        app:layout_constraintStart_toStartOf="@+id/ivSecondDefCard"/>
    <ImageView
        android:id="@+id/ivThirdDefCard"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_24"
        android:layout_marginBottom="@dimen/space_2"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toTopOf="@+id/ivSecondDefCard"
        app:layout_constraintStart_toStartOf="@+id/ivSecondDefCard"
        app:srcCompat="@drawable/card_back"/>
    <ImageView
        android:id="@+id/ivThirdAttCard"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="@+id/ivThirdDefCard"
        app:layout_constraintStart_toStartOf="@+id/ivThirdDefCard"/>
</merge>
