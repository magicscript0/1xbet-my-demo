<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:outlineProvider="bounds">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_82"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_4"
        app:cardBackgroundColor="?attr/uikitBackgroundContent"
        app:cardCornerRadius="@dimen/corner_radius_8"
        app:cardElevation="@dimen/elevation_2">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/levelProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_12"
                android:progress="10"
                app:indicatorColor="?attr/uikitPrimary"
                app:indicatorSize="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:trackColor="?attr/uikitBackground"
                app:trackCornerRadius="@dimen/corner_radius_8"
                app:trackThickness="5dp"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1BoldNew"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/uikitPrimary"
                android:id="@+id/levelProgressValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/levelProgress"
                app:layout_constraintEnd_toEndOf="@+id/levelProgress"
                app:layout_constraintStart_toStartOf="@+id/levelProgress"
                app:layout_constraintTop_toTopOf="@+id/levelProgress"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textSize="@dimen/text_16"
                android:textColor="?attr/uikitTextPrimary"
                android:id="@+id/levelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginHorizontal="@dimen/space_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/levelProgress"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
