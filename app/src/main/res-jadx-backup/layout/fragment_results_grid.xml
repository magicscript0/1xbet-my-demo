<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivGameBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/statistic_background_image_height"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/teamCardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/default_background"/>
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/staticNavigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:backgroundColor="?attr/uikitStaticTransparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationBarStyle="title"
        app:navigationIconTint="?attr/uikitStaticWhite"
        app:showSeparator="false"
        app:title="@string/statistic_chess_table"
        app:titleTextColor="?attr/uikitStaticWhite"/>
    <org.xplatform.statistic.statistic_core.presentation.view.CoreHeadView
        android:id="@+id/teamCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/staticNavigationBar"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        app:layout_constraintBottom_toTopOf="@+id/mainFrame"/>
    <FrameLayout
        android:id="@+id/mainFrame"
        android:background="@drawable/background_round_background_new"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamCardView">
        <org.xplatform.ui_core.viewcomponents.views.scrollable_table.scrollable.ScrollablePanel
            android:id="@+id/scrollablePanel"
            android:background="@color/static_transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/shimmerView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/shimmer_results_grid_layout"/>
        <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
            android:id="@+id/emptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
