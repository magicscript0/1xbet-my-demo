<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instant_bet_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/games_bet_panel_height"
    android:layout_marginLeft="@dimen/space_16"
    android:layout_marginRight="@dimen/space_16"
    android:layout_marginHorizontal="@dimen/space_16">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumWhite"
        android:textSize="@dimen/text_12"
        android:gravity="center"
        android:background="@drawable/xgames_button_background_dark"
        android:paddingLeft="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingRight="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/instant_bet_comment_new"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/small_bet_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textAppearance="?attr/textAppearanceSubtitle2MediumWhite"
        android:gravity="center"
        android:id="@+id/small_bet_button"
        android:background="@drawable/xgames_button_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_36"
        android:maxLines="1"
        android:textAllCaps="false"
        app:autoSizeMaxTextSize="@dimen/text_18"
        app:autoSizeMinTextSize="@dimen/text_8"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mid_bet_button"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textAppearance="?attr/textAppearanceSubtitle2MediumWhite"
        android:gravity="center"
        android:id="@+id/mid_bet_button"
        android:background="@drawable/xgames_button_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_36"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/space_8"
        app:autoSizeMaxTextSize="@dimen/text_18"
        app:autoSizeMinTextSize="@dimen/text_8"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/max_bet_button"
        app:layout_constraintStart_toEndOf="@+id/small_bet_button"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textAppearance="?attr/textAppearanceSubtitle2MediumWhite"
        android:gravity="center"
        android:id="@+id/max_bet_button"
        android:background="@drawable/xgames_button_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_36"
        android:maxLines="1"
        android:textAllCaps="false"
        app:autoSizeMaxTextSize="@dimen/text_18"
        app:autoSizeMinTextSize="@dimen/text_8"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mid_bet_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
