<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/space_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_4">
    <ImageView
        android:id="@+id/image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="@dimen/space_8"
        android:contentDescription="@null"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:ellipsize="end"
        android:id="@+id/title"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:gravity="center"
        android:id="@+id/games_count"
        android:background="@drawable/circled32_rectangle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:minHeight="32dp"
        android:layout_weight="0"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/selector"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_8"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/rounded_check_selector"
        android:contentDescription="@null"/>
</LinearLayout>
