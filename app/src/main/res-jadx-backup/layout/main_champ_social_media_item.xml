<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/the_international_social_media_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_48">
    <ImageView
        android:id="@+id/ivSocialMediaIcon"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginVertical="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Headline.Regular"
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tvSocialMediaName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/ivSocialMediaIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivSocialMediaIcon"
        app:layout_constraintTop_toTopOf="@+id/ivSocialMediaIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
