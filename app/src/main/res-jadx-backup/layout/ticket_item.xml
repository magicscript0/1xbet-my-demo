<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_chip"
        android:paddingBottom="@dimen/chip_shadow_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8">
        <View
            android:id="@+id/main_holder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1New"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/ticket_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_holder"
            app:layout_constraintEnd_toEndOf="@+id/main_holder"
            app:layout_constraintStart_toStartOf="@+id/main_holder"
            app:layout_constraintTop_toTopOf="@+id/main_holder"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
