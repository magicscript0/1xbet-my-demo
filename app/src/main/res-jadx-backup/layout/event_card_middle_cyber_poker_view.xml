<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/firstPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintEnd_toStartOf="@+id/information"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/information"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerName"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerName"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/secondPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/information"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="firstPlayerName, information, secondPlayerName"/>
    <ImageView
        android:id="@+id/firstPlayerFirstCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/score"/>
    <ImageView
        android:id="@+id/firstPlayerSecondCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginStart="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerFirstCard"
        app:layout_constraintTop_toTopOf="@+id/score"/>
    <ImageView
        android:id="@+id/firstPlayerThirdCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginStart="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerSecondCard"
        app:layout_constraintTop_toTopOf="@+id/score"/>
    <org.xplatform.uikit_sport.score.SportScore
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarrier"
        style="@style/Widget.Score.Small"/>
    <ImageView
        android:id="@+id/secondPlayerFirstCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginEnd="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerSecondCard"
        app:layout_constraintTop_toTopOf="@+id/score"/>
    <ImageView
        android:id="@+id/secondPlayerSecondCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginEnd="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerThirdCard"
        app:layout_constraintTop_toTopOf="@+id/score"
        app:layout_goneMarginEnd="0dp"/>
    <ImageView
        android:id="@+id/secondPlayerThirdCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/score"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/firstPlayerCombination"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerCombination"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/score"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/secondPlayerCombination"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerCombination"
        app:layout_constraintTop_toBottomOf="@+id/score"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/combinationBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="firstPlayerCombination, secondPlayerCombination"/>
    <ImageView
        android:id="@+id/dealerFirstCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toStartOf="@+id/dealerSecondCard"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/combinationBarrier"/>
    <ImageView
        android:id="@+id/dealerSecondCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/dealerFirstCard"
        app:layout_constraintEnd_toStartOf="@+id/dealerThirdCard"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/dealerFirstCard"
        app:layout_constraintTop_toTopOf="@+id/dealerFirstCard"/>
    <ImageView
        android:id="@+id/dealerThirdCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/dealerFirstCard"
        app:layout_constraintEnd_toStartOf="@+id/dealerFourthCard"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/dealerSecondCard"
        app:layout_constraintTop_toTopOf="@+id/dealerFirstCard"/>
    <ImageView
        android:id="@+id/dealerFourthCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/dealerFirstCard"
        app:layout_constraintEnd_toStartOf="@+id/dealerFifthCard"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/dealerThirdCard"
        app:layout_constraintTop_toTopOf="@+id/dealerFirstCard"/>
    <ImageView
        android:id="@+id/dealerFifthCard"
        android:layout_width="@dimen/card_size_30"
        android:layout_height="@dimen/card_size_40"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/dealerFirstCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/dealerFourthCard"
        app:layout_constraintTop_toTopOf="@+id/dealerFirstCard"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/bottomInfo"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dealerFirstCard"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <org.xplatform.uikit.components.timer.DsTimer
        android:id="@+id/timer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintLeft_toLeftOf="@+id/score"
        app:layout_constraintRight_toRightOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/bottomInfo"
        style="@style/Widget.DSTimer.Decrementing"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/caption"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timer"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
</merge>
