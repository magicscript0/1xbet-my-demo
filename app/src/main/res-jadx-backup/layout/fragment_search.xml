<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/tlSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rvSportFilters"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/tlSearch"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/searchEventsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvSportFilters"/>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/lottieEmptyView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintTop_toBottomOf="@+id/tlSearch"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/grShimmers"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="shimmerSubTitle,shimmerGameOne,shimmerGameTwo,shimmerGameThree,shimmerGameFour"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerSubTitle"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/space_22"
        android:radius="@dimen/radius_10"
        android:layout_marginStart="@dimen/medium_horizontal_margin_dynamic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tlSearch"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerGameOne"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_198"
        android:layout_marginTop="@dimen/space_10"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerSubTitle"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerGameTwo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_198"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerGameOne"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerGameThree"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_198"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerGameTwo"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerGameFour"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_198"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerGameThree"/>
</androidx.constraintlayout.widget.ConstraintLayout>
