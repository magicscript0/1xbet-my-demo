<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/firstPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintEnd_toStartOf="@+id/information"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/information"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerName"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerName"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/secondPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="viewEnd"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/information"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <ImageView
        android:id="@+id/firstPlayerTopIcon"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginTop="@dimen/space_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/firstPlayerName"
        app:srcCompat="@drawable/ic_glyph_kosti_one"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/firstPlayerTopFirstScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerTopIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerTopIcon"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerTopIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/firstPlayerTopSecondScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginStart="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerTopIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerTopFirstScore"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerTopIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/firstPlayerTopSeparator"
        android:layout_width="@dimen/size_1"
        android:layout_height="@dimen/size_16"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerTopIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerTopSecondScore"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerTopIcon"
        style="@style/Widget.DSSeparator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/firstPlayerTopResult"
        android:layout_width="@dimen/size_20"
        android:layout_height="wrap_content"
        android:maxLength="2"
        android:layout_marginStart="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerTopIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerTopSeparator"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerTopIcon"
        style="@style/TextStyle.Text.Regular.TextPrimary"/>
    <ImageView
        android:id="@+id/firstPlayerBottomIcon"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginTop="@dimen/space_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/firstPlayerTopIcon"
        app:srcCompat="@drawable/ic_glyph_kosti_two"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/firstPlayerBottomFirstScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerBottomIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerBottomIcon"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerBottomIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/firstPlayerBottomSecondScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginStart="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerBottomIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerBottomFirstScore"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerBottomIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/firstPlayerBottomSeparator"
        android:layout_width="@dimen/size_1"
        android:layout_height="@dimen/size_16"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerBottomIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerBottomSecondScore"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerBottomIcon"
        style="@style/Widget.DSSeparator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/firstPlayerBottomResult"
        android:layout_width="@dimen/size_20"
        android:layout_height="wrap_content"
        android:maxLength="2"
        android:layout_marginStart="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerBottomIcon"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerBottomSeparator"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerBottomIcon"
        style="@style/TextStyle.Text.Regular.TextPrimary"/>
    <ImageView
        android:id="@+id/secondPlayerTopIcon"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginTop="@dimen/space_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondPlayerName"
        app:srcCompat="@drawable/ic_glyph_kosti_one"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondPlayerTopFirstScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerTopIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerTopIcon"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerTopIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondPlayerTopSecondScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerTopIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerTopFirstScore"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerTopIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/secondPlayerTopSeparator"
        android:layout_width="@dimen/size_1"
        android:layout_height="@dimen/size_16"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerTopIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerTopSecondScore"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerTopIcon"
        style="@style/Widget.DSSeparator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondPlayerTopResult"
        android:layout_width="@dimen/size_20"
        android:layout_height="wrap_content"
        android:maxLength="2"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerTopIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerTopSeparator"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerTopIcon"
        style="@style/TextStyle.Text.Regular.TextPrimary"/>
    <ImageView
        android:id="@+id/secondPlayerBottomIcon"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginTop="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondPlayerTopIcon"
        app:srcCompat="@drawable/ic_glyph_kosti_two"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondPlayerBottomFirstScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerBottomIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerBottomIcon"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerBottomIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondPlayerBottomSecondScore"
        android:layout_width="@dimen/size_10"
        android:layout_height="wrap_content"
        android:maxLength="1"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerBottomIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerBottomFirstScore"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerBottomIcon"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/secondPlayerBottomSeparator"
        android:layout_width="@dimen/size_1"
        android:layout_height="@dimen/size_16"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerBottomIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerBottomSecondScore"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerBottomIcon"
        style="@style/Widget.DSSeparator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/secondPlayerBottomResult"
        android:layout_width="@dimen/size_20"
        android:layout_height="wrap_content"
        android:maxLength="2"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerBottomIcon"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerBottomSeparator"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerBottomIcon"
        style="@style/TextStyle.Text.Regular.TextPrimary"/>
    <org.xplatform.uikit_sport.score.SportScore
        android:id="@+id/score"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/information"
        style="@style/Widget.Score.Small"/>
</merge>
