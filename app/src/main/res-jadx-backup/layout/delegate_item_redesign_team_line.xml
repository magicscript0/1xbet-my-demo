<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_background_16"
    android:clipToPadding="false"
    android:layout_width="@dimen/size_122"
    android:layout_height="@dimen/size_132"
    android:backgroundTint="?attr/uikitBackgroundContent">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_24"
        android:layout_marginTop="@dimen/space_6"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sportImage"
            android:layout_width="@dimen/size_18"
            android:layout_height="@dimen/size_18"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.AppTheme.Circle"
            app:tint="?attr/uikitSecondary"/>
        <org.xplatform.uikit.components.counter.DsCounter
            android:id="@+id/counterBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            app:counterComponentStyle="secondary"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/favoriteIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_8"
        android:layout_width="@dimen/size_36"
        android:layout_height="@dimen/size_36"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_star_liked_new"
        app:tint="?attr/uikitPrimary"/>
    <View
        android:id="@+id/vTeamImageCircleBg"
        android:background="@drawable/circle_background_with_red_outline_new_color_selector"
        android:layout_width="@dimen/icon_size_56"
        android:layout_height="@dimen/icon_size_56"
        android:layout_marginTop="@dimen/size_36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/teamImage"
        android:layout_width="@dimen/icon_size_32"
        android:layout_height="@dimen/icon_size_32"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:cornerRadiusImageView="@dimen/corner_radius_16"
        app:layout_constraintBottom_toBottomOf="@+id/vTeamImageCircleBg"
        app:layout_constraintEnd_toEndOf="@+id/vTeamImageCircleBg"
        app:layout_constraintStart_toStartOf="@+id/vTeamImageCircleBg"
        app:layout_constraintTop_toTopOf="@+id/vTeamImageCircleBg"/>
    <org.xplatform.uikit.components.tag.DsTag
        android:id="@+id/liveGameTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/live_new"
        app:layout_constraintEnd_toEndOf="@+id/teamImage"
        app:layout_constraintStart_toStartOf="@+id/teamImage"
        app:layout_constraintTop_toBottomOf="@+id/teamImage"
        style="@style/Widget.DSTag.RectangularS.Red"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/teamName"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/space_4"
        app:autoSizeMaxTextSize="@dimen/text_12"
        app:autoSizeMinTextSize="@dimen/text_10"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vTeamImageCircleBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
