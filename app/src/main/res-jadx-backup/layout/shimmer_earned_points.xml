<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/frameLayout"
        android:padding="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/viewRowTitle1"
            android:background="@drawable/rounded_background_12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/shimmer_size_32"
            android:backgroundTint="?attr/uikitBackgroundGroup"
            app:layout_constraintBottom_toBottomOf="@+id/frameLayout"
            app:layout_constraintTop_toTopOf="@+id/frameLayout"/>
    </FrameLayout>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle2"
        android:background="@drawable/rounded_background_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shimmer_size_94"
        android:layout_margin="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle3"
        android:background="@drawable/rounded_background_16"
        android:layout_width="@dimen/shimmer_size_108"
        android:layout_height="@dimen/shimmer_size_32"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewRowTitle2"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle4"
        android:background="@drawable/rounded_background_16"
        android:layout_width="@dimen/shimmer_size_128"
        android:layout_height="@dimen/shimmer_size_32"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintStart_toEndOf="@+id/viewRowTitle3"
        app:layout_constraintTop_toBottomOf="@+id/viewRowTitle2"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle5"
        android:background="?attr/uikitBackgroundGroup"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_34"
        android:layout_marginTop="@dimen/space_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewRowTitle4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
