<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PreviousMapItemStyle"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvHeader"
        android:paddingLeft="@dimen/space_36"
        android:paddingTop="@dimen/space_4"
        android:paddingRight="@dimen/space_36"
        android:paddingBottom="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_1"
        android:paddingHorizontal="@dimen/space_36"
        android:paddingVertical="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scoreContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/teamFirstImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/teamFirstImage">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1BoldNew"
            android:textSize="@dimen/text_16"
            android:textColor="@color/static_white"
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tvHalfScores"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
            android:textSize="@dimen/text_10"
            android:id="@+id/tvHalfScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tvScore"
            app:layout_constraintStart_toStartOf="@+id/tvScore"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/teamFirstImage"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_18"
        android:layout_marginStart="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/firstTeamContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/teamFirstImage"
        app:layout_constraintEnd_toStartOf="@+id/scoreContainer"
        app:layout_constraintStart_toEndOf="@+id/teamFirstImage"
        app:layout_constraintTop_toTopOf="@+id/teamFirstImage">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textSize="@dimen/text_10"
            android:textColor="@color/static_white"
            android:id="@+id/tvTeamFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textSize="@dimen/text_8"
            android:id="@+id/tvFirstTeamWin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="@+id/teamSecondImage"
        app:layout_constraintEnd_toStartOf="@+id/teamSecondImage"
        app:layout_constraintStart_toEndOf="@+id/scoreContainer"
        app:layout_constraintTop_toTopOf="@+id/teamSecondImage">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textSize="@dimen/text_10"
            android:textColor="@color/static_white"
            android:gravity="right"
            android:id="@+id/tvTeamSecondName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textSize="@dimen/text_8"
            android:gravity="right"
            android:id="@+id/tvSecondTeamWin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/teamSecondImage"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_18"
        android:layout_marginEnd="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
