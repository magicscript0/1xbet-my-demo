<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_8"
    android:layout_marginRight="@dimen/space_8"
    android:layout_marginBottom="@dimen/space_8"
    android:layout_marginHorizontal="@dimen/space_8">
    <ImageView
        android:id="@+id/imgError"
        android:visibility="invisible"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/messageContainer"
        app:layout_constraintEnd_toStartOf="@+id/messageContainer"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/messageContainer"
        app:srcCompat="@drawable/ic_error_message"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messageContainer"
        android:background="@drawable/message_outbox_bg"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/imgError"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/imgFileImage"
            android:background="@drawable/background_send_document"
            android:layout_width="@dimen/size_60"
            android:layout_height="@dimen/size_60"
            android:layout_marginTop="@dimen/space_4"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toTopOf="@+id/txtMessage"
            app:layout_constraintEnd_toStartOf="@+id/llFileSend"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/pbFileLoader"
            android:layout_width="@dimen/size_32"
            android:layout_height="@dimen/size_32"
            app:layout_constraintBottom_toBottomOf="@+id/imgFileImage"
            app:layout_constraintEnd_toEndOf="@+id/imgFileImage"
            app:layout_constraintStart_toStartOf="@+id/imgFileImage"
            app:layout_constraintTop_toTopOf="@+id/imgFileImage"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/llFileSend"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_8"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/imgFileImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/imgFileImage"
            app:layout_constraintTop_toTopOf="@+id/imgFileImage">
            <TextView
                android:textAppearance="@style/TextAppearance.AppTheme.New.Body1.Medium"
                android:textSize="@dimen/text_16"
                android:textColor="@color/static_white"
                android:ellipsize="end"
                android:id="@+id/txtFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppTheme.New.Caption"
                android:textColor="@color/static_white"
                android:id="@+id/txtFileDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <org.xplatform.ui_core.viewcomponents.views.FixedSelectionTextView
            android:textSize="@dimen/text_16"
            android:textColor="@android:color/white"
            android:textColorLink="@android:color/white"
            android:autoLink="phone|web"
            android:id="@+id/txtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textIsSelectable="true"
            android:textDirection="locale"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toTopOf="@+id/txtTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgFileImage"/>
        <TextView
            android:textSize="@dimen/text_10"
            android:textColor="@android:color/white"
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_2"
            app:layout_constraintBottom_toBottomOf="@+id/imgStatus"
            app:layout_constraintEnd_toStartOf="@+id/imgStatus"
            app:layout_constraintTop_toBottomOf="@+id/txtMessage"/>
        <ImageView
            android:id="@+id/imgStatus"
            android:layout_width="@dimen/size_12"
            android:layout_height="@dimen/size_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_message_status_waiting"
            app:tint="@android:color/white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
