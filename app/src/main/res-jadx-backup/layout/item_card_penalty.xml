<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_132"
    android:layout_marginTop="@dimen/space_4">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:textSize="@dimen/text_10"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchDescription"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_24"
        android:minHeight="24dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textSize="@dimen/text_22"
        android:textColor="@color/static_white"
        android:id="@+id/tvPenaltyScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvPenaltyName"
        android:layout_width="@dimen/size_80"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/tvPenaltyScore"
        app:layout_constraintStart_toStartOf="@+id/tvPenaltyScore"
        app:layout_constraintTop_toBottomOf="@+id/tvPenaltyScore"/>
    <FrameLayout
        android:id="@+id/ivTeamOneLogoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription">
        <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/ivTeamOneLogo"
            android:layout_width="@dimen/team_logo_image_size"
            android:layout_height="@dimen/team_logo_image_size"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_8"
            android:layout_marginVertical="@dimen/space_4"
            app:cornerRadiusImageView="@dimen/corner_radius_8"/>
        <ImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/ivFirstTeamFavorite"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ivTeamTwoLogoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription">
        <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/ivTeamTwoLogo"
            android:layout_width="@dimen/team_logo_image_size"
            android:layout_height="@dimen/team_logo_image_size"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_8"
            android:layout_marginVertical="@dimen/space_4"
            app:cornerRadiusImageView="@dimen/corner_radius_8"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/ivSecondTeamFavorite"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"/>
    </FrameLayout>
    <ScrollView
        android:id="@+id/svShotResults"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivTeamOneLogoContainer">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llShotResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flTeamOneResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_40"
                app:flexWrap="wrap"
                app:layout_constraintEnd_toStartOf="@+id/flTeamTwoResult"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flTeamTwoResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_40"
                app:flexWrap="wrap"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/flTeamOneResult"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
