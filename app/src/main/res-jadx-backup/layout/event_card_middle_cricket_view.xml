<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.timer.DsTimerWithDescription
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/liveInfo"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_22"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toStartOf="@+id/infoBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/size_22"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/topFirstLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginVertical="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/botFirstLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/liveInfo"
        style="@style/Widget.DSSportTeamLogo.Size24"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/topSecondLogo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintStart_toEndOf="@+id/topFirstLogo"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        style="@style/Widget.DSSportTeamLogo.Size24"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/botFirstLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginVertical="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topFirstLogo"
        style="@style/Widget.DSSportTeamLogo.Size24"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/botSecondLogo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintStart_toEndOf="@+id/botFirstLogo"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        style="@style/Widget.DSSportTeamLogo.Size24"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/topTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/teamNameEndBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/topSecondLogo"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        style="@style/TextStyle.Text.Medium.Shrink.TextPrimary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/botTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/teamNameEndBarrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/botSecondLogo"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        style="@style/TextStyle.Text.Medium.Shrink.TextPrimary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/topScore"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_32"
        android:maxLines="3"
        android:textAlignment="viewEnd"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        style="@style/TextStyle.Headline.Bold.Shrink.Alt.TextPrimary"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/botScore"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_32"
        android:textAlignment="viewEnd"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        style="@style/TextStyle.Headline.Bold.Shrink.Alt.TextPrimary"/>
    <ImageView
        android:id="@+id/topGameIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/ic_game_indicator"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/topGameScore"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        app:layout_goneMarginEnd="@dimen/space_8"
        app:tint="?attr/uikitSecondary"/>
    <ImageView
        android:id="@+id/botGameIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/ic_game_indicator"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/botGameScore"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        app:layout_goneMarginEnd="@dimen/space_8"
        app:tint="?attr/uikitSecondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/infoBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="topGameIndicator, botGameIndicator"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/teamNameEndBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="topScore, botScore, topGameIndicator, botGameIndicator"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/gameText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/topGameScore"
        app:layout_constraintEnd_toEndOf="@+id/topGameScore"
        app:layout_constraintStart_toStartOf="@+id/topGameScore"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Regular.M.TextPrimary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/topGameScore"
        android:background="@drawable/rounded_background_6"
        android:visibility="gone"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/space_4"
        android:backgroundTint="?attr/uikitBackgroundLight60"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/topSetScore"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        app:layout_goneMarginEnd="@dimen/space_4"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/botGameScore"
        android:background="@drawable/rounded_background_6"
        android:visibility="gone"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/space_4"
        android:backgroundTint="?attr/uikitBackgroundLight60"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/botSetScore"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        app:layout_goneMarginEnd="@dimen/space_4"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/setText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/topSetScore"
        app:layout_constraintEnd_toEndOf="@+id/topSetScore"
        app:layout_constraintStart_toStartOf="@+id/topSetScore"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Regular.M.TextPrimary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/topSetScore"
        android:background="@drawable/rounded_background_6"
        android:visibility="gone"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/space_4"
        android:backgroundTint="?attr/uikitBackgroundLight60"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/topResultScore"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        app:layout_goneMarginEnd="0dp"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/botSetScore"
        android:background="@drawable/rounded_background_6"
        android:visibility="gone"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/space_4"
        android:backgroundTint="?attr/uikitBackgroundLight60"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintEnd_toStartOf="@+id/botResultScore"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        app:layout_goneMarginEnd="0dp"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/resultText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/topResultScore"
        app:layout_constraintEnd_toEndOf="@+id/topResultScore"
        app:layout_constraintStart_toStartOf="@+id/topResultScore"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Regular.M.TextPrimary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/topResultScore"
        android:background="@drawable/rounded_background_6"
        android:visibility="gone"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_24"
        android:backgroundTint="?attr/uikitBackgroundLight60"
        app:layout_constraintBottom_toBottomOf="@+id/topFirstLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topFirstLogo"
        app:layout_goneMarginEnd="0dp"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/botResultScore"
        android:background="@drawable/rounded_background_6"
        android:visibility="gone"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_24"
        android:backgroundTint="?attr/uikitBackgroundLight60"
        app:layout_constraintBottom_toBottomOf="@+id/botFirstLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/botFirstLogo"
        app:layout_goneMarginEnd="0dp"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
</merge>
