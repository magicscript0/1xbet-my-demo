<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/clearButton"
        android:background="@drawable/ic_close_circle_full_alpha"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/choiceBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/textChoiceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/bet_select_vertical_margin"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/bet_select_vertical_margin"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginVertical="@dimen/bet_select_vertical_margin"
        app:layout_constraintBottom_toTopOf="@+id/chipImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/choiceBackground"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chipImage"
        android:layout_width="@dimen/bet_select_button_chip_size"
        android:layout_height="@dimen/bet_select_button_chip_size"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginVertical="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/textBetSum"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textChoiceName"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/textBetSum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/bet_select_vertical_margin"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/bet_select_vertical_margin"
        android:maxLines="1"
        android:textDirection="ltr"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginVertical="@dimen/bet_select_vertical_margin"
        app:layout_constraintBottom_toBottomOf="@+id/choiceBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipImage"/>
</androidx.constraintlayout.widget.ConstraintLayout>
