<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/row_height">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:layout_gravity="center"
        android:id="@+id/dataTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llStatusRows"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llTopStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvFirstGame"
                android:background="@drawable/bg_stagetable_status_cell"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:alpha="0.5"
                android:backgroundTint="@color/static_red"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvSecondGame"
                android:background="@drawable/bg_stagetable_status_cell"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layout_marginLeft="@dimen/space_2"
                android:layout_marginRight="@dimen/space_2"
                android:alpha="0.5"
                android:backgroundTint="@color/static_red"
                android:layout_marginHorizontal="@dimen/space_2"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvThirdGame"
                android:background="@drawable/bg_stagetable_status_cell"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:alpha="0.5"
                android:backgroundTint="@color/static_red"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llBottomStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2">
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvFourthGame"
                android:background="@drawable/bg_stagetable_status_cell"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:alpha="0.5"
                android:backgroundTint="@color/static_red"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvFifthGame"
                android:background="@drawable/bg_stagetable_status_cell"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layout_marginLeft="@dimen/space_2"
                android:layout_marginRight="@dimen/space_2"
                android:alpha="0.5"
                android:backgroundTint="@color/static_red"
                android:layout_marginHorizontal="@dimen/space_2"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvSixthGame"
                android:background="@drawable/bg_stagetable_status_cell"
                android:visibility="gone"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:alpha="0.5"
                android:backgroundTint="@color/static_red"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
