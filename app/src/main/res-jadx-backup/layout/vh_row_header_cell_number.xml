<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="@dimen/size_36"
    android:layout_height="@dimen/size_72">
    <TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:maxLength="2"
        android:textDirection="ltr"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        style="@style/Widget.DSSeparator.Separator60"/>
</FrameLayout>
