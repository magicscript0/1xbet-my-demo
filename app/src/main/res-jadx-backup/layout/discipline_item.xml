<?xml version="1.0" encoding="utf-8"?>
<org.xplatform.uikit.components.cells.DsSettingsCell xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scDiscipline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_4"
    android:layout_marginRight="@dimen/space_4"
    android:layout_marginHorizontal="@dimen/space_4">
    <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
        android:id="@+id/cellTitle"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        style="@style/Widget.DSCell.Middle.Title.L"/>
    <org.xplatform.uikit.components.cells.right.DsCellRightRadioButton
        android:id="@+id/cellRadioButton"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/sSeparator"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        style="@style/Widget.DSSeparator"/>
</org.xplatform.uikit.components.cells.DsSettingsCell>
