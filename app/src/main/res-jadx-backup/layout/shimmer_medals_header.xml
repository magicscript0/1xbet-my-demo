<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_52"
    android:layoutDirection="locale">
    <View
        android:id="@+id/viewRowTitle1"
        android:background="@drawable/rounded_background_16"
        android:layout_width="@dimen/shimmer_size_70"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_32"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivGoldMedal"
        android:background="@drawable/circle"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginEnd="@dimen/space_18"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivSilverMedal"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivSilverMedal"
        android:background="@drawable/circle"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginEnd="@dimen/space_18"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivBronzeMedal"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivBronzeMedal"
        android:background="@drawable/circle"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginEnd="@dimen/space_18"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="?attr/uikitSeparator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
