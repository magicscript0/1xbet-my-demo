        android:layout_height="@dimen/shimmer_size_16"
        android:backgroundTint="?attr/uikitBackgroundGroup"/>
    <View
        android:background="@drawable/chip_16_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginTop="@dimen/space_16"
