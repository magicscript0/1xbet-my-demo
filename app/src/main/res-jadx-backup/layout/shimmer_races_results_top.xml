<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view1"
        android:background="@drawable/group_bg_rounded_corners_32"
        android:layout_width="@dimen/size_114"
        android:layout_height="@dimen/size_32"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:background="@drawable/group_bg_rounded_corners_32"
        android:layout_width="@dimen/size_114"
        android:layout_height="@dimen/size_32"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/view1"
        app:layout_constraintStart_toEndOf="@+id/view1"
        app:layout_constraintTop_toTopOf="@+id/view1"/>
    <View
        android:id="@+id/view3"
        android:background="?attr/uikitBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_52"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1"/>
    <View
        android:id="@+id/view4"
        android:background="@drawable/circle"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginStart="@dimen/space_10"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="@+id/view3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view3"/>
    <View
        android:id="@+id/view5"
        android:background="@drawable/group_bg_rounded_corners_new"
        android:layout_width="@dimen/size_70"
        android:layout_height="@dimen/size_16"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="@+id/view4"
        app:layout_constraintStart_toEndOf="@+id/view4"
        app:layout_constraintTop_toTopOf="@+id/view4"/>
    <View
        android:id="@+id/view6"
        android:background="@drawable/group_bg_rounded_corners_new"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_16"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="@+id/view5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view5"
        app:layout_constraintTop_toTopOf="@+id/view5"/>
    <View
        android:id="@+id/view7"
        android:background="?attr/uikitSeparator"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
