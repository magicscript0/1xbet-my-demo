<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerCard"
    android:background="@drawable/rounded_background_16_content"
    android:layout_width="@dimen/size_160"
    android:layout_height="@dimen/size_164">
    <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardImageView
        android:id="@+id/ivBanner"
        android:tag="bannerImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.RadiusTop16Bottom12"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llActionCard"
        android:background="@drawable/rounded_background_16_content"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_8">
        <ImageView
            android:id="@+id/ivActionCardIcon"
            android:layout_width="@dimen/size_20"
            android:layout_height="@dimen/size_20"
            android:layout_marginBottom="@dimen/space_12"
            app:tint="?attr/uikitPrimary"/>
        <TextView
            android:textColor="?attr/uikitPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvActionCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/TextAppearance.Text.Medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start|bottom"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/size_68"
        android:layout_marginStart="@dimen/space_8">
        <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardBackgroundLTextView
            android:ellipsize="end"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:maxLines="2"
            android:textDirection="locale"
            style="@style/TextStyle.Text.Medium.TextPrimary"/>
        <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardBackgroundLTextView
            android:ellipsize="end"
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/ivAction"
        android:paddingLeft="@dimen/space_8"
        android:paddingTop="@dimen/space_24"
        android:paddingRight="@dimen/space_8"
        android:paddingBottom="@dimen/space_24"
        android:layout_width="@dimen/size_36"
        android:layout_height="@dimen/size_68"
        android:contentDescription="@null"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingVertical="@dimen/space_24"
        app:tint="?attr/uikitPrimary"/>
    <org.xplatform.uikit.components.tag.DsTag
        android:ellipsize="end"
        android:layout_gravity="start|top"
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/Widget.DSTag.Rounded.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:radius="@dimen/radius_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
