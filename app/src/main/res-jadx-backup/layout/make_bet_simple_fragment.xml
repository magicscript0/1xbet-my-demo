<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.ui_core.viewcomponents.views.MakeBetBalanceViewDs
        android:id="@+id/balanceView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/betInputView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <org.xplatform.ui_core.viewcomponents.views.BetInputView
        android:id="@+id/betInputView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"
        app:inputHint="@string/pf_input_sum_title"
        app:layout_constraintBottom_toTopOf="@+id/barrierTaxBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/balanceView"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierTaxTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="betInputView"/>
    <org.xplatform.ui_core.viewcomponents.views.TaxExpandableSpoiler
        android:id="@+id/taxSpoiler"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/barrierTaxBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierTaxTop"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierTaxBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tvPossibleWinValue"/>
    <TextView
        android:id="@+id/tvPossibleWinValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_2"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/tvAvailableAdvance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/TextStyle.Text.Regular.TextPrimary"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvAvailableAdvance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_2"
        android:minHeight="@dimen/size_36"
        android:text="@string/available_prepayment"
        android:layout_marginStart="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/barrierFastBetText"
        app:layout_constraintEnd_toStartOf="@+id/btnRequestAdvance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierTaxTop"
        app:layout_constraintVertical_bias="1"
        style="@style/TextStyle.Text.Regular.TextPrimary"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/btnRequestAdvance"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_36"
        android:drawablePadding="@dimen/size_8"
        android:layout_marginEnd="@dimen/space_8"
        app:dsButtonIconRes="@drawable/ic_request"
        app:dsButtonLabel="@string/advance_request"
        app:layout_constraintBottom_toBottomOf="@+id/tvAvailableAdvance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvAvailableAdvance"
        style="@style/DSButton.Medium.Tertiary.IconRight"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierFastBetText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tvFastBetTitle, tvFastBetSubTitle, tvEnableFastBet"/>
    <TextView
        android:id="@+id/tvFastBetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_2"
        android:text="@string/quick_bets_title"
        android:layout_marginStart="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/tvFastBetSubTitle"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextStyle.Text.Medium.TextPrimary"/>
    <TextView
        android:id="@+id/tvFastBetSubTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:text="@string/bet_quick_bet_description"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/barrierFastBet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvEnableFastBet"
        android:paddingLeft="@dimen/space_24"
        android:paddingRight="@dimen/space_24"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/quick_bets_enable_description"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/space_16"
        android:paddingHorizontal="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TextStyle.Headline.Regular.Secondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierFastBet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="btnFastBet1, btnFastBet2, btnFastBet3"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/btnFastBet1"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_40"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_16"
        app:chainUseRtl="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnFastBet2"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/DSButton.Large.Primary"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/btnFastBet2"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_40"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:textDirection="locale"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnFastBet3"
        app:layout_constraintStart_toEndOf="@+id/btnFastBet1"
        style="@style/DSButton.Large.Primary"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/btnFastBet3"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_40"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnFastBet2"
        style="@style/DSButton.Large.Primary"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/grAvailableAdvance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvAvailableAdvance,btnRequestAdvance"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/grFastBets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btnFastBet1, btnFastBet2, btnFastBet3, tvFastBetTitle, tvFastBetSubTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
