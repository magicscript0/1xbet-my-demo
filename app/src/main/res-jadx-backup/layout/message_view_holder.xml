<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/card_layout"
    android:background="@drawable/rounded_background_16"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:layout_gravity="start"
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextStyle.Text.Regular"/>
    <TextView
        android:textColor="?attr/uikitTextPrimary"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        style="@style/TextStyle.Title.Medium.M"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        style="@style/TextStyle.Text.Regular"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:ellipsize="end"
        android:id="@+id/btnActivate"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:maxLines="1"
        app:dsButtonLabel="@string/activate"
        app:dsButtonType="label"
        style="@style/DSButton.Large.Primary"/>
</LinearLayout>
