<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_92">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBackground"
        android:background="@color/cs2_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_88"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Cs2GamesMapsItemStyle"/>
    <ImageView
        android:id="@+id/ivFirstTeamImage"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginTop="@dimen/space_12"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/space_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBackground"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvFirstTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivFirstTeamImage"
        app:layout_constraintEnd_toStartOf="@+id/tvFirstTeamScore"
        app:layout_constraintStart_toEndOf="@+id/ivFirstTeamImage"
        app:layout_constraintTop_toTopOf="@+id/ivFirstTeamImage"/>
    <ImageView
        android:id="@+id/ivSecondTeamImage"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginBottom="@dimen/space_12"
        android:adjustViewBounds="true"
        android:layout_marginEnd="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvSecondTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivSecondTeamImage"
        app:layout_constraintEnd_toStartOf="@+id/tvSecondTeamScore"
        app:layout_constraintStart_toEndOf="@+id/ivSecondTeamImage"
        app:layout_constraintTop_toTopOf="@+id/ivSecondTeamImage"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1BoldNew"
        android:textSize="@dimen/text_20"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvFirstTeamScore"
        android:background="@drawable/cs2_statistic_item_bg"
        android:layout_width="@dimen/size_40"
        android:layout_height="@dimen/size_32"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/tvFirstTeamName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFirstTeamName"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1BoldNew"
        android:textSize="@dimen/text_20"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvSecondTeamScore"
        android:background="@drawable/cs2_statistic_item_bg"
        android:layout_width="@dimen/size_40"
        android:layout_height="@dimen/size_32"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/tvSecondTeamName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSecondTeamName"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionBoldNew"
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_white_80"
        android:id="@+id/tvMapDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_26"
        android:includeFontPadding="false"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivLive"
        android:padding="@dimen/space_2"
        android:visibility="gone"
        android:layout_width="@dimen/size_10"
        android:layout_height="@dimen/size_10"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvMapDescription"
        app:layout_constraintStart_toEndOf="@+id/tvMapDescription"
        app:layout_constraintTop_toTopOf="@+id/tvMapDescription"
        app:srcCompat="@drawable/red_circle"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:textSize="@dimen/text_20"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:id="@+id/tvMapName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintEnd_toStartOf="@+id/ivSecondTeamImage"
        app:layout_constraintStart_toStartOf="@+id/tvMapDescription"
        app:layout_constraintTop_toBottomOf="@+id/tvMapDescription"/>
</androidx.constraintlayout.widget.ConstraintLayout>
