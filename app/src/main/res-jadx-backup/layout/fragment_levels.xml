<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/recyclerView"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/action"/>
    <org.xplatform.uikit.components.lottie.LottieView
        android:id="@+id/emptyView"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:file_name="@string/lottie_history_empty"
        app:textColor="?attr/uikitSecondary"
        app:text_res="@string/participate_actions_and_win"/>
    <include
        android:id="@+id/action"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/view_level_ticket_action"/>
    <include
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        layout="@layout/view_progress_bar"/>
</RelativeLayout>
