<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/viewRounded"
        android:background="@drawable/bg_bottom_sheet_tips"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/corner_radius_16"
        app:cardElevation="@dimen/elevation_0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.tabs.TabLayout
                android:layout_gravity="center"
                android:id="@+id/indicator"
                android:background="?attr/uikitBackgroundContent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/viewPagerPreview"
                app:tabBackground="@drawable/selector_tabs"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="@dimen/space_18"/>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btnSkip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_16"
                app:dsButtonLabel="@string/skip"
                app:layout_constraintTop_toBottomOf="@+id/viewPagerPreview"
                style="@style/DSButton.Medium.Tertiary"/>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginRight="@dimen/space_16"
                android:stateListAnimator="@null"
                android:layout_marginHorizontal="@dimen/space_16"
                app:dsButtonLabel="@string/next"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnSkip"
                app:layout_goneMarginTop="@dimen/space_42"
                style="@style/DSButton.Medium.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
