<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivEmpty"
        android:background="@drawable/white_radius"
        android:layout_width="@dimen/size_36"
        android:layout_height="@dimen/size_36"
        android:layout_marginTop="@dimen/space_14"
        android:layout_marginBottom="@dimen/space_14"
        android:scaleType="center"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitSeparator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/emptyView"
        android:background="@drawable/rounded_shimmer_item"
        android:layout_width="@dimen/size_64"
        android:layout_height="@dimen/size_12"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitSeparator"
        app:layout_constraintStart_toEndOf="@+id/ivEmpty"
        app:layout_constraintTop_toTopOf="@+id/ivEmpty"/>
    <View
        android:background="@drawable/rounded_shimmer_item"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_12"
        android:layout_marginTop="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintStart_toStartOf="@+id/emptyView"
        app:layout_constraintTop_toBottomOf="@+id/emptyView"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/match_constraints"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
