<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textColor="?attr/uikitPrimary"
        android:gravity="center"
        android:id="@+id/tv_title_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_24"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginRight="@dimen/space_24"
        android:letterSpacing="0.04"
        android:layout_marginHorizontal="@dimen/space_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:gravity="center"
        android:id="@+id/change_dialog_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_24"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_24"
        android:layout_marginHorizontal="@dimen/space_24"
        app:layout_constraintBottom_toTopOf="@+id/changeDialogChecker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_new"/>
    <org.xplatform.uikit.components.check_box.old.DsCheckBoxOld
        android:id="@+id/changeDialogChecker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_24"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_24"
        android:layout_marginBottom="@dimen/space_24"
        android:paddingStart="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_24"
        app:layout_constraintBottom_toTopOf="@+id/buttons_divider_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/change_dialog_text"/>
    <View
        android:id="@+id/buttons_divider_1"
        android:background="?attr/uikitSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_first_new"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:textColor="?attr/uikitPrimary"
        android:gravity="center"
        android:id="@+id/btn_first_new"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/apply"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@+id/buttons_divider_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.AppTheme.TextButton.New"/>
    <View
        android:id="@+id/buttons_divider_2"
        android:background="?attr/uikitSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_second_new"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:textColor="?attr/uikitPrimary"
        android:gravity="center"
        android:id="@+id/btn_second_new"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.AppTheme.TextButton.New"/>
</androidx.constraintlayout.widget.ConstraintLayout>
