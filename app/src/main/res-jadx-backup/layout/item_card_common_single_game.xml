<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/match_info_cards_height">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_white_60"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/size_32"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_4"
        android:maxLines="3"
        app:autoSizeMaxTextSize="@dimen/text_18"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/vMatchTimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"
        app:layout_goneMarginBottom="@dimen/space_8"
        app:layout_goneMarginTop="@dimen/space_32"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.MatchTimerView
        android:id="@+id/vMatchTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/tvMatchPeriodInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchName"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white_60"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchPeriodInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
