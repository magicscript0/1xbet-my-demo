<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/medals"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceHeadline6MediumNew"
        style="@style/Widget.AppTheme.Toolbar.New"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:background="?attr/uikitBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1New"
            android:textColor="?attr/uikitTextPrimary"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/tournaments"
            android:maxLines="1"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivGoldMedal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivGoldMedal"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:layout_marginEnd="@dimen/space_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivSilverMedal"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_gold_medal"/>
        <ImageView
            android:id="@+id/ivSilverMedal"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:layout_marginEnd="@dimen/space_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivBronzeMedal"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_silver_medal"/>
        <ImageView
            android:id="@+id/ivBronzeMedal"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:layout_marginEnd="@dimen/space_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_bronze_medal"/>
        <View
            android:background="?attr/uikitSeparator"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_1"
            android:layout_marginBottom="@dimen/space_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rvContent"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clHeader"/>
    <org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout
        android:orientation="vertical"
        android:id="@+id/shimmers"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <include layout="@layout/shimmer_medals_header"/>
        <include layout="@layout/shimmer_item_medals_statistic"/>
        <include layout="@layout/shimmer_item_medals_statistic"/>
    </org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:layout_gravity="center"
        android:id="@+id/lottieEmptyView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
