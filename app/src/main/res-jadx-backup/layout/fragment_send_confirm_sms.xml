<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/activate_phone"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <LinearLayout
        android:theme="?attr/uikitTheme"
        android:orientation="vertical"
        android:id="@+id/linearLayoutDescription"
        android:background="@drawable/bg_rounded_16dp_white"
        android:padding="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/uikitSecondary"
            android:gravity="center_vertical"
            android:id="@+id/textViewDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextStyle.Text.Regular.Primary"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/uikitSecondary"
            android:gravity="center_vertical"
            android:id="@+id/textViewInfoDescription"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/add_phone_number_more_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewDescription"
            style="@style/TextStyle.Text.Regular.Primary"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/textViewDisableSpam"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/disable_spam"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewDescription"
            style="@style/TextStyle.Text.Regular.Primary"/>
    </LinearLayout>
    <org.xplatform.uikit.components.header.DsHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:isLoading="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutDescription"
        app:title="@string/confirmation_methods"
        style="@style/Widget.DsHeader.Small"/>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellAuthenticator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:first="true"
        app:last="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_authenticator"
            style="@style/Widget.DSCell.Left.Icon.Back"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/code_by_authenticator"
            style="@style/Widget.DSCell.Middle.Title.L"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellCodeSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:first="true"
        app:last="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellAuthenticator"
        app:layout_goneMarginTop="0dp">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_code_sms"
            style="@style/Widget.DSCell.Left.Icon.Back"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/get_code_via_sms"
            style="@style/Widget.DSCell.Middle.Title.L"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellVoiceSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:first="true"
        app:last="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellCodeSms">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_call"
            style="@style/Widget.DSCell.Left.Icon.Back"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/get_code_via_voice_sms"
            style="@style/Widget.DSCell.Middle.Title.L"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellTelegram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:first="true"
        app:last="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellVoiceSms">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_telegram"
            style="@style/Widget.DSCell.Left.Icon.Back"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/get_code_via_telegram"
            style="@style/Widget.DSCell.Middle.Title.L"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellCallCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:first="true"
        app:last="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cellTelegram">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_call_code"
            style="@style/Widget.DSCell.Left.Icon.Back"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/get_code_via_call"
            style="@style/Widget.DSCell.Middle.Title.L"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <FrameLayout
        android:id="@+id/progress"
        android:background="@color/static_black_20"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/actionBarSize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
