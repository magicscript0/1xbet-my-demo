<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivPerson"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_resident_person_default_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3:5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivExtinguisher"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_resident_fire_extinguisher"
        app:layout_constraintBottom_toBottomOf="@+id/ivPerson"
        app:layout_constraintLeft_toLeftOf="@+id/guideExtinguisherStart"
        app:layout_constraintRight_toRightOf="@+id/ivPerson"
        app:layout_constraintTop_toTopOf="@+id/guideExtinguisherTop"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideExtinguisherStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.54"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideExtinguisherTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.55"/>
</androidx.constraintlayout.widget.ConstraintLayout>
