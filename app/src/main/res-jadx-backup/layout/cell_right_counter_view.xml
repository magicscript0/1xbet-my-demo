<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.counter.DsCounter
        android:layout_gravity="center_vertical"
        android:id="@+id/counter"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_marginVertical="@dimen/space_12"
        app:counterComponentStyle="secondary"
        app:tint="@color/secondary_color_selector"/>
    <org.xplatform.uikit.components.list_checkbox.DsListCheckBox
        android:layout_gravity="center_vertical"
        android:id="@+id/checkbox"
        android:duplicateParentState="true"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_4"
        style="@style/Widget.DSListCheckbox.Primary"/>
    <org.xplatform.uikit.components.accordion.DsAccordion
        android:layout_gravity="center_vertical"
        android:id="@+id/accordion"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_4"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/button"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_4"
        style="@style/DSButton.Large.Tertiary.IconRectangle"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ivIcon"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="@dimen/size_20"
        android:layout_height="@dimen/size_20"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_8"/>
    <Space
        android:id="@+id/space"
        android:layout_width="@dimen/space_12"
        android:layout_height="wrap_content"/>
</merge>
