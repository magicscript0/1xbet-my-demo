<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivGameBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/statistic_background_image_height"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/default_background"/>
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/staticNavigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:backgroundColor="?attr/uikitStaticTransparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationBarStyle="title"
        app:navigationIconTint="?attr/uikitStaticWhite"
        app:showSeparator="false"
        app:title="@string/statistic_match_progress_title"
        app:titleTextColor="?attr/uikitStaticWhite"/>
    <org.xplatform.statistic.statistic_core.presentation.view.CoreHeadView
        android:id="@+id/teamCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/staticNavigationBar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rvChips"
        android:background="@drawable/bg_rounded_top_corners_16dp_new"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamCardView"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpMatchProgress"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rvChips"/>
    <FrameLayout
        android:id="@+id/flStatusView"
        android:background="@drawable/background_round_content_background_new"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamCardView">
        <org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout
            android:orientation="vertical"
            android:id="@+id/shimmersCommon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/match_progress_tennis_shimmer"/>
        </org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout>
        <org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout
            android:orientation="vertical"
            android:id="@+id/shimmersShort"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/match_progress_voleyball_shimmer"/>
        </org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout>
        <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
            android:id="@+id/lottieContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
