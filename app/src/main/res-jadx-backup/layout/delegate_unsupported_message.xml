<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@drawable/message_system_bg"
    android:paddingLeft="@dimen/space_12"
    android:paddingTop="@dimen/space_8"
    android:paddingRight="@dimen/space_12"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_40"
    android:layout_marginRight="@dimen/space_40"
    android:layout_marginBottom="@dimen/space_8"
    android:maxWidth="@dimen/size_240"
    android:layout_marginHorizontal="@dimen/space_40"
    android:paddingHorizontal="@dimen/space_12"
    android:paddingVertical="@dimen/space_8">
    <TextView
        android:textSize="@dimen/text_12"
        android:textColor="?attr/uikitSecondary"
        android:autoLink="phone|web"
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</LinearLayout>
