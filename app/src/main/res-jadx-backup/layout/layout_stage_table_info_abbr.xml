<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_16">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="@dimen/space_62"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvGameCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_title_count_games"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullGameCount"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullGameCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullGameCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_full_title_count_games"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvWinCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_status_win"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullWinCount"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullWinCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullWinCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/stage_table_full_title_win"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvFullGameCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvDrawCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_status_draw"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullDrawCount"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullDrawCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullDrawCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/stage_table_full_title_draw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvFullWinCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvLoseCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_status_lose"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullLoseCount"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullLoseCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullLoseCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/stage_table_full_title_lose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvFullDrawCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvGoalCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_title_count_goals_scored"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullGoalCount"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullGoalCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullGoalCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/stage_table_full_title_count_goals_scored"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvFullLoseCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvMissedGoalCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_title_count_goals_missed"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullMissedGoalCount"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullMissedGoalCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullMissedGoalCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/stage_table_full_title_count_goals_missed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvFullGoalCount"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:id="@+id/tvGoalDifference"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/stage_table_title_count_goals_difference"
        app:layout_constraintBottom_toBottomOf="@+id/tvFullGoalDifference"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFullGoalDifference"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:id="@+id/tvFullGoalDifference"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:text="@string/stage_table_full_title_count_goals_difference"
        android:layout_marginVertical="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@+id/tvFullMissedGoalCount"/>
</androidx.constraintlayout.widget.ConstraintLayout>
