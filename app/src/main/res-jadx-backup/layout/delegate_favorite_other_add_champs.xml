<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/rounded_background_16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_66"
    android:backgroundTint="?attr/uikitBackgroundContent">
    <ImageView
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/space_8"
        app:srcCompat="@drawable/ic_glyph_plus_small"
        app:tint="?attr/uikitPrimary"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Text.Medium"
        android:textColor="?attr/uikitPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add"/>
</LinearLayout>
