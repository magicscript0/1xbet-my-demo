<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_background_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivSportIcon"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginTop="@dimen/space_12"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_football"
        app:tint="?attr/uikitSecondary80"/>
    <ImageView
        android:id="@+id/ivCloseTrackButton"
        android:padding="@dimen/space_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/ivSportIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivSportIcon"
        app:srcCompat="@drawable/ic_glyph_cancel"
        app:tint="?attr/uikitPrimary"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvChampName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivSportIcon"
        app:layout_constraintEnd_toStartOf="@+id/ivCloseTrackButton"
        app:layout_constraintStart_toEndOf="@+id/ivSportIcon"
        app:layout_constraintTop_toTopOf="@+id/ivSportIcon"
        style="@style/TextAppearance.Caption.Regular.L"/>
    <TextView
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvOppName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/size_28"
        android:maxLines="2"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toStartOf="@+id/ivCloseTrackButton"
        app:layout_constraintStart_toStartOf="@+id/ivSportIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvChampName"
        style="@style/TextAppearance.Caption.Medium.L"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/tvDateName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="@+id/tvOppName"
        app:layout_constraintStart_toStartOf="@+id/tvOppName"
        app:layout_constraintTop_toBottomOf="@+id/tvOppName"
        style="@style/TextAppearance.Caption.Regular.L"/>
    <org.xplatform.uikit.components.market.view.DsMarketCoefficient
        android:id="@+id/vMarket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_2"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDateName"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llAutoSub"
        android:paddingBottom="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/vMarket"
        app:layout_constraintTop_toBottomOf="@+id/vMarket">
        <ImageView
            android:id="@+id/ivAutoSub"
            android:background="@drawable/circle_background"
            android:layout_width="@dimen/size_14"
            android:layout_height="@dimen/size_14"
            android:src="@drawable/ic_glyph_move_horizontal_small"
            android:importantForAccessibility="no"
            android:backgroundTint="?attr/uikitPrimary"/>
        <TextView
            android:id="@+id/tvAutoSub"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/auto_sub_title"
            android:includeFontPadding="false"
            android:drawablePadding="@dimen/space_4"
            android:layout_marginStart="@dimen/space_4"
            app:drawableTint="?attr/uikitSecondary"
            style="@style/TextStyle.Caption.Regular.L.TextPrimary"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llBetOptions"
        android:paddingBottom="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="@+id/vMarket"
        app:layout_constraintStart_toStartOf="@+id/vMarket"
        app:layout_constraintTop_toBottomOf="@+id/llAutoSub">
        <ImageView
            android:id="@+id/imgBetOption"
            android:layout_width="@dimen/size_14"
            android:layout_height="@dimen/size_14"
            android:src="@drawable/ic_glyph_color_optibet"/>
        <TextView
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/txtBetOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_bet"
            android:includeFontPadding="false"
            android:drawablePadding="@dimen/space_4"
            android:layout_marginStart="@dimen/space_4"
            app:drawableTint="?attr/uikitSecondary"
            style="@style/TextStyle.Caption.Regular.L"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
