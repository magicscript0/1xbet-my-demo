<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="?attr/uikitBackground"
    android:paddingLeft="@dimen/large_horizontal_margin_dynamic"
    android:paddingTop="@dimen/space_16"
    android:paddingRight="@dimen/large_horizontal_margin_dynamic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/large_horizontal_margin_dynamic">
    <include
        android:id="@+id/toggleVipBet"
        layout="@layout/settings_cell_toggle_layout"/>
    <org.xplatform.uikit.components.footer.DsFooter
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vip_bet_terms_description"
        style="@style/Widget.DSFooter"/>
</LinearLayout>
