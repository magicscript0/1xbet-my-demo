<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/iconBackground"
        android:background="@drawable/circle_white"
        android:layout_width="@dimen/icon_size_32"
        android:layout_height="@dimen/icon_size_32"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginVertical="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivStartIcon"
        android:layout_width="@dimen/icon_size_20"
        android:layout_height="@dimen/icon_size_20"
        android:layout_margin="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="@+id/iconBackground"
        app:layout_constraintEnd_toEndOf="@+id/iconBackground"
        app:layout_constraintStart_toStartOf="@+id/iconBackground"
        app:layout_constraintTop_toTopOf="@+id/iconBackground"
        app:tint="?attr/colorPrimary"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:textSize="@dimen/text_16"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconBackground"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivLive"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvName"
        app:layout_constraintStart_toEndOf="@+id/tvName"
        app:layout_constraintTop_toTopOf="@+id/tvName"
        app:srcCompat="@drawable/red_circle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
