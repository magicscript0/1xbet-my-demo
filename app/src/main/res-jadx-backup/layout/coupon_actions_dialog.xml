<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:id="@+id/parent"
    android:background="?attr/uikitBackgroundContent"
    android:paddingTop="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellSave"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_download"
            style="@style/Widget.DSCell.Left.Icon"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/coupon_save"
            style="@style/Widget.DSCell.Middle.Title.L"/>
        <org.xplatform.uikit.components.separator.DsSeparator
            android:id="@+id/separatorSave"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_marginRight="@dimen/space_12"
            android:layout_marginHorizontal="@dimen/space_12"
            style="@style/Widget.DSSeparator.Separator60"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellUpload"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_upload"
            style="@style/Widget.DSCell.Left.Icon"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/coupon_load"
            style="@style/Widget.DSCell.Middle.Title.L"/>
        <org.xplatform.uikit.components.separator.DsSeparator
            android:id="@+id/separatorUpload"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_marginRight="@dimen/space_12"
            android:layout_marginHorizontal="@dimen/space_12"
            style="@style/Widget.DSSeparator.Separator60"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellGenerate"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_generation"
            style="@style/Widget.DSCell.Left.Icon"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/generate_coupon"
            style="@style/Widget.DSCell.Middle.Title.L"/>
        <org.xplatform.uikit.components.separator.DsSeparator
            android:id="@+id/separatorGenerate"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_marginRight="@dimen/space_12"
            android:layout_marginHorizontal="@dimen/space_12"
            style="@style/Widget.DSSeparator.Separator60"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/cellRemove"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            app:srcCompat="@drawable/ic_glyph_trash"
            style="@style/Widget.DSCell.Left.Icon"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            app:title="@string/remove_coupon"
            style="@style/Widget.DSCell.Middle.Title.L"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
</LinearLayout>
