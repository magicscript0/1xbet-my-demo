<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/layout_by_category"/>
    <org.xplatform.ui_core.viewcomponents.views.scrollable_table.table_view.TableViewImpl
        android:id="@+id/tableView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/emptyView"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llShimmers"
        android:paddingLeft="@dimen/large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_20"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:radius="@dimen/shimmer_size_360"
            android:layout_marginVertical="@dimen/space_12"
            style="@style/Widget.DSShimmer.Primary"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
