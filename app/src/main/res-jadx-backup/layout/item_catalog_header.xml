<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header"
    android:paddingLeft="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_8">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="center"
        android:id="@+id/materialCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/corner_radius_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivShowcaseBanner"
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="wrap_content"
            android:layout_height="124dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/materialCardView"
        app:layout_constraintStart_toStartOf="@+id/materialCardView"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
            android:ellipsize="end"
            android:id="@+id/tvShowcaseText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:minLines="1"
            android:maxEms="15"
            android:textAlignment="gravity"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textColor="?attr/uikitSecondary"
            android:ellipsize="end"
            android:id="@+id/tvShowcaseDescr"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_4"
            android:maxLines="1"
            android:minLines="1"
            android:maxEms="15"
            android:textAlignment="gravity"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
