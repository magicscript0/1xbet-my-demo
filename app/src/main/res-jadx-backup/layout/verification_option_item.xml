<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_8"
    android:layout_marginTop="@dimen/space_4"
    android:layout_marginRight="@dimen/space_8"
    android:layout_marginBottom="@dimen/space_4"
    android:backgroundTint="?attr/uikitBackgroundContent"
    android:layout_marginHorizontal="@dimen/space_8"
    android:layout_marginVertical="@dimen/space_4"
    app:cardCornerRadius="@dimen/radius_8">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/icon"
            android:background="@drawable/background_verification_option_logo"
            android:padding="@dimen/space_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_12"
            android:src="@drawable/verification_option_default_logo"
            app:layout_constraintBottom_toBottomOf="@+id/divider"
            app:layout_constraintEnd_toStartOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:layout_marginBottom="@dimen/space_2"
            app:layout_constraintEnd_toStartOf="@+id/openVerificationScreen"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/titleBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginBottom="@dimen/space_2"
            android:layout_marginVertical="@dimen/space_2"
            app:layout_constraintBottom_toBottomOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="@+id/title"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/openVerificationScreen"
            android:background="@drawable/ic_button_rounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_marginRight="@dimen/space_12"
            android:layout_marginHorizontal="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/title"
            app:layout_constraintTop_toTopOf="@+id/icon"
            app:srcCompat="@drawable/ic_keyboard_arrow_right"
            app:tint="?attr/uikitPrimary"/>
        <View
            android:id="@+id/divider"
            android:background="?attr/uikitSeparator30"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_1"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:layout_marginVertical="@dimen/space_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleBody"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2New"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/cardBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_12"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginRight="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_24"
            android:layout_marginHorizontal="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
