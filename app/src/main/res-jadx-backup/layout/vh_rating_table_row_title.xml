<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/uikitBackground"
    android:paddingLeft="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/row_height"
    android:paddingHorizontal="@dimen/space_8">
    <FrameLayout
        android:id="@+id/flRatingPosition"
        android:layout_width="@dimen/size_40"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivPosition"
            android:visibility="gone"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:scaleType="centerInside"
            app:tint="?attr/uikitSecondary"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionMediumNew"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textDirection="ltr"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="end"
        app:barrierMargin="@dimen/space_4"
        app:constraint_referenced_ids="flRatingPosition"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ivCountryIcon"
        android:visibility="gone"
        android:layout_width="@dimen/icon_size_16"
        android:layout_height="@dimen/icon_size_16"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/space_4"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivTeam"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_no_country"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ivTeam"
        android:visibility="gone"
        android:layout_width="@dimen/icon_size_16"
        android:layout_height="@dimen/icon_size_16"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/space_4"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvTitle"
        app:layout_constraintStart_toEndOf="@+id/ivCountryIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/space_4"
        app:srcCompat="@drawable/ic_profile"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:ellipsize="marquee"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/endBarrier"
        app:layout_constraintStart_toEndOf="@+id/ivTeam"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/endBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ivExpand"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ivExpand"
        android:visibility="gone"
        android:layout_width="@dimen/icon_size_16"
        android:layout_height="@dimen/icon_size_16"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_down"/>
</androidx.constraintlayout.widget.ConstraintLayout>
