<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcv_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_8"
    android:layout_marginTop="@dimen/space_2"
    android:layout_marginRight="@dimen/space_8"
    android:layout_marginBottom="@dimen/space_2"
    android:layout_marginHorizontal="@dimen/space_8"
    android:layout_marginVertical="@dimen/space_2"
    app:rippleColor="@android:color/transparent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/icon_background"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/background_icon_round"
                app:tint="?attr/uikitBackground"/>
            <ImageView
                android:id="@+id/iv_title_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_showcase_slots"
                app:layout_constraintBottom_toBottomOf="@+id/icon_background"
                app:layout_constraintEnd_toEndOf="@+id/icon_background"
                app:layout_constraintStart_toStartOf="@+id/icon_background"
                app:layout_constraintTop_toTopOf="@+id/icon_background"
                app:tint="?attr/uikitSecondary"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginStart="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="@+id/icon_background"
                app:layout_constraintStart_toEndOf="@+id/icon_background"
                app:layout_constraintTop_toTopOf="@+id/icon_background"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBody1BoldNew"
                android:textSize="@dimen/text_14"
                android:textColor="?attr/uikitPrimary"
                android:layout_gravity="center"
                android:id="@+id/tv_more"
                android:background="@drawable/bg_rounded_16dp_white"
                android:paddingLeft="@dimen/space_12"
                android:paddingTop="@dimen/space_2"
                android:paddingRight="@dimen/space_12"
                android:paddingBottom="@dimen/space_2"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all"
                android:layout_marginEnd="@dimen/space_8"
                android:backgroundTint="?attr/uikitPrimary20"
                android:paddingHorizontal="@dimen/space_12"
                android:paddingVertical="@dimen/space_2"
                app:layout_constraintBottom_toBottomOf="@+id/icon_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/icon_background"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/aggregator_games_recycler"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_12"
            android:minHeight="96dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_header"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
