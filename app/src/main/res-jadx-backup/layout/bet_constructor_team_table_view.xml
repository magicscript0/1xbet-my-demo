<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/uikitBackgroundGroup"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/space_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/toggle_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/teams_group"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <ImageView
            android:id="@+id/first_team_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/space_16"
            android:src="@drawable/ic_team_1"
            android:layout_marginStart="@dimen/space_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:id="@+id/first_team_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/team_first"
            android:layout_marginStart="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/first_team_image"
            app:layout_constraintStart_toEndOf="@+id/first_team_image"
            app:layout_constraintTop_toTopOf="@+id/first_team_image"/>
        <ImageView
            android:id="@+id/second_team_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/space_16"
            android:src="@drawable/ic_team_2"
            android:layout_marginStart="@dimen/space_12"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:id="@+id/second_team_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/team_sec"
            android:layout_marginStart="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/second_team_image"
            app:layout_constraintStart_toEndOf="@+id/second_team_image"
            app:layout_constraintTop_toTopOf="@+id/second_team_image"/>
        <ImageView
            android:id="@+id/iv_expand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_expand"
            android:rotation="180"
            android:layout_marginEnd="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="@+id/second_team_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/second_team_image"
            app:tint="?attr/uikitSecondary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/teams_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_4"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/first_team_image">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFirstTeamPlayers"
                android:background="?attr/uikitBackgroundGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_4"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSecondTeamPlayers"
                android:background="?attr/uikitBackgroundGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
