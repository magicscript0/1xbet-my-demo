        android:radius="@dimen/radius_16"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:layout_marginTop="@dimen/size_8"
        android:radius="@dimen/radius_16"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmer5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_108"
        android:layout_marginTop="@dimen/size_8"
        android:radius="@dimen/radius_16"
        style="@style/Widget.DSShimmer.Primary"/>
</LinearLayout>
