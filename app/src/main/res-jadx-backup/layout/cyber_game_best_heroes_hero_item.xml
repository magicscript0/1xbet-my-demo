<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/space_8"
    android:paddingTop="@dimen/space_4"
    android:paddingRight="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_8">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/innerFrame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_32">
        <include
            android:id="@+id/heroFrame"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_24"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginVertical="@dimen/space_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/cyber_game_best_heroes_hero_image_view"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionBold"
            android:textSize="@dimen/text_12"
            android:textColor="@color/static_white"
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/heroFrame"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionBold"
            android:textSize="@dimen/text_12"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/tvFirstRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/size_48"
            android:layout_marginEnd="@dimen/space_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionBold"
            android:textSize="@dimen/text_12"
            android:textColor="@color/cyber_best_heroes_winrate_title_color"
            android:gravity="center"
            android:id="@+id/tvSecondRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/size_48"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
