<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <View
        android:id="@+id/vRoundedBackground"
        android:background="@drawable/bg_rounded_corners_16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/tvMessage"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        app:layout_constraintTop_toTopOf="@+id/tvTitleMessage"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/uikitSecondary"
        android:layout_gravity="center"
        android:id="@+id/tvTitleMessage"
        android:paddingTop="@dimen/space_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_28"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_28"
        android:text="@string/confirmation"
        android:layout_marginHorizontal="@dimen/space_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        style="@style/TextStyle.Headline.Medium.Shrink.TextPrimary"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvMessage"
        android:paddingBottom="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_28"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_28"
        android:layout_marginHorizontal="@dimen/space_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleMessage"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottomBarType="oneButton"
        app:firstButtonText="@string/send_sms"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
