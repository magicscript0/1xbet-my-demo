<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_rounded_corners_10dp"
    android:layout_width="@dimen/size_56"
    android:layout_height="@dimen/size_60"
    android:elevation="@dimen/elevation_0">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineNameTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineNameBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="@dimen/icon_size_30"
        android:layout_height="@dimen/icon_size_30"
        android:layout_marginTop="@dimen/space_4"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/name"
        android:paddingLeft="@dimen/space_2"
        android:paddingRight="@dimen/space_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.8"
        android:paddingHorizontal="@dimen/space_2"
        app:autoSizeMaxTextSize="@dimen/text_10"
        app:autoSizeMinTextSize="@dimen/text_8"
        app:autoSizeStepGranularity="@dimen/text_autosize_step_1"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineNameBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineNameTop"/>
</androidx.constraintlayout.widget.ConstraintLayout>
