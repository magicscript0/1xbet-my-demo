<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardImageView
        android:id="@+id/ivBanner"
        android:tag="bannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.Radius16"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llActionCard"
        android:background="@drawable/rounded_background_16_content"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_8">
        <ImageView
            android:id="@+id/ivActionCardIcon"
            android:layout_width="@dimen/size_20"
            android:layout_height="@dimen/size_20"
            android:layout_marginBottom="@dimen/space_12"
            app:tint="?attr/uikitPrimary"/>
        <TextView
            android:textColor="?attr/uikitPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvActionCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/TextAppearance.Text.Medium"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/viewGradient"
        android:background="@drawable/aggregator_game_card_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="start|bottom"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_28"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/TextStyle.Headline.Medium.StaticWhite"/>
    <TextView
        android:ellipsize="end"
        android:layout_gravity="start|bottom"
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/TextStyle.Text.Regular.StaticWhite80"/>
    <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardRoundedTag
        android:ellipsize="end"
        android:layout_gravity="start|top"
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        style="@style/Widget.DSTag.Rounded.Primary"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/viewAction"
        android:layout_width="@dimen/size_48"
        android:layout_height="@dimen/size_48"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/ivAction"
        android:background="@drawable/rounded_background_10"
        android:padding="@dimen/space_6"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:layout_margin="@dimen/space_8"
        android:contentDescription="@null"
        android:backgroundTint="?attr/uikitStaticBlack60"
        app:tint="?attr/uikitStaticWhite"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:radius="@dimen/radius_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
