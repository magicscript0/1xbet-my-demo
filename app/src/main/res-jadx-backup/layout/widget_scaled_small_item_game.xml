<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widgetItemContainer"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:theme="@style/AppTheme.AppWidgetContainer"
        android:orientation="vertical"
        android:background="@drawable/bg_rectangle_radius_12dp"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_2"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:backgroundTint="?attr/uikitWidgetContent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageViewIcon"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:scaleType="centerInside"
                android:tint="?attr/uikitWidgetIcon70"
                android:layout_alignTop="@+id/textViewTitle"
                android:layout_alignBottom="@+id/textViewTitle"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:textColor="?attr/uikitWidgetText"
                android:ellipsize="end"
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textDirection="locale"
                android:layoutDirection="locale"
                android:layout_marginStart="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_toEndOf="@+id/imageViewIcon"
                android:layout_alignParentEnd="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/containerGameStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:layout_below="@+id/textViewTitle"
                android:layout_alignStart="@+id/textViewTitle">
                <ImageView
                    android:id="@+id/imageViewLive"
                    android:layout_width="@dimen/icon_size_34"
                    android:layout_height="@dimen/icon_size_14"
                    android:src="@drawable/ic_live_red_soft_rectangle"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle1New"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/uikitWidgetText"
                    android:id="@+id/textViewDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/matchContainer"
            android:paddingTop="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:textColor="?attr/uikitWidgetText"
                android:gravity="center_vertical"
                android:id="@+id/textViewTeamOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/widget_team_name_min_height"
                android:lines="2"
                android:layout_alignParentTop="true"
                android:textDirection="locale"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_toStartOf="@+id/divider"
                android:layout_toEndOf="@+id/imageViewTeamOne"/>
            <ImageView
                android:id="@+id/imageViewTeamOne"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:scaleType="fitCenter"
                android:layout_alignTop="@+id/textViewTeamOne"
                android:layout_alignBottom="@+id/textViewTeamOne"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/imageViewTeamTwo"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:scaleType="fitCenter"
                android:layout_below="@+id/imageViewTeamOne"
                android:layout_alignTop="@+id/textViewTeamTwo"
                android:layout_alignBottom="@+id/textViewTeamTwo"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:textColor="?attr/uikitWidgetText"
                android:gravity="start|center_vertical"
                android:id="@+id/textViewTeamTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:minHeight="@dimen/widget_team_name_min_height"
                android:lines="2"
                android:layout_below="@+id/textViewTeamOne"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_toStartOf="@+id/divider"
                android:layout_toEndOf="@+id/imageViewTeamTwo"/>
            <ImageView
                android:id="@+id/divider"
                android:background="?attr/uikitSeparator"
                android:layout_width="@dimen/divider_1"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_6"
                android:layout_alignTop="@+id/textViewTeamOne"
                android:layout_alignBottom="@+id/textViewTeamTwo"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_toStartOf="@+id/textViewPoints"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline6BoldNew"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="?attr/uikitWidgetText"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/textViewPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="2"
                android:minEms="3"
                android:layout_centerVertical="true"
                android:foregroundGravity="center"
                android:fontFamily="@font/roboto_medium"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
