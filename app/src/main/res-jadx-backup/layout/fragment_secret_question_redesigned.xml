<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showShadow="false"
        app:title="@string/secret_question"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        style="Widget.DSSeparator.Separator60"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmers"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shimmer_size_164"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginBottom="@dimen/space_4"
        android:radius="@dimen/radius_24"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        style="@style/Widget.DSShimmer.Primary"/>
    <View
        android:id="@+id/vRoundedBackground"
        android:background="@drawable/bg_rounded_corners_16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintBottom_toBottomOf="@+id/tfAnswer"
        app:layout_constraintTop_toTopOf="@+id/tfChooseQuestionType"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/tfChooseQuestionType"
        android:paddingTop="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"
        app:hint="@string/secret_question_hint"
        app:layout_constraintEnd_toEndOf="@+id/vRoundedBackground"
        app:layout_constraintStart_toStartOf="@+id/vRoundedBackground"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        style="@style/Widget.DSTextField.Basic.Chevron"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/tfCustomUserQuestion"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"
        app:hint="@string/secret_question_your_question_hint"
        app:layout_constraintEnd_toEndOf="@+id/vRoundedBackground"
        app:layout_constraintStart_toStartOf="@+id/vRoundedBackground"
        app:layout_constraintTop_toBottomOf="@+id/tfChooseQuestionType"
        style="@style/Widget.DSTextField.Basic"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/tfAnswer"
        android:paddingBottom="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:inputType="textEmailAddress"
        android:layout_marginHorizontal="@dimen/space_16"
        app:hint="@string/enter_answer"
        app:layout_constraintEnd_toEndOf="@+id/vRoundedBackground"
        app:layout_constraintStart_toStartOf="@+id/vRoundedBackground"
        app:layout_constraintTop_toBottomOf="@+id/tfCustomUserQuestion"
        style="@style/Widget.DSTextField.Basic"/>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottomBarType="oneButton"
        app:firstButtonText="@string/save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/lottieErrorView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
