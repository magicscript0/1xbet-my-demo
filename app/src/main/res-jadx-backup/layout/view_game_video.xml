<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:layout_gravity="center"
        android:id="@+id/vBroadcastingVideo"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:surface_type="texture_view"/>
    <ImageView
        android:id="@+id/blurOverlayView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateOnly="true"/>
    <View
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/soundButton"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginTop="@dimen/space_8"
        android:alpha="0"
        android:layout_marginEnd="@dimen/space_16"
        app:srcCompat="@drawable/ic_glyph_sound_on"/>
    <org.xplatform.game_broadcasting.impl.presentation.views.GameBroadcastingControlPanelView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/vGameBroadcastingControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
