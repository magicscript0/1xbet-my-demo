<?xml version="1.0" encoding="utf-8"?>
<org.xplatform.uikit.components.cells.DsMenuCell xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_64">
    <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
        android:id="@+id/icon"
        android:layout_width="@dimen/size_24"
        app:badge="dot"
        app:tint="?attr/uikitPrimary"
        style="@style/Widget.DSCell.Left.Icon"/>
    <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
        android:id="@+id/title"
        style="@style/Widget.DSCell.Middle.Title.S"/>
    <org.xplatform.uikit.components.cells.right.DsCellRightIconAndButton
        android:id="@+id/cellRightIconAndButton"
        android:layout_width="@dimen/size_28"
        app:icon="@drawable/ic_glyph_chevron_right_small"
        style="@style/Widget.DSCell.Right"/>
</org.xplatform.uikit.components.cells.DsMenuCell>
