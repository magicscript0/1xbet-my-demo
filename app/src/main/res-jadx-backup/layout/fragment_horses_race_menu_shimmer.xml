<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginRight="@dimen/space_16"
            android:layout_marginHorizontal="@dimen/space_16">
            <View
                android:background="@drawable/white_radius"
                android:layout_width="@dimen/icon_size_40"
                android:layout_height="@dimen/icon_size_40"
                android:backgroundTint="?attr/uikitSeparator"/>
            <View
                android:layout_gravity="center"
                android:background="@drawable/chip_16_background"
                android:layout_width="@dimen/shimmer_size_128"
                android:layout_height="@dimen/icon_size_16"
                android:layout_marginStart="@dimen/space_8"
                android:backgroundTint="?attr/uikitSeparator"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginRight="@dimen/space_16"
            android:layout_marginHorizontal="@dimen/space_16">
            <View
                android:background="@drawable/white_radius"
                android:layout_width="@dimen/icon_size_40"
                android:layout_height="@dimen/icon_size_40"
                android:backgroundTint="?attr/uikitSeparator"/>
            <View
                android:layout_gravity="center"
                android:background="@drawable/chip_16_background"
                android:layout_width="@dimen/shimmer_size_192"
                android:layout_height="@dimen/icon_size_16"
                android:layout_marginStart="@dimen/space_8"
                android:backgroundTint="?attr/uikitSeparator"/>
        </LinearLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
