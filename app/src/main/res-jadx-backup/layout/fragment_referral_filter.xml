<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/filter"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textColor="?attr/uikitPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/users"
                android:layout_marginHorizontal="@dimen/space_16"
                android:layout_marginVertical="@dimen/space_16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/chipsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/size_16"
                android:layout_marginRight="@dimen/size_16"
                android:layout_marginBottom="@dimen/space_16"
                android:overScrollMode="never"
                android:layout_marginHorizontal="@dimen/size_16"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTypeGame"/>
            <View
                android:background="?attr/uikitBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_8"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textColor="?attr/uikitPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/registration_date_period"
                android:layout_marginHorizontal="@dimen/space_16"
                android:layout_marginVertical="@dimen/space_16"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2"
                android:textColor="?attr/uikitTextPrimary"
                android:id="@+id/datePeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/history_filter_set_period"
                android:layout_marginHorizontal="@dimen/space_16"/>
            <View
                android:background="?attr/uikitBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_8"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profitGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:layout_constraintTop_toBottomOf="@+id/dateGroup">
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textColor="?attr/uikitPrimary"
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_16"
                    android:layout_marginRight="@dimen/space_16"
                    android:text="@string/user_network_profit"
                    android:layout_marginHorizontal="@dimen/space_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/inputFrom"
                    android:background="@drawable/rounded_background_8"
                    android:longClickable="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_44"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:hint="@string/from_"
                    android:maxLines="1"
                    android:inputType="numberDecimal"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/space_12"
                    android:layout_marginStart="@dimen/space_16"
                    android:backgroundTint="?attr/uikitBackground"
                    android:layout_marginVertical="@dimen/space_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/separator"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title"
                    style="@style/Widget.AppTheme.EditText.New"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:id="@+id/separator"
                    android:layout_width="@dimen/size_24"
                    android:layout_height="@dimen/size_24"
                    android:text="@string/minus"
                    android:textAlignment="center"
                    app:layout_constraintBottom_toBottomOf="@+id/inputBefore"
                    app:layout_constraintEnd_toStartOf="@+id/inputBefore"
                    app:layout_constraintStart_toEndOf="@+id/inputFrom"
                    app:layout_constraintTop_toTopOf="@+id/inputBefore"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/inputBefore"
                    android:background="@drawable/rounded_background_8"
                    android:longClickable="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_44"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:hint="@string/to_"
                    android:maxLines="1"
                    android:inputType="numberDecimal"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_16"
                    android:backgroundTint="?attr/uikitBackground"
                    android:layout_marginVertical="@dimen/space_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/separator"
                    app:layout_constraintTop_toBottomOf="@+id/title"
                    style="@style/Widget.AppTheme.EditText.New"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="?attr/uikitBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_8"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textColor="?attr/uikitPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/sort_by"
                android:layout_marginHorizontal="@dimen/space_16"
                android:layout_marginVertical="@dimen/space_16"/>
            <RadioGroup
                android:id="@+id/sortTypeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                android:layout_marginStart="@dimen/space_16">
                <RadioButton
                    android:id="@+id/registrationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/by_registration_date"
                    style="@style/Widget.AppTheme.RadioButton.New"/>
                <RadioButton
                    android:id="@+id/betQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/by_bet_count"
                    style="@style/Widget.AppTheme.RadioButton.New"/>
                <RadioButton
                    android:id="@+id/profit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/by_profit"
                    style="@style/Widget.AppTheme.RadioButton.New"/>
            </RadioGroup>
            <View
                android:background="?attr/uikitBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_8"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textColor="?attr/uikitPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/sort_by"
                android:layout_marginHorizontal="@dimen/space_16"
                android:layout_marginVertical="@dimen/space_16"/>
            <RadioGroup
                android:id="@+id/sortDirectionGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_16"
                android:layout_marginStart="@dimen/space_16">
                <RadioButton
                    android:id="@+id/ascending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ascending"
                    style="@style/Widget.AppTheme.RadioButton.New"/>
                <RadioButton
                    android:id="@+id/descending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/descending"
                    app:buttonTint="@color/checkable_radio_button_selector_new"
                    style="@style/Widget.AppTheme.RadioButton.New"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottomBarType="twoHorizontalButtons"
        app:firstButtonText="@string/discard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:secondButtonText="@string/show"/>
</androidx.constraintlayout.widget.ConstraintLayout>
