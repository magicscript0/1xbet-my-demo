<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/ivTeamIcon"
        android:layout_width="@dimen/icon_size_20"
        android:layout_height="@dimen/icon_size_20"
        android:layout_marginEnd="@dimen/space_8"
        app:cornerRadiusImageView="@dimen/corner_radius_10"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:textSize="@dimen/text_10"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/tvTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_36"/>
</FrameLayout>
