<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/confirmation"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clActivationContainer"
        android:background="@drawable/bg_rounded_corners_16dp"
        android:padding="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_12"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/confirm_by_authenticator_another_method_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Text.Regular.Primary"/>
        <org.xplatform.uikit.components.text_field.DsTextField
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tfSmsCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:inputType="number"
            app:hint="@string/sms_activate_code_hint"
            app:layout_constraintBottom_toTopOf="@+id/clPushEnableMessage"
            app:layout_constraintEnd_toStartOf="@+id/tagAutofill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage"
            style="@style/Widget.DSTextField.Basic"/>
        <org.xplatform.uikit.components.tag.DsTag
            android:textColor="@color/static_white"
            android:id="@+id/tagAutofill"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="Autofill"
            android:layout_marginStart="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="@+id/tfSmsCode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tfSmsCode"
            app:layout_constraintTop_toTopOf="@+id/tfSmsCode"
            style="@style/Widget.DSTag.RectangularL.Filled.Green"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPushEnableMessage"
            android:background="@drawable/bg_rounded_corners_16dp"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:backgroundTint="?attr/uikitBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tagAutofill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tfSmsCode">
            <ImageView
                android:id="@+id/ivInfo"
                android:layout_width="@dimen/size_24"
                android:layout_height="@dimen/size_24"
                android:layout_marginTop="@dimen/space_12"
                android:src="@drawable/ic_glyph_info_circle_filled"
                android:layout_marginStart="@dimen/space_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/uikitSecondary"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_12"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/authenticator_push_message_title"
                android:maxLines="2"
                android:textDirection="locale"
                android:layout_marginHorizontal="@dimen/space_12"
                android:layout_marginVertical="@dimen/space_16"
                app:layout_constraintStart_toEndOf="@+id/ivInfo"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TextStyle.Text.Regular.TextPrimary"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_12"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/authenticator_push_message_desc"
                android:layout_marginHorizontal="@dimen/space_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                style="@style/TextStyle.Text.Regular.Secondary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/errorView"
        android:background="?attr/uikitBackgroundContent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
    <androidx.core.widget.ContentLoadingProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyleInverse"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/uikitSecondary"
        android:gravity="center"
        android:id="@+id/tvResendSms"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        android:layout_marginVertical="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clActivationContainer"
        style="@style/TextStyle.Text.Regular.Primary"/>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottomBarType="threeVerticalButtons"
        app:firstButtonStyle="@style/DSButton.Large.Secondary"
        app:firstButtonText="@string/send_again"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:secondButtonStyle="@style/DSButton.Large.Secondary"
        app:secondButtonText="@string/get_code_use_another_method"
        app:thirdButtonText="@string/confirm"/>
</androidx.constraintlayout.widget.ConstraintLayout>
