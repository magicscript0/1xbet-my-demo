<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:background="@drawable/rounded_background_16_content"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvSubTitle"
            android:paddingBottom="@dimen/space_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextStyle.Title.Medium.S.TextPrimary"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/dateTv"
            android:paddingBottom="@dimen/space_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/TextStyle.Caption.Regular.L.Secondary"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/rounded_background_16_content"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_4"
            android:backgroundTint="?attr/uikitBackground">
            <TextView
                android:textColor="?attr/uikitSecondary"
                android:ellipsize="end"
                android:id="@+id/tvTitleCashback"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="2"
                android:textDirection="locale"
                android:layout_marginEnd="@dimen/space_22"
                app:autoSizeMaxTextSize="@dimen/text_14"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@+id/btnCashBack"
                app:layout_constraintEnd_toStartOf="@+id/btnCashBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnCashBack"
                style="@style/TextStyle.Text.Regular"/>
            <org.xplatform.uikit_aggregator.aggregatorcashbackamount.CustomCurrencyEllipsizeTextView
                android:gravity="center_vertical"
                android:id="@+id/tvAmountCurrency"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_marginEnd="@dimen/space_4"
                app:layout_constraintBottom_toBottomOf="@+id/btnCashBack"
                app:layout_constraintEnd_toStartOf="@+id/btnCashBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnCashBack"
                style="@style/TextStyle.Title.Medium.M.Shrink.TextPrimary"/>
            <org.xplatform.uikit.components.buttons.DsButton
                android:id="@+id/btnCashBack"
                android:tag="btnCashBackTag"
                android:layout_width="@dimen/size_128"
                android:layout_height="wrap_content"
                app:dsButtonSize="large"
                app:dsButtonStyle="primary"
                app:dsButtonType="label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_128"
        android:radius="@dimen/radius_16"/>
</merge>
