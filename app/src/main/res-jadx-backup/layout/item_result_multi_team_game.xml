<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_4"
    android:elevation="@dimen/elevation_2">
    <ImageView
        android:id="@+id/champIcon"
        android:padding="@dimen/space_8"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/firstTeamFirstImage"
        app:layout_constraintEnd_toStartOf="@+id/champName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:id="@+id/champName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/champIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/champIcon"
        app:layout_constraintTop_toTopOf="@+id/champIcon"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumPrimaryNew"
        android:gravity="end|center_vertical"
        android:id="@+id/teamOne"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="2"
        android:textDirection="ltr"
        android:layoutDirection="ltr"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/firstTeamFirstImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/firstTeamFirstImage"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/firstTeamFirstImage"
        android:layout_width="@dimen/size_22"
        android:layout_height="@dimen/size_22"
        android:layout_marginTop="@dimen/space_8"
        android:contentDescription="@null"
        android:layoutDirection="ltr"
        app:cornerRadiusImageView="@dimen/corner_radius_10"
        app:layout_constraintBottom_toTopOf="@+id/firstTeamSecondImage"
        app:layout_constraintEnd_toStartOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/champIcon"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/firstTeamSecondImage"
        android:layout_width="@dimen/size_22"
        android:layout_height="@dimen/size_22"
        android:layout_marginTop="@dimen/space_8"
        android:contentDescription="@null"
        android:layoutDirection="ltr"
        app:cornerRadiusImageView="@dimen/corner_radius_10"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/firstTeamFirstImage"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6Bold"
        android:gravity="center"
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:layoutDirection="ltr"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/firstTeamFirstImage"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/secondTeamFirstImage"
        android:layout_width="@dimen/size_22"
        android:layout_height="@dimen/size_22"
        android:layout_marginTop="@dimen/space_8"
        android:contentDescription="@null"
        android:layoutDirection="ltr"
        app:cornerRadiusImageView="@dimen/corner_radius_10"
        app:layout_constraintBottom_toTopOf="@+id/secondTeamSecondImage"
        app:layout_constraintStart_toEndOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/champIcon"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/secondTeamSecondImage"
        android:layout_width="@dimen/size_22"
        android:layout_height="@dimen/size_22"
        android:layout_marginTop="@dimen/space_8"
        android:contentDescription="@null"
        android:layoutDirection="ltr"
        app:cornerRadiusImageView="@dimen/corner_radius_10"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintStart_toEndOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/secondTeamFirstImage"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumPrimaryNew"
        android:gravity="start|center_vertical"
        android:id="@+id/teamTwo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="2"
        android:textDirection="ltr"
        android:layoutDirection="ltr"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondTeamFirstImage"
        app:layout_constraintTop_toTopOf="@+id/secondTeamFirstImage"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:gravity="center"
        android:id="@+id/date"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamOne"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:gravity="center"
        android:id="@+id/info"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/infoButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/date"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumHighlightNew"
        android:textSize="@dimen/text_12"
        android:gravity="center_vertical"
        android:id="@+id/infoButton"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:minHeight="@dimen/size_24"
        android:text="@string/additional_info"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
