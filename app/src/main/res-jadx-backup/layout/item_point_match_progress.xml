<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/uikitSecondary"
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionBoldNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvBreakPoint"
        android:background="@drawable/bg_rounded_corners_2dp_primary_new"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_progress_break_point"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:layout_marginStart="@dimen/space_2"
        android:backgroundTint="@color/static_dark_pink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvScore"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionBoldNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvSetPoint"
        android:background="@drawable/bg_rounded_corners_2dp_primary_new"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_progress_set_point"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:layout_marginStart="@dimen/space_2"
        android:backgroundTint="@color/static_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvBreakPoint"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionBoldNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvMatchPoint"
        android:background="@drawable/bg_rounded_corners_2dp_primary_new"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_progress_match_point"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:layout_marginStart="@dimen/space_2"
        android:backgroundTint="@color/static_teal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvSetPoint"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionBoldNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvDarts140"
        android:background="@drawable/bg_rounded_corners_2dp_primary_new"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_progress_darts_140"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:layout_marginStart="@dimen/space_2"
        android:backgroundTint="?attr/uikitSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvMatchPoint"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionBoldNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvDarts180"
        android:background="@drawable/bg_rounded_corners_2dp_primary_new"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/match_progress_darts_180"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:layout_marginStart="@dimen/space_2"
        android:backgroundTint="?attr/uikitPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvDarts140"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
