<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        layout="@layout/shimmer_stage_table"/>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:layout_gravity="center"
        android:id="@+id/emptyView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.ui_core.viewcomponents.views.scrollable_table.table_view.TableViewImpl
        android:id="@+id/rvTables"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        app:leftShadowEnabled="false"/>
    <org.xplatform.statistic.stage.impl.stagetable.presentation.common.NonScrollableRecyclerView
        android:id="@+id/shadows"
        android:paddingBottom="@dimen/space_24"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rvTables"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sticky_header_container"
        android:background="?attr/uikitBackground"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.xplatform.uikit.components.header.DsHeader
            android:id="@+id/group_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_8"
            android:layoutDirection="ltr"
            app:headerType="small"
            app:horizontalMargin="@dimen/extra_large_horizontal_margin_dynamic"
            app:isLoading="false"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <org.xplatform.ui_core.viewcomponents.views.scrollable_table.table_view.TableViewImpl
                android:id="@+id/rvColumnHeaders"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_50"
                android:layoutDirection="ltr"/>
            <View
                android:layout_gravity="end"
                android:id="@+id/rightShadow"
                android:background="@drawable/right_shadow"
                android:visibility="gone"
                android:layout_width="@dimen/size_36"
                android:layout_height="@dimen/size_50"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
