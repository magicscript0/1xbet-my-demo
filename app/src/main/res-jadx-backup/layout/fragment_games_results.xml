<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/loading_error"
        android:background="?attr/uikitBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:textColor="?attr/uikitSecondary"/>
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_56"
        android:elevation="@dimen/elevation_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/uikitSecondary"
        style="@style/Widget.AppTheme.Toolbar.New">
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
            android:textColor="?attr/uikitSecondary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="2"
            app:autoSizeMaxTextSize="@dimen/text_20"
            app:autoSizeMinTextSize="@dimen/text_12"
            app:autoSizeStepGranularity="@dimen/text_autosize_step_1"
            app:autoSizeTextType="uniform"/>
    </com.google.android.material.appbar.MaterialToolbar>
    <org.xplatform.ui_core.viewcomponents.swiperefreshlayout.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_28"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:splitMotionEvents="false"/>
    </org.xplatform.ui_core.viewcomponents.swiperefreshlayout.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
