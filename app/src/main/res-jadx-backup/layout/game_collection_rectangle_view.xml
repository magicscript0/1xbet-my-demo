<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.views.LoadableShapeableImageView
        android:id="@+id/uikitBannerPictureImageView"
        android:tag="bannerImage"
        android:layout_width="@dimen/size_84"
        android:layout_height="@dimen/size_128"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.Radius16"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/uikitBannerTechicalWorksImageView"
        android:visibility="gone"
        android:layout_width="@dimen/size_84"
        android:layout_height="@dimen/size_128"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.Radius16"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/uikitBannerGradientView"
        android:background="@drawable/gradient_banner_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_48"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|bottom"
        android:layout_gravity="bottom"
        android:id="@+id/uikitBannerLabelTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_8"
        android:maxLines="2"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:textLocale="locale"
        style="@style/TextStyle.Caption.Bold.L.StaticWhite"/>
</merge>
