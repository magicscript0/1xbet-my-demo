<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:padding="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerView"
        android:layout_width="@dimen/size_96"
        android:layout_height="@dimen/size_14"
        android:layout_marginTop="@dimen/space_16"
        android:radius="@dimen/radius_10"
        android:layout_marginStart="@dimen/space_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.cells.DsShimmerCell
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_8"
        app:first="true"
        app:last="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerView"
        app:showIcon="true"
        app:showLongTitle="true"
        style="@style/Widget.DSCell.Shimmers.Settings"/>
</androidx.constraintlayout.widget.ConstraintLayout>
