<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitStaticBlack80"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.Title.Medium.M"
        android:textColor="?attr/uikitStaticWhite"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/education"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:srcCompat="@drawable/ic_glyph_clear_ios"
        app:tint="?attr/uikitStaticWhite40"/>
    <org.xplatform.swipex.impl.presentation.swipex.cardstack.SwipexCardsRecyclerView
        android:id="@+id/cardStack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_78"
        app:layout_constraintBottom_toTopOf="@+id/editor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Headline.Medium"
        android:textColor="?attr/uikitStaticWhite"
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_16"
        android:minHeight="@dimen/size_64"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivDescription"/>
    <ImageView
        android:id="@+id/ivDescription"
        android:layout_width="@dimen/size_76"
        android:layout_height="@dimen/size_76"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardStack"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Headline.Medium"
        android:textColor="?attr/uikitStaticWhite"
        android:id="@+id/tvDescriptionForEditor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_20"
        android:minHeight="@dimen/size_64"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/ivDescriptionForEditor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivDescriptionForEditor"
        android:layout_width="@dimen/size_76"
        android:layout_height="@dimen/size_76"
        android:layout_marginBottom="@dimen/space_32"
        app:layout_constraintBottom_toTopOf="@+id/editor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_swipe_x_arrow_down"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editor"
        android:background="@drawable/editor_background"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_40"
        android:alpha="0.1"
        android:layout_marginHorizontal="@dimen/space_12"
        app:layout_constraintBottom_toTopOf="@+id/btnNext">
        <org.xplatform.uikit.components.buttons.DsButton
            android:id="@+id/dislikeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:layout_marginStart="@dimen/space_8"
            app:dsButtonIconRes="@drawable/ic_glyph_cancel"
            app:dsButtonStyle="secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DSButton.Large.Secondary.IconCircle"/>
        <org.xplatform.uikit.components.buttons.DsButton
            android:id="@+id/likeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:layout_marginEnd="@dimen/space_8"
            app:dsButtonIconRes="@drawable/ic_glyph_checkmark"
            app:dsButtonStyle="commerce"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/DSButton.Large.Secondary.IconCircle"/>
        <TextView
            android:textSize="@dimen/text_16"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/betSumTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/history_bet_rate"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/betSumValue"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"
            style="@style/TextStyle.Headline.Regular.Secondary"/>
        <TextView
            android:textSize="@dimen/text_16"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/betSumValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="ltr"
            android:layout_marginStart="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/glyphIcon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/betSumTitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_default="wrap"
            style="@style/TextStyle.Headline.Medium.Primary"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:textColor="?attr/uikitPrimary"
            android:id="@+id/glyphIcon"
            android:layout_width="@dimen/size_12"
            android:layout_height="@dimen/size_12"
            app:layout_constraintBottom_toBottomOf="@+id/betSumValue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/betSumValue"
            app:layout_constraintTop_toTopOf="@+id/betSumValue"
            app:layout_constraintWidth_default="wrap"
            app:srcCompat="@drawable/ic_glyph_edit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"
        app:dsButtonLabel="@string/next"
        app:dsButtonSize="large"
        app:dsButtonType="label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
