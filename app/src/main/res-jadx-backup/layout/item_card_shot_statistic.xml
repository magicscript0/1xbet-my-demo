<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/match_info_card_content_height">
    <include
        android:id="@+id/teamOneLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_short_statistic_team_logo"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShortInfo"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_4"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btnExpand"
        app:layout_constraintEnd_toStartOf="@+id/teamTwoLogo"
        app:layout_constraintStart_toEndOf="@+id/teamOneLogo"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/teamTwoLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_short_statistic_team_logo"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.ExpandBtnView
        android:id="@+id/btnExpand"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
