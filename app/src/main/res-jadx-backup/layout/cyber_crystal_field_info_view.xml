<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.34"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.56"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.78"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvFirstRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/crystal_first_round"
        app:layout_constraintEnd_toEndOf="@+id/guideline2"
        app:layout_constraintStart_toStartOf="@+id/guideline1"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvSecondRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/crystal_second_round"
        app:layout_constraintEnd_toEndOf="@+id/guideline3"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/crystal_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline3"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvFirstPlayerResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tvResult"
        app:layout_constraintTop_toBottomOf="@+id/tvResult"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvFirstPlayerSecondRound"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:alpha="0"
        app:layout_constraintEnd_toStartOf="@+id/guideline3"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tvSecondRound"
        app:layout_constraintTop_toBottomOf="@+id/tvSecondRound"/>
    <ImageView
        android:id="@+id/ivSecondRoundClock"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:alpha="0"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvSecondPlayerName"
        app:layout_constraintEnd_toEndOf="@+id/tvSecondRound"
        app:layout_constraintStart_toStartOf="@+id/tvSecondRound"
        app:layout_constraintTop_toTopOf="@+id/tvFirstPlayerName"
        app:srcCompat="@drawable/cybergame_crystal_clock_ic"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvFirstPlayerFirstRound"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:alpha="0"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tvFirstRound"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstRound"/>
    <ImageView
        android:id="@+id/ivFirstRoundClock"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:alpha="0"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvSecondPlayerName"
        app:layout_constraintEnd_toEndOf="@+id/tvFirstRound"
        app:layout_constraintStart_toStartOf="@+id/tvFirstRound"
        app:layout_constraintTop_toTopOf="@+id/tvFirstPlayerName"
        app:srcCompat="@drawable/cybergame_crystal_clock_ic"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvSecondPlayerResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvFirstPlayerResult"
        app:layout_constraintStart_toStartOf="@+id/tvFirstPlayerResult"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstPlayerResult"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvSecondPlayerSecondRound"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvFirstPlayerSecondRound"
        app:layout_constraintStart_toStartOf="@+id/tvFirstPlayerSecondRound"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstPlayerSecondRound"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvSecondPlayerFirstRound"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tvFirstPlayerFirstRound"
        app:layout_constraintStart_toStartOf="@+id/tvFirstPlayerFirstRound"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstPlayerFirstRound"/>
    <ImageView
        android:id="@+id/ivSecondPlayerFirstCrystal"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/ivSecondPlayerSecondCrystal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivSecondPlayerSecondCrystal"/>
    <ImageView
        android:id="@+id/ivSecondPlayerSecondCrystal"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivSecondPlayerThirdCrystal"
        app:layout_constraintStart_toEndOf="@+id/ivSecondPlayerFirstCrystal"
        app:layout_constraintTop_toTopOf="@+id/ivSecondPlayerThirdCrystal"/>
    <ImageView
        android:id="@+id/ivSecondPlayerThirdCrystal"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvSecondPlayerName"
        app:layout_constraintStart_toEndOf="@+id/ivSecondPlayerSecondCrystal"
        app:layout_constraintTop_toTopOf="@+id/tvSecondPlayerName"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvSecondPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline1"
        app:layout_constraintStart_toEndOf="@+id/ivSecondPlayerThirdCrystal"
        app:layout_constraintTop_toTopOf="@+id/tvSecondPlayerFirstRound"/>
    <ImageView
        android:id="@+id/ivFirstPlayerFirstCrystal"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/ivFirstPlayerSecondCrystal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivFirstPlayerSecondCrystal"/>
    <ImageView
        android:id="@+id/ivFirstPlayerSecondCrystal"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivFirstPlayerThirdCrystal"
        app:layout_constraintStart_toEndOf="@+id/ivFirstPlayerFirstCrystal"
        app:layout_constraintTop_toTopOf="@+id/ivFirstPlayerThirdCrystal"/>
    <ImageView
        android:id="@+id/ivFirstPlayerThirdCrystal"
        android:layout_width="@dimen/size_12"
        android:layout_height="@dimen/size_12"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvFirstPlayerName"
        app:layout_constraintStart_toEndOf="@+id/ivFirstPlayerSecondCrystal"
        app:layout_constraintTop_toTopOf="@+id/tvFirstPlayerName"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvFirstPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_12"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/tvSecondPlayerName"
        app:layout_constraintEnd_toStartOf="@+id/guideline1"
        app:layout_constraintStart_toEndOf="@+id/ivFirstPlayerThirdCrystal"
        app:layout_constraintTop_toTopOf="@+id/tvFirstPlayerFirstRound"/>
</merge>
