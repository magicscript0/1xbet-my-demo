<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/match_info_cards_height">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_white_60"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchDescription"
        android:paddingBottom="@dimen/space_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/size_24"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTeamNamesTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tvFirstTeamName,tvSecondTeamName"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTeamNamesBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvFirstTeamName,tvSecondTeamName"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTeamImagesBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="flFirstTeamInfo,flSecondTeamInfo"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTeamImagesTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="top"
        app:constraint_referenced_ids="flFirstTeamInfo,flSecondTeamInfo"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textSize="@dimen/text_22"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvScore"
        android:layout_width="@dimen/game_screen_score_width"
        android:layout_height="@dimen/size_56"
        app:layout_constraintBottom_toBottomOf="@+id/tvFirstTeamName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFirstTeamName"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.MatchTimerView
        android:id="@+id/vMatchTimer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bTeamImagesBottom"/>
    <FrameLayout
        android:id="@+id/flFirstTeamInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bTeamNamesBottom"
        app:layout_constraintEnd_toStartOf="@+id/tvScore"
        app:layout_constraintTop_toBottomOf="@+id/bTeamNamesTop">
        <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/ivFirstTeamImage"
            android:visibility="gone"
            android:layout_width="@dimen/team_logo_image_size"
            android:layout_height="@dimen/team_logo_image_size"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_8"
            android:layout_marginVertical="@dimen/space_4"
            app:cornerRadiusImageView="@dimen/corner_radius_8"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/llOneTeamPairContainerImages"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginVertical="@dimen/space_4">
            <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                android:id="@+id/ivFirstPlayerOneTeamImage"
                android:layout_width="@dimen/size_32"
                android:layout_height="@dimen/size_32"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:cornerRadiusImageView="@dimen/corner_radius_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivPairTeamFirstPlayerOneTeamFavorite"
                android:visibility="gone"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                app:layout_constraintBottom_toBottomOf="@+id/ivFirstPlayerOneTeamImage"
                app:layout_constraintStart_toStartOf="parent"/>
            <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                android:id="@+id/ivSecondPlayerOneTeamImage"
                android:layout_width="@dimen/size_32"
                android:layout_height="@dimen/size_32"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:cornerRadiusImageView="@dimen/corner_radius_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivFirstPlayerOneTeamImage"/>
            <ImageView
                android:id="@+id/ivPairTeamSecondPlayerOneTeamFavorite"
                android:visibility="gone"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                app:layout_constraintBottom_toBottomOf="@+id/ivSecondPlayerOneTeamImage"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/ivFirstTeamFavorite"
            android:visibility="gone"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionLightNew"
            android:textSize="@dimen/text_10"
            android:gravity="center"
            android:layout_gravity="end|bottom"
            android:id="@+id/tvFirstTeamRedCards"
            android:background="@drawable/ic_red_card_16_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_4"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/flSecondTeamInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/bTeamNamesBottom"
        app:layout_constraintStart_toEndOf="@+id/tvScore"
        app:layout_constraintTop_toTopOf="@+id/bTeamNamesTop">
        <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/ivSecondTeamImage"
            android:visibility="gone"
            android:layout_width="@dimen/team_logo_image_size"
            android:layout_height="@dimen/team_logo_image_size"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_8"
            android:layout_marginVertical="@dimen/space_4"
            app:cornerRadiusImageView="@dimen/corner_radius_8"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/llTwoTeamPairContainerImages"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginVertical="@dimen/space_4">
            <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                android:id="@+id/ivFirstPlayerTwoTeamImage"
                android:layout_width="@dimen/size_32"
                android:layout_height="@dimen/size_32"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:cornerRadiusImageView="@dimen/corner_radius_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivPairTeamFirstPlayerTwoTeamFavorite"
                android:visibility="gone"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                app:layout_constraintBottom_toBottomOf="@+id/ivFirstPlayerTwoTeamImage"
                app:layout_constraintEnd_toEndOf="parent"/>
            <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                android:id="@+id/ivSecondPlayerTwoTeamImage"
                android:layout_width="@dimen/size_32"
                android:layout_height="@dimen/size_32"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:cornerRadiusImageView="@dimen/corner_radius_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivFirstPlayerTwoTeamImage"/>
            <ImageView
                android:id="@+id/ivPairTeamSecondPlayerTwoTeamFavorite"
                android:visibility="gone"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                app:layout_constraintBottom_toBottomOf="@+id/ivSecondPlayerTwoTeamImage"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionLightNew"
            android:textSize="@dimen/text_10"
            android:gravity="center"
            android:layout_gravity="start|bottom"
            android:id="@+id/tvSecondTeamRedCards"
            android:background="@drawable/ic_red_card_16_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:layout_marginStart="@dimen/space_4"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/ivSecondTeamFavorite"
            android:visibility="gone"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tvFirstTeamName"
        android:layout_width="0dp"
        android:layout_height="@dimen/team_logo_layout_height"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/size_32"
        android:maxLines="5"
        android:lineSpacingMultiplier="0.8"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="@dimen/space_8"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/bTeamNamesBottom"
        app:layout_constraintEnd_toStartOf="@+id/flFirstTeamInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"
        app:layout_goneMarginTop="@dimen/space_24"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvSecondTeamName"
        android:layout_width="0dp"
        android:layout_height="@dimen/team_logo_layout_height"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/size_32"
        android:maxLines="5"
        android:lineSpacingMultiplier="0.8"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/space_8"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/bTeamNamesBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/flSecondTeamInfo"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"
        app:layout_constraintVertical_bias="0"
        app:layout_goneMarginTop="@dimen/space_24"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white_60"
        android:gravity="center"
        android:id="@+id/tvMatchPeriodInfo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_32"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginRight="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vMatchTimer"
        app:layout_constraintVertical_bias="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
