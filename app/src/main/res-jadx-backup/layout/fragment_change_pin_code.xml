<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showShadow="false"
        app:title="@string/change_pin_code_title"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:background="@drawable/rounded_background_16"
        android:padding="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:constraint_referenced_ids="oldPasswordEdit,newPasswordEdit,repeatNewPasswordEdit"
        app:flow_verticalGap="@dimen/space_8"
        app:flow_verticalStyle="packed"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/oldPasswordEdit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:hint="@string/enter_old_pin_code"
        app:pinCode="true"
        style="@style/Widget.DSTextField.Password"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/newPasswordEdit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:hint="@string/enter_new_pin_code"
        app:pinCode="true"
        style="@style/Widget.DSTextField.Password"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/repeatNewPasswordEdit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:hint="@string/enter_new_pin_code_again"
        app:pinCode="true"
        style="@style/Widget.DSTextField.Password"/>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:id="@+id/bottomBar"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        app:firstButtonStyle="@style/DSButton.Large.Primary"
        app:firstButtonText="@string/apply_action"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
