<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:theme="?attr/uikitTheme"
        android:id="@+id/container"
        android:background="@drawable/two_team_score_background"
        android:paddingLeft="@dimen/space_8"
        android:paddingTop="@dimen/space_16"
        android:paddingRight="@dimen/space_8"
        android:paddingBottom="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/size_182"
        android:minHeight="@dimen/size_124"
        android:layoutDirection="ltr"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingVertical="@dimen/space_16">
        <TextView
            android:textSize="@dimen/text_12"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvGameName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:autoSizeMaxTextSize="@dimen/text_12"
            app:autoSizeMinTextSize="@dimen/text_10"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Caption.Regular.M"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:barrierDirection="bottom"
            app:barrierMargin="@dimen/space_8"
            app:constraint_referenced_ids="tvGameName"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guidelineCenter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.5"/>
        <FrameLayout
            android:id="@+id/teamOneLayout"
            android:layout_width="@dimen/icon_size_48"
            android:layout_height="@dimen/icon_size_56"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_4"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toStartOf="@+id/tvScore"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="@dimen/space_60">
            <org.xplatform.uikit.components.team_logo.DsTeamLogo
                android:layout_gravity="start|center_vertical"
                android:id="@+id/ivTeamOne"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:placeholder="@drawable/ic_glyph_logo_placeholder"
                app:placeholderTint="?attr/uikitStaticWhite60"
                style="@style/Widget.DSSportTeamLogo.Size40"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/llOneTeamPairContainerImages"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <org.xplatform.uikit.components.team_logo.DsTeamLogo
                    android:id="@+id/ivFirstPlayerOneTeamImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    app:placeholder="@drawable/ic_glyph_logo_placeholder"
                    app:placeholderTint="?attr/uikitStaticWhite60"
                    style="@style/Widget.DSSportTeamLogo.Size24.Static"/>
                <org.xplatform.uikit.components.team_logo.DsTeamLogo
                    android:id="@+id/ivSecondPlayerOneTeamImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:placeholder="@drawable/ic_glyph_logo_placeholder"
                    app:placeholderTint="?attr/uikitStaticWhite60"
                    style="@style/Widget.DSSportTeamLogo.Size24.Static"/>
            </LinearLayout>
            <org.xplatform.uikit.components.counter.DsCounter
                android:layout_gravity="end|bottom"
                android:id="@+id/redCardTeamOne"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_6"
                app:counterComponentStyle="red_card"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvTeamOne"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/space_8"
            android:maxLines="3"
            android:layout_marginEnd="@dimen/space_8"
            app:autoSizeMaxTextSize="@dimen/text_14"
            app:autoSizeMinTextSize="@dimen/text_12"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toStartOf="@+id/teamOneLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/TextStyle.Text.Medium"/>
        <TextView
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            app:layout_constraintBottom_toBottomOf="@+id/teamOneLayout"
            app:layout_constraintEnd_toStartOf="@+id/teamTwoLayout"
            app:layout_constraintStart_toEndOf="@+id/teamOneLayout"
            app:layout_constraintTop_toTopOf="@+id/teamOneLayout"
            app:layout_goneMarginBottom="@dimen/space_12"
            style="@style/TextStyle.Title.Bold.M"/>
        <FrameLayout
            android:id="@+id/teamTwoLayout"
            android:layout_width="@dimen/icon_size_48"
            android:layout_height="@dimen/icon_size_56"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_marginStart="@dimen/space_4"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/tvScore"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_goneMarginStart="@dimen/space_60">
            <org.xplatform.uikit.components.team_logo.DsTeamLogo
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivTeamTwo"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:placeholder="@drawable/ic_glyph_logo_placeholder"
                app:placeholderTint="?attr/uikitStaticWhite60"
                style="@style/Widget.DSSportTeamLogo.Size40"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/llTwoTeamPairContainerImages"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <org.xplatform.uikit.components.team_logo.DsTeamLogo
                    android:id="@+id/ivFirstPlayerTwoTeamImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    app:placeholder="@drawable/ic_glyph_logo_placeholder"
                    app:placeholderTint="?attr/uikitStaticWhite60"
                    style="@style/Widget.DSSportTeamLogo.Size24"/>
                <org.xplatform.uikit.components.team_logo.DsTeamLogo
                    android:id="@+id/ivSecondPlayerTwoTeamImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:placeholder="@drawable/ic_glyph_logo_placeholder"
                    app:placeholderTint="?attr/uikitStaticWhite60"
                    style="@style/Widget.DSSportTeamLogo.Size24"/>
            </LinearLayout>
            <org.xplatform.uikit.components.counter.DsCounter
                android:layout_gravity="start|bottom"
                android:id="@+id/redCardTeamTwo"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_6"
                app:counterComponentStyle="red_card"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvTeamTwo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/space_8"
            android:maxWidth="100dp"
            android:maxLines="3"
            android:layout_marginStart="@dimen/space_8"
            app:autoSizeMaxTextSize="@dimen/text_14"
            app:autoSizeMinTextSize="@dimen/text_12"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/teamTwoLayout"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            style="@style/TextStyle.Text.Medium"/>
        <TextView
            android:textSize="@dimen/text_12"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:autoSizeMaxTextSize="@dimen/text_12"
            app:autoSizeMinTextSize="@dimen/text_10"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TextStyle.Caption.Regular.M"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupTwoTeam"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="tvTeamOne, tvTeamTwo, tvScore, teamOneLayout, teamTwoLayout"/>
        <TextView
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvOneTeamTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:maxLines="3"
            android:includeFontPadding="false"
            app:autoSizeMaxTextSize="@dimen/text_20"
            app:autoSizeMinTextSize="@dimen/text_12"
            app:autoSizeStepGranularity="@dimen/text_2"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_goneMarginBottom="@dimen/space_8"
            style="@style/TextStyle.Text.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
