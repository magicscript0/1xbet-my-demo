<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/uikitBackgroundGroup"
    android:paddingLeft="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:layout_width="@dimen/size_180"
    android:layout_height="@dimen/size_50"
    android:paddingHorizontal="@dimen/space_8">
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:ellipsize="marquee"
        android:layout_gravity="center_vertical"
        android:id="@+id/positionTitle"
        android:layout_width="@dimen/size_32"
        android:layout_height="wrap_content"
        android:text="№"
        android:singleLine="true"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvName"
        android:layout_width="@dimen/size_86"
        android:layout_height="wrap_content"
        android:text="@string/name_title"
        android:maxLines="2"
        android:textDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/positionTitle"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
