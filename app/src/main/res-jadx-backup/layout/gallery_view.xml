<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:background="#cc000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.ui_core.viewcomponents.views.SwipeBackLayout
        android:id="@+id/swipeBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/gallery_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
    </org.xplatform.ui_core.viewcomponents.views.SwipeBackLayout>
    <org.xplatform.ui_core.circleindicator.CircleIndicator
        android:id="@+id/gallery_indicator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_12"
        android:layout_marginBottom="@dimen/space_24"
        app:ci_animator="@animator/scale_default"
        app:ci_drawable="@drawable/ic_indicator_horizontal"
        app:ci_height="@dimen/space_2"
        app:ci_width="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/ivClose"
        android:padding="@dimen/space_4"
        android:layout_width="@dimen/size_40"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/space_48"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_glyph_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
