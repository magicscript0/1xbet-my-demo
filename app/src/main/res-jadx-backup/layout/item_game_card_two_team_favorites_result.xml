        android:id="@+id/gameCardMiddle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"/>
    <org.xplatform.uikit_sport.eventcard.info.EventCardInfoFavorites
        android:id="@+id/gameCardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
