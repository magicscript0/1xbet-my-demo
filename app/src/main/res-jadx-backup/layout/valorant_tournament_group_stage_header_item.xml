<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/the_internatioanl_item_header_bg"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/space_8">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvPoints"
        android:layout_width="@dimen/size_36"
        android:layout_height="wrap_content"
        android:text="@string/valorant_points"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvRoundDifferent"
        android:layout_width="@dimen/size_36"
        android:layout_height="wrap_content"
        android:text="@string/valorant_round_different"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvPoints"
        app:layout_constraintEnd_toStartOf="@+id/tvPoints"
        app:layout_constraintTop_toTopOf="@+id/tvPoints"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvLoses"
        android:layout_width="@dimen/size_46"
        android:layout_height="wrap_content"
        android:text="@string/lol_loses"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvRoundDifferent"
        app:layout_constraintEnd_toStartOf="@+id/tvRoundDifferent"
        app:layout_constraintTop_toTopOf="@+id/tvRoundDifferent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvWin"
        android:layout_width="@dimen/size_46"
        android:layout_height="wrap_content"
        android:text="@string/lol_wins"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvLoses"
        app:layout_constraintEnd_toStartOf="@+id/tvLoses"
        app:layout_constraintTop_toTopOf="@+id/tvLoses"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:textSize="@dimen/text_14"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvNumber"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_28"
        android:text="@string/number"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/team"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvNumber"
        app:layout_constraintEnd_toStartOf="@+id/tvWin"
        app:layout_constraintStart_toEndOf="@+id/tvNumber"
        app:layout_constraintTop_toTopOf="@+id/tvNumber"
        style="@style/TextStyle.Text.Regular.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
