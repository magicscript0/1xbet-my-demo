<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/flLabel"
        android:background="@drawable/rounded_content_bg_8"
        android:padding="@dimen/space_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackground"
        android:outlineProvider="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?attr/textAppearanceBody1BoldNew"
            android:textSize="@dimen/text_10"
            android:textColor="@color/static_white"
            android:gravity="center_vertical"
            android:id="@+id/tvLabel"
            android:background="@drawable/rounded_content_bg_8"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_16"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:textDirection="locale"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/containerImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/uikitBackground"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.AppTheme.CardView.New.SquareBottomCorners">
                <org.xplatform.ui_core.viewcomponents.imageview.MeasuredImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    app:heightOfWidth="0.6"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2New"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:layout_marginHorizontal="@dimen/space_8"
                app:autoSizeMaxTextSize="@dimen/text_14"
                app:autoSizeMinTextSize="@dimen/text_10"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@+id/description"
                app:layout_constraintEnd_toStartOf="@+id/favorite"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view"
                app:layout_constraintVertical_chainStyle="spread_inside"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBody1New"
                android:textSize="@dimen/text_12"
                android:ellipsize="end"
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:lines="1"
                android:textAlignment="viewStart"
                android:layout_marginHorizontal="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="@+id/view"
                app:layout_constraintEnd_toStartOf="@+id/favorite"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title"/>
            <View
                android:id="@+id/view"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_24"
                android:layout_marginHorizontal="@dimen/space_8"
                android:layout_marginVertical="@dimen/space_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerImage"/>
            <ImageView
                android:id="@+id/favorite"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_24"
                android:scaleType="centerInside"
                android:elevation="@dimen/space_10"
                android:layout_marginHorizontal="@dimen/space_8"
                android:layout_marginVertical="@dimen/space_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerImage"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
