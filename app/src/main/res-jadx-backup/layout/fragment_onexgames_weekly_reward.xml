<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:background="@color/static_transparent"
        android:layout_width="0dp"
        android:layout_height="@dimen/toolbar_height_size"
        android:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/solidButtonTextColor"
        app:title="@string/promo_weekly_reward_title"
        app:titleTextColor="?attr/solidButtonTextColor"
        style="@style/Widget.AppTheme.Toolbar.New"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/info"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:srcCompat="@drawable/ic_info_cashback"
        app:tint="?attr/solidButtonTextColor"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6New"
        android:textColor="@color/static_white"
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:text="Играй 7 дней подряд\10и получи 3 прокрутки колеса!"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/vpDays"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpDays"
        android:layout_width="match_parent"
        android:layout_height="264dp"
        android:layout_marginTop="@dimen/weekly_reward_margin_top"
        app:layout_constraintBottom_toTopOf="@+id/tvDayOfDay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1New"
        android:textColor="@color/static_white"
        android:id="@+id/tvDayOfDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/weekly_reward_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/daysProgressView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vpDays"/>
    <org.xplatform.games_section.feature.weekly_reward.presentation.custom_veiw.DaysProgressView
        android:id="@+id/daysProgressView"
        android:paddingBottom="35dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDayOfDay"/>
    <org.xplatform.uikit.components.lottie.LottieView
        android:id="@+id/lottieError"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:file_name="@string/lottie_data_error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:textColor="@color/static_white"
        app:text_res="@string/data_retrieval_error"/>
    <FrameLayout
        android:id="@+id/progress_view"
        android:background="@color/static_black_20"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
