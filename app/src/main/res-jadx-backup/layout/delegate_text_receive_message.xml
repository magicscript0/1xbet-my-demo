<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/space_40">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatar"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
        app:srcCompat="@drawable/ic_user_profile"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messageContainer"
        android:background="@drawable/message_inbox_bg"
        android:paddingLeft="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingRight="@dimen/space_12"
        android:paddingBottom="@dimen/space_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:textSize="@dimen/text_10"
            android:textColor="@android:color/white"
            android:id="@+id/txtBotLabel"
            android:background="@drawable/bot_label_bg"
            android:paddingLeft="@dimen/space_4"
            android:paddingTop="@dimen/space_2"
            android:paddingRight="@dimen/space_4"
            android:paddingBottom="@dimen/space_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/consultant_label_bot"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingVertical="@dimen/space_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorPrimary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/txtAuthorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:maxLines="1"
            android:paddingEnd="@dimen/space_28"
            app:layout_constraintBottom_toTopOf="@+id/viewReplySeparator"
            app:layout_constraintEnd_toStartOf="@+id/txtBotLabel"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/viewReplySeparator"
            android:background="?attr/colorPrimary"
            android:layout_width="@dimen/size_2"
            android:layout_height="@dimen/size_32"
            android:layout_marginBottom="@dimen/space_4"
            app:layout_constraintBottom_toTopOf="@+id/txtMessage"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:id="@+id/replyContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_32"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginStart="@dimen/space_4"
            app:layout_constraintBottom_toTopOf="@+id/txtMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/viewReplySeparator"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/replyGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="viewReplySeparator, replyContainer"/>
        <org.xplatform.ui_core.viewcomponents.views.FixedSelectionTextView
            android:textSize="@dimen/text_16"
            android:textColor="?attr/uikitTextPrimary"
            android:textColorLink="?attr/uikitPrimary"
            android:id="@+id/txtMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:textIsSelectable="true"
            android:textDirection="locale"
            app:layout_constraintBottom_toTopOf="@+id/txtRows"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1Medium"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/uikitTextPrimary"
            android:textColorLink="?attr/uikitPrimary"
            android:id="@+id/txtRows"
            android:paddingTop="@dimen/space_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:lineSpacingExtra="@dimen/space_10"
            app:layout_constraintBottom_toTopOf="@+id/buttonGroup"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/buttonGroup"
            android:paddingTop="@dimen/space_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            app:layout_constraintBottom_toTopOf="@+id/txtTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/text_10"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
