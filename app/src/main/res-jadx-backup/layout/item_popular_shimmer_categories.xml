<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/headerShimmer"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_10"
        android:radius="@dimen/radius_full"
        android:layout_marginStart="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginVertical="@dimen/space_10"
        style="@style/Widget.DSShimmer.Primary"/>
    <HorizontalScrollView
        android:orientation="horizontal"
        android:paddingLeft="@dimen/medium_horizontal_margin_dynamic"
        android:paddingRight="@dimen/medium_horizontal_margin_dynamic"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/medium_horizontal_margin_dynamic">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
            <org.xplatform.uikit.components.shimmer.DsShimmerView
                android:layout_width="@dimen/shimmer_size_84"
                android:layout_height="@dimen/shimmer_size_122"
                android:radius="@dimen/corner_radius_12"
                android:layout_marginStart="@dimen/space_8"
                style="@style/Widget.DSShimmer.Primary"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
