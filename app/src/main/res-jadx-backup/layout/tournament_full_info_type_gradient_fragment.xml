<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/clTournament"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/elevation_0">
            <org.xplatform.ui_core.viewcomponents.motion.AppBarMotionLayout
                android:id="@+id/headerContent"
                android:background="?attr/uikitBackgroundContent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_220"
                android:minHeight="?attr/actionBarSize"
                app:layoutDescription="@xml/tournament_full_info_type_gradient_scene"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBackground"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_220"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/vBlackoutTop"
                    android:background="@drawable/background_gradient_tournaments_type_gradient_top"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_80"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/vBlackoutBottom"
                    android:background="@drawable/background_gradient_tournaments_type_gradient_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_108"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <View
                    android:id="@+id/btnBackBackground"
                    android:background="@drawable/circle_preload_view_disable"
                    android:layout_width="@dimen/icon_size_32"
                    android:layout_height="@dimen/icon_size_32"/>
                <androidx.constraintlayout.utils.widget.ImageFilterButton
                    android:id="@+id/btnBack"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:altSrc="@drawable/ic_arrow_back_primary"
                    app:srcCompat="@drawable/ic_arrow_back"/>
                <TextView
                    android:textColor="?attr/uikitSecondary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tvTitleEnd"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_48"
                    android:maxLines="2"
                    android:textDirection="locale"
                    android:textAlignment="center"
                    app:autoSizeMaxTextSize="@dimen/text_20"
                    app:autoSizeMinTextSize="@dimen/text_12"
                    app:autoSizeTextType="uniform"
                    style="@style/TextStyle.Title.Medium.M"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tvTitleStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:textDirection="locale"
                    app:autoSizeMaxTextSize="@dimen/text_24"
                    app:autoSizeMinTextSize="@dimen/text_18"
                    app:autoSizeStepGranularity="@dimen/text_1"
                    app:autoSizeTextType="uniform"
                    style="@style/TextStyle.Title.Bold.L.TextPrimary"/>
                <org.xplatform.uikit.components.chips.ChipGroup
                    android:id="@+id/chipGroup"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:paddingVertical="@dimen/space_4"
                    app:chipSpacingHorizontal="@dimen/space_4"
                    app:chipSpacingVertical="@dimen/space_4"
                    app:layout_constraintBottom_toTopOf="@+id/tvTitleStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <org.xplatform.uikit.components.tag.DsTag
                        android:ellipsize="end"
                        android:id="@+id/tagStatus"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/Widget.DSTag.RectangularL.Filled"/>
                    <org.xplatform.uikit.components.tag.DsTag
                        android:ellipsize="end"
                        android:id="@+id/tagStages"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tournament_with_steps"
                        android:maxLines="1"
                        style="@style/Widget.DSTag.RectangularL.Filled.Secondary"/>
                </org.xplatform.uikit.components.chips.ChipGroup>
            </org.xplatform.ui_core.viewcomponents.motion.AppBarMotionLayout>
            <org.xplatform.uikit.components.tabs.DsTabs
                android:id="@+id/tabLayout"
                android:background="?attr/uikitBackgroundContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:background="?attr/uikitBackground"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:layout_gravity="bottom"
        android:id="@+id/bottomBar"
        android:paddingBottom="@dimen/size_24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottomBarType="oneButton"
        app:firstButtonStyle="@style/DSButton.Large.Commerce"
        app:layout_constraintBottom_toBottomOf="parent"/>
</FrameLayout>
