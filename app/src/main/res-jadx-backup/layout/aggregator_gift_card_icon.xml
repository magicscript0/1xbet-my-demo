<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background"
        android:background="@drawable/rounded_background_16_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="?attr/uikitBackgroundContent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/loadableImage"
        android:layout_width="@dimen/size_52"
        android:layout_height="@dimen/size_52"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/topTitleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:constraint_referenced_ids="amountTv,tagTv"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="@dimen/space_6"
        app:flow_horizontalStyle="packed"
        app:flow_verticalBias="0"
        app:flow_wrapMode="none"
        app:layout_constraintEnd_toStartOf="@+id/closeIv"
        app:layout_constraintStart_toEndOf="@+id/loadableImage"
        app:layout_constraintTop_toTopOf="@+id/loadableImage"/>
    <org.xplatform.uikit.components.tag.DsTag
        android:ellipsize="end"
        android:id="@+id/tagTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@+id/loadableImage"
        style="@style/Widget.DSTag.RectangularL.Filled.Primary"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/timerValue"
        android:background="@drawable/rounded_background_8"
        android:paddingLeft="@dimen/space_6"
        android:paddingTop="@dimen/space_2"
        android:paddingRight="@dimen/space_6"
        android:paddingBottom="@dimen/space_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:backgroundTint="@color/static_dark_orange"
        android:layout_marginHorizontal="@dimen/space_8"
        android:paddingHorizontal="@dimen/space_6"
        android:paddingVertical="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/loadableImage"
        app:layout_constraintStart_toEndOf="@+id/loadableImage"
        app:layout_constraintTop_toBottomOf="@+id/amountTv"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/closeIv"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_margin="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="@+id/background"
        app:layout_constraintTop_toTopOf="@+id/background"
        app:srcCompat="@drawable/ic_close_button_gift_illustration"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/amountTv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/line_height_28"
        android:maxLines="1"
        app:autoSizeMaxTextSize="@dimen/text_24"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeTextType="uniform"
        style="@style/TextStyle.Title.Medium.M.TextPrimary"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/infoContainer"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_32"
        android:layout_marginBottom="@dimen/space_4"
        android:paddingHorizontal="@dimen/space_8"
        app:constraint_referenced_ids="sellSeparatorTimer,providersContainer,sellSeparatorProviders,gamesContainer,sellSeparatorWager,wagerHorizontal,loaderWagerContainer, sellSeparatorFirstLabel,firstLabelContainer,sellSeparatorSecondLabel, secondLabelContainer, buttonContainer"
        app:flow_wrapMode="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amountTv"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/sellSeparatorTimer"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/Widget.DSSeparator.Separator60"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/sellSeparatorWager"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/Widget.DSSeparator.Separator60"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/sellSeparatorProviders"
        android:layout_width="0dp"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/Widget.DSSeparator.Separator60"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/sellSeparatorFirstLabel"
        android:layout_width="0dp"
        style="@style/Widget.DSSeparator.Separator60"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/sellSeparatorSecondLabel"
        android:layout_width="0dp"
        style="@style/Widget.DSSeparator.Separator60"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/wagerHorizontal"
        android:paddingTop="@dimen/size_12"
        android:paddingBottom="@dimen/size_8"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_54"
        app:constraint_referenced_ids="wagerTv,wagerValue"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/loaderWagerContainer"
        android:paddingBottom="@dimen/space_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="loaderWager"
        app:flow_wrapMode="none"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/loaderWager"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/wagerTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintWidth_max="@dimen/size_136"
        style="@style/TextAppearance.Text.Regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_14"
        android:ellipsize="end"
        android:id="@+id/wagerValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/providersContainer"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingVertical="@dimen/space_12"
        app:constraint_referenced_ids="providersTv, providersValue"
        app:flow_horizontalGap="@dimen/space_8"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"
        app:layout_constraintHeight_max="@dimen/size_72"
        app:layout_constraintHeight_min="@dimen/size_56"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/providersTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintWidth_max="@dimen/size_136"
        style="@style/TextAppearance.Text.Regular"/>
    <org.xplatform.uikit_aggregator.aggregatorGiftCard.view.TagContainerView
        android:id="@+id/providersValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="@dimen/size_48"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/gamesContainer"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingVertical="@dimen/space_12"
        app:constraint_referenced_ids="gamesTv,gamesValue"
        app:flow_horizontalGap="@dimen/space_8"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"
        app:layout_constraintHeight_max="@dimen/size_72"
        app:layout_constraintHeight_min="@dimen/size_56"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/gamesTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintWidth_max="@dimen/size_136"
        style="@style/TextAppearance.Text.Regular"/>
    <org.xplatform.uikit_aggregator.aggregatorGiftCard.view.TagContainerView
        android:id="@+id/gamesValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="@dimen/size_48"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/firstLabelContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_56"
        app:constraint_referenced_ids="firstLabelTv,firstLabelValueTv"
        app:flow_horizontalGap="@dimen/space_16"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/firstLabelTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        style="@style/TextAppearance.Text.Regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:id="@+id/firstLabelValueTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/TextAppearance.Headline.Medium"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="horizontal"
        android:id="@+id/secondLabelContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_56"
        app:constraint_referenced_ids="secondLabelTv,secondLabelValueTv"
        app:flow_horizontalGap="@dimen/space_16"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/secondLabelTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        style="@style/TextAppearance.Text.Regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:id="@+id/secondLabelValueTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/TextAppearance.Headline.Medium"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:orientation="vertical"
        android:id="@+id/buttonContainer"
        android:paddingTop="@dimen/size_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="topButton,bottomButton"
        app:flow_verticalGap="@dimen/space_8"
        app:flow_wrapMode="none"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/topButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dsButtonStyle="secondary"
        style="@style/DSButton.Large.Secondary"/>
    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/bottomButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dsButtonStyle="primary"
        style="@style/DSButton.Large.Primary"/>
</merge>
