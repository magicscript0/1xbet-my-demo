<?xml version="1.0" encoding="utf-8"?>
<org.xplatform.themesettings.impl.presentation.timepicker.DisallowInterceptView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/linearLayoutCompat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <NumberPicker
                android:theme="@style/AppTheme.DateNumberPickerDialog"
                android:id="@+id/hours_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showDividers="none"
                android:layout_marginEnd="@dimen/space_24"
                android:selectionDividerHeight="0dp"
                app:layout_constraintEnd_toStartOf="@+id/minutes_picker"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline5New"
                android:textColor="?attr/uikitTextPrimary"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text=":"/>
            <NumberPicker
                android:theme="@style/AppTheme.DateNumberPickerDialog"
                android:id="@+id/minutes_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showDividers="none"
                android:layout_marginStart="@dimen/space_24"
                android:selectionDividerHeight="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <NumberPicker
                android:theme="@style/AppTheme.DateNumberPickerDialog"
                android:id="@+id/time_frame_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_24"
                android:selectionDividerHeight="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:id="@+id/view_selected_value_area"
            android:layout_width="0dp"
            android:layout_height="44dp"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayoutCompat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/linearLayoutCompat"/>
        <View
            android:id="@+id/divider_number_top"
            android:background="?attr/uikitPrimary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/view_selected_value_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/divider_number_bottom"
            android:background="?attr/uikitPrimary"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_selected_value_area"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline5New"
            android:textColor="?attr/uikitPrimary"
            android:gravity="center"
            android:id="@+id/tv_time_divider_24"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text=":"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayoutCompat"
            app:layout_constraintEnd_toEndOf="@+id/linearLayoutCompat"
            app:layout_constraintStart_toStartOf="@+id/linearLayoutCompat"
            app:layout_constraintTop_toTopOf="@+id/linearLayoutCompat"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</org.xplatform.themesettings.impl.presentation.timepicker.DisallowInterceptView>
