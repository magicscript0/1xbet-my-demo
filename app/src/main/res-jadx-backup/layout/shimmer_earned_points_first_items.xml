<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle6"
        android:background="?attr/uikitBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_52"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle7"
        android:background="@drawable/rounded_background_16"
        android:layout_width="@dimen/shimmer_size_94"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="@+id/viewRowTitle6"
        app:layout_constraintStart_toStartOf="@+id/viewRowTitle6"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle8"
        android:background="@drawable/rounded_background_16"
        android:layout_width="0dp"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        app:layout_constraintBottom_toBottomOf="@+id/viewRowTitle6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/viewRowTitle7"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/viewTitleShadow"
        android:background="?attr/uikitSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/viewRowTitle6"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle9"
        android:background="@drawable/rounded_background_16"
        android:layout_width="@dimen/shimmer_size_94"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        android:layout_marginVertical="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/viewRowTitle6"
        app:layout_constraintTop_toBottomOf="@+id/viewTitleShadow"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/viewRowTitle10"
        android:background="@drawable/rounded_background_16"
        android:layout_width="0dp"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_8"
        android:backgroundTint="?attr/uikitBackgroundGroup"
        android:layout_marginVertical="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/viewRowTitle7"
        app:layout_constraintTop_toBottomOf="@+id/viewTitleShadow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
