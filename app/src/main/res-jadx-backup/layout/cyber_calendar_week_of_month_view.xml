<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.cyber.section.impl.calendar.presentation.content.daysofweekview.CyberCalendarDaysOfWeekView
        android:id="@+id/daysOfWeekView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/space_2"
        android:layoutDirection="locale"
        app:event_current_color="?attr/uikitBackgroundContent"
        app:event_default_color="?attr/uikitSecondary"
        app:event_font="@font/roboto_medium"
        app:event_text_size="@dimen/text_12"
        app:event_un_intersection_color="?attr/uikitSecondary"/>
    <org.xplatform.cyber.section.impl.calendar.presentation.content.calendarperiod.CyberCalendarPeriodView
        android:id="@+id/calendarPeriodView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/weekSeparator"
        android:background="?attr/uikitSeparator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1"
        android:alpha="0.6"/>
</LinearLayout>
