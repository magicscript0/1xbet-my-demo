<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/bg_rounded_corners_10dp"
    android:paddingLeft="@dimen/space_8"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_8"
    android:paddingBottom="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_4"
    android:textDirection="ltr"
    android:backgroundTint="?attr/uikitBackgroundContent"
    android:paddingHorizontal="@dimen/space_8"
    android:paddingVertical="@dimen/space_12">
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/space_8"/>
    <ImageView
        android:id="@+id/ivReplace"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        app:srcCompat="@drawable/ic_swap"
        app:tint="?attr/uikitSecondary"/>
</LinearLayout>
