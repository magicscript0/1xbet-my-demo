<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.18"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/multi_choice_bet_view_margin_bottom"/>
    <org.xplatform.spin_and_win.presentation.views.SpinAndWinChoiceView
        android:id="@+id/betView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTop"/>
    <org.xplatform.spin_and_win.presentation.views.SpinAndWinWheelView
        android:id="@+id/wheelView"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_22"
        android:layout_marginBottom="@dimen/space_26"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTop"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/betInfoLayout"
        android:background="@drawable/bet_container_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_20"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@+id/guidelineTop"
        app:layout_constraintWidth_percent="0.35">
        <TextView
            android:textAppearance="?attr/textAppearanceBody2MediumNew"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/txtBet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginRight="@dimen/space_8"
            android:text="@string/baccarat_your_bet"
            android:layout_marginHorizontal="@dimen/space_8"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2MediumNew"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/txtBetSum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginHorizontal="@dimen/space_8"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_8"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/text_14"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btnPlay"
        android:background="@drawable/xgames_button_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/multi_choice_play_button_height"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/play_button"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
