<?xml version="1.0" encoding="utf-8"?>
<org.xplatform.uikit.components.cells.DsSettingsCell xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_16"
    android:paddingEnd="@dimen/space_16"
    android:paddingVertical="@dimen/space_16">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <org.xplatform.uikit.components.text_field.DsTextField
            android:id="@+id/tfSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            app:hint="@string/test_generate_coupon_size"
            style="@style/Widget.DSTextField.Basic"/>
        <org.xplatform.uikit.components.buttons.DsButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:dsButtonLabel="@string/test_generate"
            style="@style/DSButton.Large.Primary"/>
    </LinearLayout>
</org.xplatform.uikit.components.cells.DsSettingsCell>
