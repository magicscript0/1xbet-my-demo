<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <org.xplatform.resident.presentation.views.ResidentDoorLineView
        android:id="@+id/residentDoorLineView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/space_34"
        android:layout_marginRight="@dimen/space_34"
        android:layout_marginHorizontal="@dimen/space_34"
        app:layout_constraintBottom_toBottomOf="@+id/guideDoorsBottom"
        app:layout_constraintDimensionRatio="7:5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1"/>
    <org.xplatform.resident.presentation.views.ResidentSafeLineView
        android:id="@+id/residentSafeLineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideSafesBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <org.xplatform.resident.presentation.views.ResidentSmokeView
        android:id="@+id/residentSmokeView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideSmokeBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideSmokeTop"/>
    <org.xplatform.resident.presentation.views.ResidentPersonView
        android:id="@+id/residentPersonView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/resident_person_bottom_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3:5"
        app:layout_constraintEnd_toEndOf="@+id/guidePersonEnd"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/guidePersonStart"
        app:layout_constraintTop_toBottomOf="@+id/guidePersonTop"/>
    <org.xplatform.resident.presentation.views.ResidentTagView
        android:id="@+id/residentTagView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guideTagBottom"
        app:layout_constraintEnd_toEndOf="@+id/guideTagEnd"
        app:layout_constraintStart_toStartOf="@+id/guideTagStart"
        app:layout_constraintTop_toTopOf="@+id/guideTagTop"/>
    <ImageView
        android:id="@+id/ivExtinguisher"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_resident_fire_extinguisher"
        app:layout_constraintBottom_toBottomOf="@+id/guideExtinguisherBottom"
        app:layout_constraintDimensionRatio="53:80"
        app:layout_constraintEnd_toEndOf="@+id/guideExtinguisherEnd"
        app:layout_constraintStart_toStartOf="@+id/guideExtinguisherStart"
        app:layout_constraintTop_toTopOf="@+id/guideExtinguisherTop"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6Bold"
        android:textSize="@dimen/text_20"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/text_42"
        android:layout_marginRight="@dimen/text_42"
        android:layout_marginBottom="@dimen/space_16"
        android:text="@string/resident_make_bet"
        android:layout_marginHorizontal="@dimen/text_42"
        app:layout_constraintBottom_toTopOf="@+id/residentSafeLineView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/text_14"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/btnTakeMoney"
        android:background="@drawable/xgames_button_background"
        android:paddingLeft="@dimen/space_40"
        android:paddingRight="@dimen/space_40"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_40"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginBottom="@dimen/games_bottom_panel_height"
        android:text="@string/resident_take_money"
        android:layout_marginHorizontal="@dimen/space_16"
        android:paddingHorizontal="@dimen/space_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.AppTheme.SolidButton"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textSize="@dimen/text_18"
        android:textColor="@color/static_white"
        android:id="@+id/tvCurrentBet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_10"
        android:text="@string/resident_current_bet"
        app:layout_constraintBottom_toTopOf="@+id/btnTakeMoney"
        app:layout_constraintEnd_toEndOf="@+id/btnTakeMoney"
        app:layout_constraintStart_toStartOf="@+id/btnTakeMoney"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideExtinguisherEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.34"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideExtinguisherStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.08"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideExtinguisherTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideExtinguisherBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.72"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideSmokeTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideSmokeBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideDoorsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.592"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideSafesBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideStepsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.61"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidePersonStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.54"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidePersonTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.49"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidePersonEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.915"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideTagEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.57"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideTagStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.23"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideTagTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.55"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideTagBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.66"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/vSecondLife"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="residentTagView, ivExtinguisher"/>
</androidx.constraintlayout.widget.ConstraintLayout>
