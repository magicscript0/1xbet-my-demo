<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="@dimen/corner_radius_8"/>
                <gradient
                    android:startColor="@color/static_dark_orange"
                    android:endColor="@color/static_yellow"
                    android:angle="0"/>
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/background">
        <scale android:scaleWidth="100%">
            <shape>
                <solid android:color="@color/static_black"/>
                <corners android:radius="@dimen/corner_radius_8"/>
            </shape>
        </scale>
    </item>
</layer-list>
