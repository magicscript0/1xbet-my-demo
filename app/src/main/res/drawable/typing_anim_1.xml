<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <size
                android:height="18dp"
                android:width="18dp"/>
        </shape>
    </item>
    <item android:gravity="start|center_vertical">
        <shape android:shape="oval">
            <solid android:color="?attr/uikitPrimary"/>
            <size
                android:height="@dimen/size_6"
                android:width="@dimen/size_6"/>
        </shape>
    </item>
    <item
        android:gravity="start|center_vertical"
        android:start="8dp">
        <shape android:shape="oval">
            <solid android:color="?attr/uikitPrimary20"/>
            <size
                android:height="@dimen/size_4"
                android:width="@dimen/size_4"/>
        </shape>
    </item>
    <item
        android:gravity="start|center_vertical"
        android:start="14dp">
        <shape android:shape="oval">
            <solid android:color="?attr/uikitPrimary60"/>
            <size
                android:height="@dimen/size_4"
                android:width="@dimen/size_4"/>
        </shape>
    </item>
</layer-list>
