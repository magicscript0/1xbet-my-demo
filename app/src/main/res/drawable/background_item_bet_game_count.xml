<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/space_32"/>
            <solid android:color="?attr/uikitPrimary"/>
            <stroke
                android:width="1dp"
                android:color="?attr/uikitPrimary"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/space_32"/>
            <solid android:color="@color/static_transparent"/>
            <stroke
                android:width="1dp"
                android:color="?attr/uikitRipple"/>
        </shape>
    </item>
</selector>
