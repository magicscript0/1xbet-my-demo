<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/uikitBackgroundGroup"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:right="4dp">
        <ripple android:color="?attr/uikitRipple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/uikitBackgroundContent"/>
                    <corners
                        android:topLeftRadius="8dp"
                        android:topRightRadius="8dp"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
