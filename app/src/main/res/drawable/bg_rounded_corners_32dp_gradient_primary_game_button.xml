<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/uikitRipple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/static_white"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="?attr/uikitPromoCardGradientStart"
                android:endColor="?attr/uikitPromoCardGradientEnd"
                android:angle="0"
                android:type="linear"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
</ripple>
