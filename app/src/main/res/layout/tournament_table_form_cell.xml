<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?attr/uikitTheme"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/size_50">
    <TextView
        android:gravity="center"
        android:id="@+id/dataTextView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layoutDirection="ltr"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/llStatusRows"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llTopStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/uikitStaticWhite"
                android:gravity="center"
                android:id="@+id/tvFirstGame"
                android:background="@drawable/empty_tournament_table_game_cell_background"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layoutDirection="ltr"
                android:layout_marginEnd="@dimen/space_2"
                style="@style/TextStyle.Caption.Medium.L"/>
            <TextView
                android:textColor="?attr/uikitStaticWhite"
                android:gravity="center"
                android:id="@+id/tvSecondGame"
                android:background="@drawable/empty_tournament_table_game_cell_background"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layoutDirection="ltr"
                style="@style/TextStyle.Caption.Medium.L"/>
            <TextView
                android:textColor="?attr/uikitStaticWhite"
                android:gravity="center"
                android:id="@+id/tvThirdGame"
                android:background="@drawable/empty_tournament_table_game_cell_background"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layoutDirection="ltr"
                android:layout_marginStart="@dimen/space_2"
                style="@style/TextStyle.Caption.Medium.L"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llBottomStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layoutDirection="ltr">
            <TextView
                android:textColor="?attr/uikitStaticWhite"
                android:gravity="center"
                android:id="@+id/tvFourthGame"
                android:background="@drawable/empty_tournament_table_game_cell_background"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layoutDirection="ltr"
                android:layout_marginEnd="@dimen/space_2"
                style="@style/TextStyle.Caption.Medium.L"/>
            <TextView
                android:textColor="?attr/uikitStaticWhite"
                android:gravity="center"
                android:id="@+id/tvFifthGame"
                android:background="@drawable/empty_tournament_table_game_cell_background"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layoutDirection="ltr"
                style="@style/TextStyle.Caption.Medium.L"/>
            <TextView
                android:textColor="?attr/uikitStaticWhite"
                android:gravity="center"
                android:id="@+id/tvSixthGame"
                android:background="@drawable/empty_tournament_table_game_cell_background"
                android:layout_width="@dimen/icon_size_16"
                android:layout_height="@dimen/icon_size_16"
                android:layoutDirection="ltr"
                android:layout_marginStart="@dimen/space_2"
                style="@style/TextStyle.Caption.Medium.L"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
