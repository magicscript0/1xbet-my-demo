<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvWinRate"
        android:layout_width="@dimen/size_38"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <ImageView
        android:id="@+id/ivLinePosition"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:scaleType="centerInside"
        android:layout_marginEnd="@dimen/space_14"
        app:layout_constraintBottom_toBottomOf="@+id/tvWinRate"
        app:layout_constraintEnd_toStartOf="@+id/tvWinRate"
        app:layout_constraintTop_toTopOf="@+id/tvWinRate"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvTier"
        android:layout_width="@dimen/size_28"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/tvWinRate"
        app:layout_constraintEnd_toStartOf="@+id/ivLinePosition"
        app:layout_constraintTop_toTopOf="@+id/tvWinRate"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvPicks"
        android:layout_width="@dimen/size_46"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvTier"
        app:layout_constraintEnd_toStartOf="@+id/tvTier"
        app:layout_constraintTop_toTopOf="@+id/tvTier"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:textSize="@dimen/text_14"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvNumber"
        android:layout_width="@dimen/size_24"
        android:layout_height="wrap_content"
        android:text="@string/number"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivHero"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_28"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/space_8"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvNumber"
        app:layout_constraintStart_toEndOf="@+id/tvNumber"
        app:layout_constraintTop_toTopOf="@+id/tvNumber"
        app:layout_constraintVertical_bias="0.523"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvHeroName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/ivHero"
        app:layout_constraintEnd_toStartOf="@+id/tvPicks"
        app:layout_constraintStart_toEndOf="@+id/ivHero"
        app:layout_constraintTop_toTopOf="@+id/ivHero"
        style="@style/TextStyle.Text.Regular.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
