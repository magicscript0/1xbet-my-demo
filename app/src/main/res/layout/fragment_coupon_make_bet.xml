<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/shadoView"
            android:background="@drawable/makebet_shadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48"/>
        <View
            android:background="@drawable/make_bet_bottom_background"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_32"/>
        <View
            android:background="@drawable/coupon_make_bet_top_gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_32"
            android:layout_marginTop="@dimen/space_32"
            android:alpha="0.08"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clExtendedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clCouponInfo"
                android:background="@drawable/make_bet_enter_bet_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_56"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2New"
                    android:id="@+id/tvEventsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coupon_makebet_events"
                    android:layout_marginStart="@dimen/space_8"
                    app:layout_constraintBottom_toTopOf="@+id/coefficientContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_events_group"
                    android:layout_marginEnd="@dimen/space_8"
                    app:layout_constraintBottom_toBottomOf="@+id/tvEventCount"
                    app:layout_constraintEnd_toStartOf="@+id/tvEventCount"
                    app:layout_constraintTop_toTopOf="@+id/tvEventCount"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvEventCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    app:layout_constraintBottom_toBottomOf="@+id/tvEventsTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvEventsTitle"/>
                <androidx.constraintlayout.motion.widget.MotionLayout
                    android:id="@+id/coefficientContainer"
                    android:layout_width="@dimen/match_constraints"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    app:layoutDescription="@xml/scene_makebet_coef_change"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/tvEventCount"
                    app:layout_constraintStart_toStartOf="@+id/tvEventsTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvEventsTitle">
                    <TextView
                        android:textAppearance="?attr/textAppearanceBody2New"
                        android:id="@+id/tvCoefficientTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coupon_makebet_coef"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
                        android:id="@+id/tvCoefPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/tvCoefficientTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvCoefficientTitle"/>
                    <ImageView
                        android:id="@+id/ivCoefChangePrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:layout_marginEnd="@dimen/space_2"
                        app:layout_constraintBottom_toBottomOf="@+id/tvCoefPrimary"
                        app:layout_constraintEnd_toStartOf="@+id/tvCoefPrimary"
                        app:layout_constraintTop_toTopOf="@+id/tvCoefPrimary"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
                        android:id="@+id/tvCoefSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:layout_marginEnd="@dimen/space_2"
                        app:layout_constraintBottom_toBottomOf="@+id/tvCoefficientTitle"
                        app:layout_constraintEnd_toStartOf="@+id/ivCoefChangePrimary"
                        app:layout_constraintTop_toTopOf="@+id/tvCoefficientTitle"/>
                    <ImageView
                        android:id="@+id/ivCoefChangeSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        app:layout_constraintBottom_toBottomOf="@+id/tvCoefSecondary"
                        app:layout_constraintEnd_toStartOf="@+id/tvCoefSecondary"
                        app:layout_constraintTop_toTopOf="@+id/tvCoefSecondary"/>
                </androidx.constraintlayout.motion.widget.MotionLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupBetType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvBetTypeTitle, tvBetType"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:id="@+id/tvBetTypeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/coupon_make_bet_type"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/space_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clCouponInfo"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumHighlightNew"
                android:gravity="center"
                android:id="@+id/tvBetType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system"
                android:drawablePadding="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                app:drawableEndCompat="@drawable/ic_arrow_forward_24_new"
                app:layout_constraintBottom_toBottomOf="@+id/tvBetTypeTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvBetTypeTitle"/>
            <View
                android:id="@+id/viewSettings"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/tvCoefChangeDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCoefChangeTitle"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvCoefChangeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="@string/bet_coef_change_title"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toStartOf="@+id/tvSettings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBetTypeTitle"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:id="@+id/tvCoefChangeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/space_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCoefChangeTitle"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumHighlightNew"
                android:gravity="center"
                android:id="@+id/tvSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:drawablePadding="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                app:drawableEndCompat="@drawable/ic_arrow_forward_24_new"
                app:layout_constraintBottom_toBottomOf="@+id/tvCoefChangeDesc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCoefChangeTitle"/>
            <org.xplatform.uikit.components.segmented_control.DsSegmentedGroup
                android:theme="?attr/uikitTheme"
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:layout_constraintTop_toBottomOf="@+id/tvCoefChangeDesc"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clCollapsedContainer"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:alpha="0">
            <ImageView
                android:id="@+id/ivCollapsedEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_events_group"
                android:layout_marginEnd="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="@+id/tvCollapsedEventCount"
                app:layout_constraintEnd_toStartOf="@+id/tvCollapsedEventCount"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/tvCollapsedEventsTitle"
                app:layout_constraintTop_toTopOf="@+id/tvCollapsedEventCount"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBody2New"
                android:id="@+id/tvCollapsedEventsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/coupon_makebet_events"
                android:layout_marginEnd="@dimen/space_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvCollapsedCoefficientTitle"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCollapsedEventCount"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
                android:textSize="@dimen/text_18"
                android:id="@+id/tvCollapsedEventCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/tvCollapsedEventsTitle"
                app:layout_constraintEnd_toEndOf="@+id/tvCollapsedEventsTitle"
                app:layout_constraintStart_toEndOf="@+id/ivCollapsedEvents"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBody2New"
                android:id="@+id/tvCollapsedCoefficientTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coupon_makebet_coef"
                app:layout_constraintBottom_toBottomOf="@+id/tvCollapsedEventsTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCollapsedEventsTitle"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
                android:textSize="@dimen/text_18"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tvCollapsedCoeff"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/match_constraints"
                android:layout_marginLeft="@dimen/space_4"
                android:layout_marginRight="@dimen/space_4"
                android:maxLines="1"
                android:layout_marginHorizontal="@dimen/space_4"
                app:autoSizeMaxTextSize="@dimen/text_18"
                app:autoSizeMinTextSize="@dimen/text_12"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="@+id/tvCollapsedEventCount"
                app:layout_constraintEnd_toEndOf="@+id/tvCollapsedCoefficientTitle"
                app:layout_constraintStart_toStartOf="@+id/tvCollapsedCoefficientTitle"
                app:layout_constraintTop_toTopOf="@+id/tvCollapsedEventCount"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCollapsedMakeBet"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_40"
                android:text="@string/coupon_make_bet_make"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="@+id/tvCollapsedEventsTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCollapsedEventCount"
                style="@style/Widget.AppTheme.SolidButton.New.CallToAction"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/divider"
            android:background="@drawable/bg_bottom_sheet_top_view"
            android:layout_width="@dimen/size_30"
            android:layout_height="@dimen/divider_3"
            android:layout_marginTop="@dimen/space_40"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
