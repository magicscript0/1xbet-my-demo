<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/shimmer_size_186">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/title"
        android:layout_width="@dimen/shimmer_size_128"
        android:layout_height="@dimen/shimmer_size_20"
        android:layout_marginTop="@dimen/space_18"
        android:radius="@dimen/radius_16"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit_sport.express_card.ExpressCardShimmer
        android:id="@+id/expressStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_max="@dimen/shimmer_size_400"
        app:layout_constraintWidth_percent="0.9"/>
    <org.xplatform.uikit_sport.express_card.ExpressCardShimmer
        android:id="@+id/expressEnd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12"
        app:layout_constraintBottom_toBottomOf="@+id/expressStart"
        app:layout_constraintStart_toEndOf="@+id/expressStart"
        app:layout_constraintTop_toTopOf="@+id/expressStart"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_max="@dimen/shimmer_size_400"
        app:layout_constraintWidth_percent="0.9"/>
</androidx.constraintlayout.widget.ConstraintLayout>
