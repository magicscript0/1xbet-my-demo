<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.header.HeaderLarge
        android:theme="?attr/uikitTheme"
        android:id="@+id/header"
        android:paddingLeft="@dimen/extra_large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:paddingHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        app:buttonText="@string/filter_all"
        app:title="@string/categories"
        style="@style/Widget.Header"/>
    <org.xplatform.uikit.components.header.HeaderLargeShimmer
        android:theme="?attr/uikitTheme"
        android:id="@+id/headerShimmer"
        android:paddingLeft="@dimen/extra_large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/extra_large_horizontal_margin_dynamic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        style="@style/Widget.Header"/>
    <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.AggregatorGameCardCollection
        android:id="@+id/rvContent"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_0"
        android:layout_marginBottom="@dimen/space_0"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        android:layout_marginVertical="@dimen/space_0"
        style="@style/Widget.AggregatorGameCardCollection.BackgroundL.Horizontal"/>
</LinearLayout>
