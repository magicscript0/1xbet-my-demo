<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackgroundContent"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_8"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_8">
    <TextView
        android:textSize="@dimen/text_14"
        android:textColor="?attr/uikitSecondary"
        android:gravity="center"
        android:id="@+id/titleTv"
        android:background="@drawable/rounded_background_8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_24"
        android:text="@string/session_timer_title"
        android:fontFamily="@font/roboto_regular"
        android:layout_marginEnd="@dimen/space_4"
        android:backgroundTint="?attr/uikitBackground"/>
</FrameLayout>
