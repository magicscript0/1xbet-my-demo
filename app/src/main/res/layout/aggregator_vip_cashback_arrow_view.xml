<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivCurrentLevel"
        android:background="@drawable/circle_background"
        android:padding="@dimen/space_10"
        android:layout_width="@dimen/size_56"
        android:layout_height="@dimen/size_56"
        android:importantForAccessibility="no"
        android:backgroundTint="?attr/uikitBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivNextLevel"
        android:padding="@dimen/space_10"
        android:layout_width="@dimen/size_56"
        android:layout_height="@dimen/size_56"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/statusProgress"
        android:background="@drawable/circle_background"
        android:layout_width="@dimen/size_56"
        android:layout_height="@dimen/size_56"
        android:backgroundTint="?attr/uikitSecondary10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0sp"
        android:lineSpacingMultiplier="0"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        android:letterSpacing="0"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/ivArrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ivCurrentLevel"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Caption.Medium.L.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0sp"
        android:lineSpacingMultiplier="0"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        android:letterSpacing="0"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/ivArrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ivCurrentLevel"
        app:layout_constraintTop_toBottomOf="@+id/tvCaption"
        style="@style/TextStyle.Text.Medium.TextPrimary"/>
    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_glyph_large_arrow_right"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constraintEnd_toStartOf="@+id/ivNextLevel"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.uikit.components.tag.DsTag
        android:ellipsize="end"
        android:id="@+id/tagCashback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tagCoef"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivCurrentLevel"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_max="wrap"
        style="@style/Widget.DSTag.RectangularS.Green"/>
    <org.xplatform.uikit.components.tag.DsTag
        android:ellipsize="end"
        android:id="@+id/tagCoef"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivNextLevel"
        app:layout_constraintStart_toEndOf="@+id/tagCashback"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_max="@dimen/size_64"
        style="@style/Widget.DSTag.RectangularS.Yellow"/>
</merge>
