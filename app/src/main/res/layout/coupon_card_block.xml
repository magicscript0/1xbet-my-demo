<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:paddingTop="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="?attr/uikitBackgroundGroup">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvBlockName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:lines="1"
        android:layout_marginHorizontal="@dimen/space_12"
        app:layout_constraintEnd_toStartOf="@+id/ivBlockBet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Medium.Secondary"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupBlockBet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="ivBlockBet, tvBlockBet, viewBlockBetClickableArea"/>
    <ImageView
        android:id="@+id/ivBlockBet"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/tvBlockBet"
        app:layout_constraintEnd_toStartOf="@+id/tvBlockBet"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="@+id/tvBlockBet"
        app:srcCompat="@drawable/glyph_plus_rounded_square"
        app:tint="?attr/uikitPrimary"/>
    <TextView
        android:textColor="?attr/uikitPrimary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/tvBlockBet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_amount"
        android:lines="1"
        android:textDirection="ltr"
        android:layout_marginStart="@dimen/space_20"
        android:layout_marginEnd="@dimen/space_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvBlockName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/tvBlockName"
        style="@style/TextStyle.Text.Medium"/>
    <View
        android:id="@+id/viewBlockBetClickableArea"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_34"
        app:layout_constraintBottom_toBottomOf="@+id/tvBlockBet"
        app:layout_constraintEnd_toEndOf="@+id/tvBlockBet"
        app:layout_constraintStart_toStartOf="@+id/ivBlockBet"
        app:layout_constraintTop_toTopOf="@+id/tvBlockBet"/>
    <TextView
        android:textSize="@dimen/text_12"
        android:textColor="?attr/uikitStaticRed"
        android:ellipsize="end"
        android:id="@+id/tvBlockError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_12"
        android:maxLines="3"
        android:layout_marginHorizontal="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBlockName"
        style="@style/TextStyle.Text.Regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCoupon"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBlockError"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerBlockBet"
        android:visibility="gone"
        android:layout_width="@dimen/size_100"
        android:layout_height="@dimen/size_18"
        android:radius="@dimen/radius_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
