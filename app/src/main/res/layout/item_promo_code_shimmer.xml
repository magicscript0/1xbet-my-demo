<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/round_background_16"
    android:paddingLeft="@dimen/space_12"
    android:paddingTop="@dimen/space_8"
    android:paddingRight="@dimen/space_12"
    android:paddingBottom="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_12"
    android:layout_marginTop="@dimen/space_4"
    android:layout_marginRight="@dimen/space_12"
    android:layout_marginBottom="@dimen/space_4"
    android:backgroundTint="?attr/uikitBackgroundContent"
    android:layout_marginHorizontal="@dimen/space_12"
    android:layout_marginVertical="@dimen/space_4"
    android:paddingHorizontal="@dimen/space_12">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/view1"
        android:layout_width="@dimen/shimmer_size_32"
        android:layout_height="@dimen/shimmer_size_32"
        android:radius="@dimen/radius_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/view2"
        android:layout_width="@dimen/shimmer_size_152"
        android:layout_height="@dimen/shimmer_size_16"
        android:radius="@dimen/radius_16"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/view1"
        app:layout_constraintStart_toEndOf="@+id/view1"
        app:layout_constraintTop_toTopOf="@+id/view1"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/view3"
        android:layout_width="@dimen/shimmer_size_144"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginTop="@dimen/space_16"
        android:radius="@dimen/radius_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/view4"
        android:layout_width="@dimen/shimmer_size_122"
        android:layout_height="@dimen/shimmer_size_16"
        android:layout_marginTop="@dimen/space_10"
        android:radius="@dimen/radius_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3"
        style="@style/Widget.DSShimmer.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
