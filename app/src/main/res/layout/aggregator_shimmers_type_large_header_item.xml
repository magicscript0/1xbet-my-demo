<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/llShimmerParent"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmerHeader"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginBottom="@dimen/size_10"
        android:radius="@dimen/radius_16"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginVertical="@dimen/size_10"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/svShimmerBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_8"
        android:radius="@dimen/radius_16"
        style="@style/Widget.DSShimmer.Primary"/>
</LinearLayout>
