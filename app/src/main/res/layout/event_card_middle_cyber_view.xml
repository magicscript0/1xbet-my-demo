<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:paddingHorizontal="@dimen/space_8">
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/firstTeamLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/firstBarrier"
        app:layout_constraintStart_toEndOf="@+id/firstTeamName"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSSportTeamLogo.Size32"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/firstTeamName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="3"
        android:lineSpacingMultiplier="0.7"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/firstTeamLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Medium.Shrink.TextPrimary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/firstBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="firstVictoryIndicator, score"/>
    <org.xplatform.uikit_sport.victoryindiacator.SportVictoryIndicator
        android:id="@+id/firstVictoryIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintEnd_toStartOf="@+id/score"
        app:layout_constraintTop_toTopOf="@+id/score"
        style="@style/Widget.SportVictoryIndicator.Left.Theme"/>
    <org.xplatform.uikit_sport.score.SportScore
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.Score.Small"/>
    <org.xplatform.uikit_sport.victoryindiacator.SportVictoryIndicator
        android:id="@+id/secondVictoryIndicator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/score"
        app:layout_constraintStart_toEndOf="@+id/score"
        app:layout_constraintTop_toTopOf="@+id/score"
        style="@style/Widget.SportVictoryIndicator.Right.Theme"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/secondBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="secondVictoryIndicator, score"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/secondTeamName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="3"
        android:lineSpacingMultiplier="0.7"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondTeamLogo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Medium.Shrink.TextPrimary"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/secondTeamLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/secondTeamName"
        app:layout_constraintStart_toEndOf="@+id/secondBarrier"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSSportTeamLogo.Size32"/>
</merge>
