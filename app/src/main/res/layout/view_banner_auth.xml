<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_gradient"
    android:paddingLeft="@dimen/space_8"
    android:paddingTop="@dimen/space_36"
    android:paddingRight="@dimen/space_8"
    android:paddingBottom="@dimen/space_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/elevation_4"
    android:paddingHorizontal="@dimen/space_8">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootContainer"
        android:background="@drawable/bg_rounded_corners_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_4"
        android:backgroundTint="?attr/uikitBackgroundContent">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1MediumNew"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginRight="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_16"
            android:text="@string/banner_auth_to_participate"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginVertical="@dimen/space_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btnCloseAuthConfirmDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_dialog_icon"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAuth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/make_login"
            android:layout_marginHorizontal="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/Widget.AppTheme.SolidButton.New.CallToAction"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
