<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:outlineProvider="bounds">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_8"
        android:layout_marginVertical="@dimen/space_4"
        app:cardBackgroundColor="?attr/uikitBackgroundContent"
        app:cardCornerRadius="@dimen/corner_radius_8">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/elevation_4">
            <ImageView
                android:id="@+id/referralIcon"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:layout_margin="@dimen/space_8"
                android:alpha="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_user_profile"
                app:tint="?attr/uikitSecondary"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textSize="@dimen/text_12"
                android:id="@+id/referralId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginHorizontal="@dimen/space_16"
                app:layout_constraintBottom_toBottomOf="@+id/referralIcon"
                app:layout_constraintStart_toEndOf="@+id/referralIcon"
                app:layout_constraintTop_toTopOf="@+id/referralIcon"/>
            <ImageView
                android:id="@+id/buttonDelete"
                android:background="@null"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:layout_margin="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="@+id/referralIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/referralIcon"
                app:srcCompat="@drawable/ic_delete_referral"
                app:tint="?attr/uikitSecondary"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="start"
                android:orientation="vertical"
                android:id="@+id/titlesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/referralIcon">
                <TextView
                    android:textAppearance="?attr/textAppearanceBody1New"
                    android:textSize="@dimen/text_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/registration_date"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody1New"
                    android:textSize="@dimen/text_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/network_users_level"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody1New"
                    android:textSize="@dimen/text_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/network_count_user"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody1New"
                    android:textSize="@dimen/text_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/profit"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="end"
                android:orientation="vertical"
                android:id="@+id/valuesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/referralIcon">
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/registrationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/networkLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/networkCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                    android:textSize="@dimen/text_12"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/profit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
