<?xml version="1.0" encoding="utf-8"?>
<org.xplatform.uikit_sport.sport_cell.DsSportCell xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    app:sportCellBackgroundTint="?attr/uikitBackgroundGroup"
    app:sportCellRoundedTop="true"
    app:sportCellSeparatorAvailable="false"
    style="@style/Widget.SportCell">
    <org.xplatform.uikit_sport.sport_cell.left.SportCellLeftView
        android:id="@+id/cellLeftIcon"
        app:sportCellLeftIconTint="?attr/uikitSecondary"
        style="@style/Widget.SportCell.SportCellLeft.Icon"/>
    <org.xplatform.uikit_sport.sport_cell.middle.SportCellMiddleView
        android:id="@+id/cellMiddleTitle"
        style="@style/Widget.SportCell.SportCellMiddle.Static.M"/>
    <org.xplatform.uikit_sport.sport_cell.right.SportCellRightView
        android:id="@+id/cellRightAccordion"
        app:sportCellRightAccordionStyle="primary"
        app:sportCellRightStyleType="accordion"
        style="@style/Widget.SportCell.SportCellRight"/>
</org.xplatform.uikit_sport.sport_cell.DsSportCell>
