<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:background="?attr/uikitBackground"
        android:paddingBottom="@dimen/space_24"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.cyber.game.core.betting.presentation.related.container.RelatedContainerView
        android:id="@+id/relatedContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/collapsingTabTitle"
        android:background="?attr/uikitBackgroundContent"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12"
        android:visibility="gone"
        android:layout_width="@dimen/size_132"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:paddingEnd="@dimen/space_8"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody2New"
        android:gravity="center"
        android:id="@+id/tvAllMarketsHidden"
        android:paddingLeft="@dimen/space_32"
        android:paddingRight="@dimen/space_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_bets_for_selected_event"
        android:paddingHorizontal="@dimen/space_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
