<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:id="@+id/authPickerDialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetTitle
        android:id="@+id/tvPikerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/titleSearchSpacing"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_16"/>
    <org.xplatform.uikit.components.search_field.DsSearchField
        android:id="@+id/sfPickerSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llOfferEnterPhoneCode"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:paddingHorizontal="@dimen/space_16">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivOfferEnterPhoneCode"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:src="@drawable/ic_glyph_circle_keyboard"
            app:tint="?attr/uikitSecondary"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1New"
            android:id="@+id/tvOfferEnterPhoneCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_code_manually"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llEnterPhoneCode"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:paddingHorizontal="@dimen/space_16">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivEnterPhoneCode"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:src="@drawable/ic_glyph_circle_keyboard"
            app:tint="?attr/uikitSecondary"/>
        <org.xplatform.uikit.components.text_field.DsTextField
            android:id="@+id/tfEnterPhoneCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="phone"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_16"
            app:hint="@string/code"
            app:singleLine="true"/>
        <org.xplatform.uikit.components.buttons.DsButton
            android:layout_gravity="center_vertical"
            android:id="@+id/butAddPhoneCode"
            android:paddingLeft="@dimen/space_12"
            android:paddingRight="@dimen/space_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_12"
            app:dsButtonLabel="@string/add"
            style="@style/DSButton.Large.Tertiary"/>
    </LinearLayout>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/vPickerSeparator"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_8"
        style="@style/Widget.DSSeparator.Separator60"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/rvPicker"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1New"
            android:id="@+id/tvPickerEmptyText"
            android:padding="@dimen/space_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_74"
            android:layout_marginRight="@dimen/space_16"
            android:text="@string/nothing_found"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/space_16"/>
    </RelativeLayout>
</LinearLayout>
