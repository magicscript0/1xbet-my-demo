<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:id="@+id/constraintLayout"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/consultant_chat_menu"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/uikitSecondary"
        style="@style/Widget.AppTheme.Toolbar.New"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textSize="@dimen/text_20"
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/txtTitle"
        android:paddingLeft="@dimen/space_2"
        android:paddingRight="@dimen/space_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_56"
        android:layout_marginRight="@dimen/space_56"
        android:text="@string/support"
        android:maxLines="1"
        android:elevation="@dimen/elevation_4"
        android:layout_marginHorizontal="@dimen/space_56"
        android:paddingHorizontal="@dimen/space_2"
        app:layout_constraintBottom_toTopOf="@+id/txtUserAction"
        app:layout_constraintEnd_toEndOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="@+id/toolbar"
        app:layout_constraintWidth_default="wrap"/>
    <ImageView
        android:id="@+id/imgTyping"
        android:visibility="gone"
        android:layout_width="@dimen/size_20"
        android:layout_height="@dimen/size_20"
        android:elevation="@dimen/elevation_4"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toStartOf="@+id/txtUserAction"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/toolbar"
        app:layout_constraintTop_toBottomOf="@+id/txtTitle"
        app:layout_constraintWidth_default="wrap"
        app:srcCompat="@drawable/typing_animation"/>
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/uikitPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/txtUserAction"
        android:paddingLeft="@dimen/space_6"
        android:paddingRight="@dimen/space_6"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/support_chat_action_typing"
        android:maxLines="1"
        android:elevation="@dimen/elevation_4"
        android:paddingHorizontal="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="@+id/toolbar"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/imgTyping"
        app:layout_constraintTop_toBottomOf="@+id/txtTitle"
        app:layout_constraintWidth_default="wrap"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textSize="@dimen/text_16"
        android:textColor="?attr/colorPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/txtInvokeOperator"
        android:background="?attr/uikitBackgroundContent"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/size_1"
        android:text="@string/call_consultant"
        android:maxLines="1"
        android:elevation="@dimen/elevation_4"
        android:paddingHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listMessages"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/sendMessageMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtInvokeOperator"
        app:stackFromEnd="true"/>
    <org.xplatform.ui_core.viewcomponents.layouts.frame.ProgressBarWithSendClock
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="@dimen/size_46"
        android:layout_height="@dimen/size_46"
        app:isAnimation="true"
        app:layout_constraintBottom_toTopOf="@+id/sendMessageMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <org.xplatform.uikit.components.lottie.LottieView
        android:id="@+id/lottieEmptyView"
        android:background="?attr/uikitBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0"
        app:file_name="@string/lottie_data_error"
        app:layout_constraintBottom_toTopOf="@+id/sendMessageMenu"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:textColor="?attr/uikitSecondary"
        app:text_res="@string/data_retrieval_error"/>
    <ImageView
        android:id="@+id/btnScrollToBottom"
        android:visibility="gone"
        android:layout_width="@dimen/size_40"
        android:layout_height="@dimen/size_40"
        android:layout_marginBottom="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/sendMessageMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_btn_scroll_to_bottom"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1New"
        android:textSize="@dimen/text_10"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/txtUnreadCount"
        android:background="@drawable/unread_msg_count_bg"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_30"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/btnScrollToBottom"
        app:layout_constraintEnd_toEndOf="@+id/btnScrollToBottom"
        app:layout_constraintStart_toStartOf="@+id/btnScrollToBottom"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sendMessageMenu"
        android:background="?attr/uikitBackgroundContent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="?attr/uikitSeparator"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_1"
            android:alpha="0.5"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/imgAttachFile"
            android:padding="@dimen/space_8"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            app:layout_constraintBottom_toBottomOf="@+id/layoutEditMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_attach"
            app:tint="?attr/uikitSecondary"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutEditMessage"
            android:background="?attr/uikitBackgroundGroup"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_12"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/space_10"
            android:layout_marginVertical="@dimen/space_10"
            android:paddingVertical="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imgSendButton"
            app:layout_constraintStart_toEndOf="@+id/imgAttachFile"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/layoutAttachedFile"
                layout="@layout/layout_attached_file"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listAttachedImages"
                android:paddingLeft="@dimen/space_12"
                android:paddingRight="@dimen/space_12"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:paddingHorizontal="@dimen/space_12"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <View
                android:id="@+id/attachFileSeparator"
                android:background="?attr/uikitSeparator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1"
                android:layout_marginLeft="@dimen/space_12"
                android:layout_marginRight="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_12"
                android:layout_marginHorizontal="@dimen/space_12"/>
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="@dimen/text_16"
                android:textColor="?attr/uikitTextPrimary"
                android:textColorHint="?attr/uikitSecondary"
                android:id="@+id/editTextMessage"
                android:background="@null"
                android:paddingLeft="@dimen/space_12"
                android:paddingRight="@dimen/space_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/consultant_message"
                android:maxLines="5"
                android:minLines="1"
                android:maxLength="@integer/consultant_max_message_chars_length"
                android:paddingHorizontal="@dimen/space_12"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imgSendButton"
            android:padding="@dimen/space_4"
            android:layout_width="@dimen/size_40"
            android:layout_height="@dimen/size_40"
            app:layout_constraintBottom_toBottomOf="@+id/layoutEditMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_send_icon"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressTimer"
            android:padding="@dimen/size_1"
            android:layout_width="@dimen/match_constraints"
            android:layout_height="@dimen/match_constraints"
            android:progress="0"
            android:indeterminate="false"
            app:indicatorColor="?attr/uikitPrimary"
            app:indicatorDirectionCircular="clockwise"
            app:layout_constraintBottom_toBottomOf="@+id/imgSendButton"
            app:layout_constraintEnd_toEndOf="@+id/imgSendButton"
            app:layout_constraintStart_toStartOf="@+id/imgSendButton"
            app:layout_constraintTop_toTopOf="@+id/imgSendButton"
            app:trackColor="?attr/uikitStaticTransparent"
            app:trackCornerRadius="@dimen/corner_radius_8"
            app:trackThickness="@dimen/size_4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/criticalErrorLayout"
        android:background="?attr/uikitBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewCriticalError"
            android:layout_width="@dimen/size_100"
            android:layout_height="@dimen/size_100"
            app:layout_constraintBottom_toTopOf="@+id/textCriticalTitleDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/textCriticalTitleDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintBottom_toTopOf="@+id/textCriticalDescription"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageViewCriticalError"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TextStyle.Title.Medium.S.TextPrimary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/textCriticalDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textCriticalTitleDescription"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TextStyle.Headline.Regular.Secondary"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOthersContacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:text="@string/open_contact"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Widget.AppTheme.SolidButton.New"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/noMessagesLayout"
        android:background="?attr/uikitBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        app:layout_constraintBottom_toTopOf="@+id/sendMessageMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewPlaceholder"
            android:layout_width="@dimen/size_100"
            android:layout_height="@dimen/size_100"
            app:layout_constraintBottom_toTopOf="@+id/textPlaceholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
            android:textSize="@dimen/text_16"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/textPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageViewPlaceholder"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
