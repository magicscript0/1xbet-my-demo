<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/view1Container"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_32"
        android:layout_marginRight="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        android:paddingHorizontal="@dimen/space_8"
        app:constraint_referenced_ids="view1"
        app:flow_horizontalBias="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:layout_gravity="start"
        android:id="@+id/view1"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_20"
        android:radius="@dimen/radius_10"
        style="@style/Widget.DSShimmer.Primary"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/view2Container"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/medium_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_20"
        android:layout_marginRight="@dimen/medium_horizontal_margin_dynamic"
        android:layout_marginBottom="@dimen/space_10"
        android:layout_marginStart="@dimen/medium_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/medium_horizontal_margin_dynamic"
        android:paddingHorizontal="@dimen/space_16"
        app:constraint_referenced_ids="view2"
        app:flow_horizontalBias="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1Container"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/view2"
        android:layout_width="@dimen/size_96"
        android:layout_height="@dimen/size_12"
        android:radius="@dimen/radius_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1"
        style="@style/Widget.DSShimmer.Primary"/>
    <include
        android:id="@+id/shimmerBlock1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2"
        layout="@layout/item_shimmer_balance_management_transactions_block"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/view3Container"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/medium_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_20"
        android:layout_marginRight="@dimen/medium_horizontal_margin_dynamic"
        android:layout_marginBottom="@dimen/space_10"
        android:layout_marginStart="@dimen/medium_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/medium_horizontal_margin_dynamic"
        android:paddingHorizontal="@dimen/space_16"
        app:constraint_referenced_ids="view3"
        app:flow_horizontalBias="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerBlock1"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/view3"
        android:layout_width="@dimen/size_96"
        android:layout_height="@dimen/size_12"
        android:radius="@dimen/radius_10"
        style="@style/Widget.DSShimmer.Primary"/>
    <include
        android:id="@+id/shimmerBlock2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3"
        layout="@layout/item_shimmer_balance_management_transactions_block"/>
</androidx.constraintlayout.widget.ConstraintLayout>
