<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_layout"
    android:background="@drawable/shape_chip_checked"
    android:paddingLeft="@dimen/space_12"
    android:paddingRight="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_32"
    android:paddingHorizontal="@dimen/space_12">
    <TextView
        android:textSize="@dimen/text_14"
        android:textColor="?attr/uikitTextPrimary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/chip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/chip_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
