<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/uikitBackgroundContent"
    android:paddingLeft="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:layout_width="@dimen/column_title_width"
    android:layout_height="@dimen/row_height"
    android:paddingHorizontal="@dimen/space_8">
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="@dimen/icon_size_16"
        android:layout_height="@dimen/icon_size_16"
        android:scaleType="center"
        android:layout_marginEnd="@dimen/space_4"
        app:cornerRadiusImageView="@dimen/corner_radius_8"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="ltr"/>
</LinearLayout>
