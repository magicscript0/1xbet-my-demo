<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/size_150"
        android:minHeight="@dimen/size_94"
        android:layoutDirection="ltr">
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionNew"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvGameName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:barrierDirection="bottom"
            app:barrierMargin="@dimen/space_8"
            app:constraint_referenced_ids="tvGameName"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guidelineCenter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.5"/>
        <FrameLayout
            android:id="@+id/teamOneLayout"
            android:layout_width="@dimen/icon_size_48"
            android:layout_height="@dimen/icon_size_56"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_4"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toStartOf="@+id/tvScore"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginEnd="@dimen/space_60">
            <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/ivTeamOne"
                android:layout_width="@dimen/icon_size_40"
                android:layout_height="@dimen/icon_size_40"
                app:cornerRadiusImageView="@dimen/corner_radius_8"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/llOneTeamPairContainerImages"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                    android:id="@+id/ivFirstPlayerOneTeamImage"
                    android:layout_width="@dimen/icon_size_24"
                    android:layout_height="@dimen/icon_size_24"
                    android:layout_marginBottom="@dimen/space_4"
                    app:cornerRadiusImageView="@dimen/corner_radius_8"/>
                <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                    android:id="@+id/ivSecondPlayerOneTeamImage"
                    android:layout_width="@dimen/icon_size_24"
                    android:layout_height="@dimen/icon_size_24"
                    app:cornerRadiusImageView="@dimen/corner_radius_8"/>
            </LinearLayout>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionLightNew"
                android:textSize="@dimen/text_12"
                android:gravity="center"
                android:layout_gravity="end|bottom"
                android:id="@+id/redCardTeamOne"
                android:background="@drawable/ic_red_card_statistic"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:paddingBottom="@dimen/space_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_6"
                android:paddingHorizontal="@dimen/space_4"/>
        </FrameLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2New"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:id="@+id/tvTeamOne"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/space_8"
            android:maxLines="3"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toStartOf="@+id/teamOneLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline5BoldNew"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/teamOneLayout"
            app:layout_constraintEnd_toStartOf="@+id/teamTwoLayout"
            app:layout_constraintStart_toEndOf="@+id/teamOneLayout"
            app:layout_constraintTop_toTopOf="@+id/teamOneLayout"
            app:layout_goneMarginBottom="@dimen/space_12"/>
        <FrameLayout
            android:id="@+id/teamTwoLayout"
            android:layout_width="@dimen/icon_size_48"
            android:layout_height="@dimen/icon_size_56"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_marginStart="@dimen/space_4"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/tvScore"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_goneMarginStart="@dimen/space_60">
            <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivTeamTwo"
                android:layout_width="@dimen/icon_size_40"
                android:layout_height="@dimen/icon_size_40"
                app:cornerRadiusImageView="@dimen/corner_radius_8"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/llTwoTeamPairContainerImages"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                    android:id="@+id/ivFirstPlayerTwoTeamImage"
                    android:layout_width="@dimen/icon_size_24"
                    android:layout_height="@dimen/icon_size_24"
                    android:layout_marginBottom="@dimen/space_4"
                    app:cornerRadiusImageView="@dimen/corner_radius_8"/>
                <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
                    android:id="@+id/ivSecondPlayerTwoTeamImage"
                    android:layout_width="@dimen/icon_size_24"
                    android:layout_height="@dimen/icon_size_24"
                    app:cornerRadiusImageView="@dimen/corner_radius_8"/>
            </LinearLayout>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionLightNew"
                android:textSize="@dimen/text_12"
                android:gravity="center"
                android:layout_gravity="start|bottom"
                android:id="@+id/redCardTeamTwo"
                android:background="@drawable/ic_red_card_statistic"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:paddingBottom="@dimen/space_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_6"
                android:paddingHorizontal="@dimen/space_4"/>
        </FrameLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2New"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tvTeamTwo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/space_8"
            android:maxWidth="100dp"
            android:maxLines="3"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_16"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/teamTwoLayout"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionLightNew"
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:alpha="0.7"
            android:layout_marginHorizontal="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupTwoTeam"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="tvTeamOne, tvTeamTwo, tvScore, teamOneLayout, teamTwoLayout"/>
        <TextView
            android:textAppearance="?attr/textAppearanceHeadline6New"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvOneTeamTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:maxLines="3"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="@dimen/space_8"
            app:autoSizeMaxTextSize="@dimen/text_20"
            app:autoSizeMinTextSize="@dimen/text_12"
            app:autoSizeStepGranularity="@dimen/text_2"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"
            app:layout_goneMarginBottom="@dimen/space_8"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
