<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/compressed_card_height">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textSize="@dimen/text_10"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchBaseInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivOneTeam"
        android:layout_width="@dimen/icon_size_40"
        android:layout_height="@dimen/icon_size_40"
        android:layout_marginEnd="@dimen/space_8"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvOneTeamName"
        app:layout_constraintEnd_toStartOf="@+id/tvScore"
        app:layout_constraintTop_toTopOf="@+id/tvOneTeamName"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flTeamOneLogos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        app:constraint_referenced_ids="ivOneTeamFirstPlayer,ivOneTeamSecondPlayer"
        app:flow_maxElementsWrap="1"
        app:flow_verticalGap="@dimen/space_4"
        app:flow_verticalStyle="packed"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toBottomOf="@+id/tvOneTeamName"
        app:layout_constraintEnd_toStartOf="@+id/tvScore"
        app:layout_constraintTop_toTopOf="@+id/tvOneTeamName"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivOneTeamFirstPlayer"
        android:layout_width="@dimen/icon_size_20"
        android:layout_height="@dimen/icon_size_20"
        app:cornerRadiusImageView="@dimen/corner_radius_6"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivOneTeamSecondPlayer"
        android:layout_width="@dimen/icon_size_20"
        android:layout_height="@dimen/icon_size_20"
        app:cornerRadiusImageView="@dimen/corner_radius_6"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bOneTeamImages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ivOneTeam,flTeamOneLogos"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.CustomCutTextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tvOneTeamName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_8"
        android:maxLines="3"
        android:lineSpacingMultiplier="0.8"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toStartOf="@+id/bOneTeamImages"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchBaseInfo"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivTwoTeam"
        android:layout_width="@dimen/icon_size_40"
        android:layout_height="@dimen/icon_size_40"
        android:layout_marginStart="@dimen/space_8"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvTwoTeamName"
        app:layout_constraintStart_toEndOf="@+id/tvScore"
        app:layout_constraintTop_toTopOf="@+id/tvTwoTeamName"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flTeamTwoLogos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        app:constraint_referenced_ids="ivTwoTeamFirstPlayer,ivTwoTeamSecondPlayer"
        app:flow_maxElementsWrap="1"
        app:flow_verticalGap="@dimen/space_4"
        app:flow_verticalStyle="packed"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toBottomOf="@+id/tvTwoTeamName"
        app:layout_constraintStart_toEndOf="@+id/tvScore"
        app:layout_constraintTop_toTopOf="@+id/tvTwoTeamName"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivTwoTeamFirstPlayer"
        android:layout_width="@dimen/icon_size_20"
        android:layout_height="@dimen/icon_size_20"
        android:layout_marginStart="@dimen/space_8"
        app:cornerRadiusImageView="@dimen/corner_radius_6"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivTwoTeamSecondPlayer"
        android:layout_width="@dimen/icon_size_20"
        android:layout_height="@dimen/icon_size_20"
        android:layout_marginStart="@dimen/space_8"
        app:cornerRadiusImageView="@dimen/corner_radius_6"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTwoTeamImages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="ivTwoTeam,flTeamTwoLogos"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.CustomCutTextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvTwoTeamName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_8"
        android:maxLines="3"
        android:lineSpacingMultiplier="0.8"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bTwoTeamImages"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchBaseInfo"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvScore"
        android:layout_width="@dimen/game_screen_score_width"
        android:layout_height="@dimen/size_56"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:layout_marginVertical="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchBaseInfo"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="@dimen/space_2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gLogosTeams"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="ivOneTeam,ivTwoTeam"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gLogosPairTeams"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="flTeamOneLogos,flTeamTwoLogos"/>
</androidx.constraintlayout.widget.ConstraintLayout>
