<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/ivEmptySearch"
        android:background="@drawable/white_radius"
        android:layout_width="@dimen/icon_size_32"
        android:layout_height="@dimen/icon_size_32"
        android:layout_margin="@dimen/space_8"
        android:backgroundTint="?attr/uikitSeparator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vEmptyChipOne"
        android:background="@drawable/chip_16_background"
        android:layout_width="@dimen/shimmer_size_128"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitSeparator"
        app:layout_constraintBottom_toBottomOf="@+id/ivEmptySearch"
        app:layout_constraintStart_toEndOf="@+id/ivEmptySearch"
        app:layout_constraintTop_toTopOf="@+id/ivEmptySearch"/>
    <View
        android:id="@+id/vEmptyChipTwo"
        android:background="@drawable/chip_16_background"
        android:layout_width="@dimen/shimmer_size_128"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitSeparator"
        app:layout_constraintBottom_toBottomOf="@+id/ivEmptySearch"
        app:layout_constraintStart_toEndOf="@+id/vEmptyChipOne"
        app:layout_constraintTop_toTopOf="@+id/ivEmptySearch"/>
    <View
        android:id="@+id/vEmptyChipThree"
        android:background="@drawable/chip_16_background"
        android:layout_width="@dimen/shimmer_size_128"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_8"
        android:backgroundTint="?attr/uikitSeparator"
        app:layout_constraintBottom_toBottomOf="@+id/ivEmptySearch"
        app:layout_constraintStart_toEndOf="@+id/vEmptyChipTwo"
        app:layout_constraintTop_toTopOf="@+id/ivEmptySearch"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/match_constraints"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikitBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
