<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_gravity="center"
            android:id="@+id/collapsingToolbarLayout"
            android:background="?attr/uikitBackgroundDark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:expandedTitleGravity="start|center_vertical"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="16dp"
            app:expandedTitleMarginTop="68dp"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:toolbarId="@+id/toolbarNews">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="@drawable/win_tour_gradient"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7">
                <org.xplatform.games_section.feature.daily_tournament.presentation.ForegroundImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="-65dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:backgroundTintMode="multiply"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7"
                    app:srcCompat="@drawable/plug_news"/>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/ivBannerPrize"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="-65dp"
                    android:layout_marginStart="@dimen/size_150"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7"
                    app:srcCompat="@drawable/plug_news"/>
            </FrameLayout>
            <com.google.android.material.appbar.MaterialToolbar
                android:layout_gravity="top"
                android:id="@+id/toolbarNews"
                android:background="@color/static_transparent"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:autoMirrored="true"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:layout_scrollFlags="enterAlways|scroll"
                app:navigationIcon="@drawable/ic_back_games"
                style="@style/Widget.AppTheme.Toolbar.New"/>
            <FrameLayout
                android:layout_gravity="start|bottom"
                android:id="@+id/clText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_40"
                android:layout_marginStart="@dimen/space_16"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2New"
                    android:textColor="@color/static_white"
                    android:id="@+id/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_tournament_desc"
                    app:layout_constraintBottom_toTopOf="@+id/btnRules"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </FrameLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout
            android:id="@+id/segmentsContainer"
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/elevation_2">
            <org.xplatform.uikit.components.segmented_control.DsSegmentedGroup
                android:theme="?attr/uikitTheme"
                android:id="@+id/segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginRight="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_12"
                android:layout_marginHorizontal="@dimen/space_16"
                android:layout_marginVertical="@dimen/space_12"/>
        </FrameLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpNewsViewPager"
            android:background="?attr/uikitBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        app:backgroundTint="?attr/uikitPrimary"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_arrow_forward_white"
        app:tint="@color/static_white"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cLayout2"
        android:background="@drawable/bottom_shape_round_inactive"
        android:padding="@dimen/space_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:elevation="@dimen/elevation_4">
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionNew"
            android:id="@+id/tvPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dt_your_place"
            android:layout_marginStart="@dimen/space_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:id="@+id/tvPlaceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/tvPlace"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvPlace"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionNew"
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/your_points"
            app:layout_constraintBottom_toBottomOf="@+id/tvPointsValue"
            app:layout_constraintStart_toStartOf="@+id/tvPlace"
            app:layout_constraintTop_toTopOf="@+id/tvPointsValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:id="@+id/tvPointsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="@+id/tvPlaceValue"
            app:layout_constraintTop_toBottomOf="@+id/tvPlaceValue"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
