<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AppTheme.AppWidgetContainer"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/widgetItemContainer"
    android:paddingTop="@dimen/space_16"
    android:paddingBottom="@dimen/space_22"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/imageViewEmptyNotification"
        android:layout_width="@dimen/icon_size_40"
        android:layout_height="@dimen/icon_size_40"
        android:layout_marginBottom="@dimen/space_12"
        android:src="@drawable/ic_favorite_star_new"
        android:tint="?attr/uikitWidgetIcon50"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumPrimaryNew"
        android:textStyle="bold"
        android:textColor="?attr/uikitWidgetText"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/textViewNotification"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_favorites_games_title"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"/>
</LinearLayout>
