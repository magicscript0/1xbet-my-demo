<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:gravity="center"
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/confirmation"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Headline.Medium"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/emailForceDescription"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:maxLines="3"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:id="@+id/emailDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/restore_by_email_inf"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailForceDescription"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/emailTextField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_16"
        android:inputType="textEmailAddress"
        android:layout_marginHorizontal="@dimen/space_16"
        app:hint="@string/restore_password_by_email_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailDescription"
        app:singleLine="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
