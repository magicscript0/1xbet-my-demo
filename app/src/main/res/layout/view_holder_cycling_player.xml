<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_corners_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="?attr/uikitBackgroundGroup">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/sportLogo"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cycling"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/TextAppearance.AppTheme.New.Subtitle1.Bold"
        android:gravity="center_vertical"
        android:id="@+id/titleCycling"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintBottom_toBottomOf="@+id/sportLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sportLogo"
        app:layout_constraintTop_toTopOf="@+id/sportLogo"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_rounded_corners_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginRight="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginHorizontal="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportLogo">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/datesCycling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_8"/>
        <View
            android:background="?attr/uikitBackgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/statusCycling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_8"/>
        <View
            android:background="?attr/uikitBackgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/numberCycling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_8"/>
        <View
            android:background="?attr/uikitBackgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/TextAppearance.AppTheme.New.Body2.Medium.Primary"
            android:gravity="center_vertical"
            android:id="@+id/leaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_8"
            android:text="@string/leadership"/>
        <androidx.recyclerview.widget.RecyclerView
            android:gravity="center_vertical"
            android:id="@+id/leaderBoardCycling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_marginHorizontal="@dimen/space_8"/>
        <View
            android:id="@+id/leaderBoardCyclingDivider"
            android:background="?attr/uikitBackgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/timeCycling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_8"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
