<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clHistoryRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/historyToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_need_auth_container"
        android:background="?attr/uikitBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/historyToolbar">
        <org.xplatform.uikit.components.authorization_buttons.DsAuthorizationButtons
            android:id="@+id/auth_buttons_view"
            android:paddingLeft="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingRight="@dimen/space_12"
            android:paddingBottom="@dimen/space_8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_8"
            app:dsAuthorizationButtonLabel="@string/button_login"
            app:dsRegistrationButtonLabel="@string/registration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginRight="@dimen/space_16"
            android:layout_marginHorizontal="@dimen/space_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auth_buttons_view">
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:alpha="0.5"
                app:srcCompat="@drawable/ic_need_some_action_info"
                app:tint="?attr/uikitSecondary"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBody1New"
                android:textColor="?attr/uikitSecondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/bet_history_available_only_authorized_users"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/content"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/historyToolbar">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/toolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|enterAlwaysCollapsed|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:id="@+id/cl_balance"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/space_8">
                    <TextView
                        android:textAppearance="?attr/textAppearanceCaptionNew"
                        android:id="@+id/tv_balance_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:layout_marginStart="@dimen/space_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
                        android:textSize="@dimen/text_32"
                        android:gravity="start|center_vertical"
                        android:id="@+id/tv_balance_money"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textDirection="ltr"
                        android:textAlignment="viewStart"
                        android:layout_marginEnd="@dimen/space_8"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintEnd_toStartOf="@+id/tv_show_all_balances"
                        app:layout_constraintStart_toStartOf="@+id/tv_balance_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_balance_name"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceSubtitle2New"
                        android:textColor="?attr/uikitPrimary"
                        android:id="@+id/tv_show_all_balances"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_balances"
                        android:layout_marginEnd="@dimen/space_16"
                        app:drawableEndCompat="@drawable/ic_arrow_down"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_balance_money"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_balance_money"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:id="@+id/cl_actions"
                android:background="@drawable/transaction_history_rectangle_corn"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:layout_marginStart="@dimen/space_8"
                android:layout_marginEnd="@dimen/space_8"
                app:layout_constraintTop_toBottomOf="@+id/indicator">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ll_sale"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_date"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_calendar_history"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceCaptionMedium"
                        android:textColor="?attr/uikitSecondary"
                        android:gravity="center"
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_sale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ll_pay_in"
                    app:layout_constraintStart_toEndOf="@+id/ll_date"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="0dp">
                    <ImageView
                        android:id="@+id/iv_sale"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_sale_history"/>
                    <TextView
                        android:textSize="@dimen/text_12"
                        android:textColor="?attr/uikitSecondary"
                        android:id="@+id/tv_sale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/history_sale"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_pay_in"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ll_sale"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_pay_in"
                        android:background="@drawable/circle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:backgroundTint="@color/static_white"
                        app:srcCompat="@drawable/ic_icon_plus_white"
                        app:tint="?attr/uikitCommerce"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceCaptionMedium"
                        android:textColor="?attr/uikitSecondary"
                        android:id="@+id/tv_pay_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/top_up"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <org.xplatform.ui_core.viewcomponents.swiperefreshlayout.SwipeRefreshLayout
            android:id="@+id/swipeRefreshView"
            android:background="?attr/uikitBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:background="?attr/uikitSeparator"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_1"
                    android:elevation="@dimen/space_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistory"
                    android:paddingBottom="@dimen/space_24"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <org.xplatform.uikit.components.lottie.LottieView
                    android:id="@+id/lottieEmptyView"
                    android:tag="historyEmptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </org.xplatform.ui_core.viewcomponents.swiperefreshlayout.SwipeRefreshLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:id="@+id/frame_progress"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/historyToolbar">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_bar_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="56dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/uikitSecondary"/>
    </FrameLayout>
    <View
        android:id="@+id/bg_swipe_progress"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
