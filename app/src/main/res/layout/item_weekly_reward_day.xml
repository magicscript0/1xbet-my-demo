<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/space_24"
    android:paddingRight="@dimen/space_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_24">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/space_24"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/uikitBackgroundContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivDayBackground"
                android:layout_width="0dp"
                android:layout_height="123dp"
                android:src="@drawable/card_lock"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/weekly_reward_card_foreground"
                android:layout_width="0dp"
                android:layout_height="64dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivDayBackground"
                app:layout_constraintEnd_toEndOf="@+id/ivDayBackground"
                app:layout_constraintStart_toStartOf="@+id/ivDayBackground"/>
            <Space
                android:id="@+id/spacer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="21dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivDayBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/tvDayTitle"
                android:background="@drawable/rounded_day_bg"
                android:paddingLeft="@dimen/space_24"
                android:paddingRight="@dimen/space_24"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:textAllCaps="true"
                android:paddingHorizontal="@dimen/space_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/spacer"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupNotAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvNotAvailable,tvNotAvailableDescription"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline5MediumNew"
                android:gravity="center"
                android:id="@+id/tvNotAvailable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/promo_weekly_reward_not_available"
                android:maxLines="1"
                app:autoSizeMaxTextSize="@dimen/text_24"
                app:autoSizeMinTextSize="@dimen/text_12"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDayTitle"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1New"
                android:gravity="center"
                android:id="@+id/tvNotAvailableDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/promo_weekly_reward_not_available_description"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNotAvailable"/>
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline5MediumNew"
                android:gravity="center"
                android:id="@+id/tvCompleted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/promo_weekly_reward_done"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivDayBackground"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupHurryUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvHurryUp,timerView"/>
            <TextView
                android:textAppearance="?attr/textAppearanceSubtitle1New"
                android:gravity="center"
                android:id="@+id/tvHurryUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/promo_weekly_reward_hurry_up_to_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDayTitle"/>
            <org.xplatform.ui_core.viewcomponents.views.TimerView
                android:id="@+id/timerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHurryUp"
                app:timeDelimiterTextColor="?attr/uikitPrimary"
                app:timeTextColor="@color/static_white"
                app:timeTextSize="@dimen/text_14"
                app:timerBold="true"
                app:timerCompact="false"
                app:timerFontStyle="sans-serif-medium"
                app:timerShowLabels="false"
                app:timerShowSec="false"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBody1New"
                android:gravity="center"
                android:id="@+id/tvCongratulations"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                android:text="@string/promo_weekly_reward_congratulations"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDayTitle"/>
            <View
                android:id="@+id/mask"
                android:background="?attr/uikitBackground"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textAppearance="?attr/textAppearanceBody2Medium"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/btnPlay"
        android:background="@drawable/bg_rounded_corners_32dp_gradient_primary_game_button"
        android:paddingLeft="38dp"
        android:paddingRight="38dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:drawablePadding="@dimen/space_8"
        android:textAllCaps="true"
        android:elevation="@dimen/space_4"
        android:paddingHorizontal="38dp"
        app:drawableStartCompat="@drawable/ic_games_all"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
