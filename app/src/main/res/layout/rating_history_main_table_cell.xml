<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackgroundGroup"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/row_height">
    <TextView
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/dataTextView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="2"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="@dimen/text_1"
        android:autoSizeMinTextSize="@dimen/text_10"
        android:layout_marginHorizontal="@dimen/space_8"
        android:autoSizeMaxTextSize="@dimen/text_12"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
</FrameLayout>
