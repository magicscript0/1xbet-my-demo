<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_128"
    android:layout_marginTop="@dimen/space_8">
    <View
        android:id="@+id/vHeaderBackground"
        android:background="@drawable/bg_rounded_corner_8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_22"
        android:backgroundTint="@color/static_black_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vTeamsDivider"
        android:background="@color/static_white_60"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_1"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_48"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintTop_toBottomOf="@+id/vHeaderBackground"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvPeriodsName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/periods"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/vHeaderBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vHeaderBackground"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTotalScore"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="tvTotalScoreName, tvTeamOneTotalScore, tvTeamTwoTotalScore"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bTotalScoreDividers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="vTotalScoreNameDivider, vTeamOneTotalScoreDivider, vTeamTwoTotalScoreDivider"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvTotalScoreName"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/total_count"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/vHeaderBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bTotalScore"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vTotalScoreNameDivider"
        android:background="@color/static_white_60"
        android:layout_width="@dimen/space_1"
        android:layout_height="@dimen/space_18"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/vHeaderBackground"
        app:layout_constraintEnd_toStartOf="@+id/bTotalScore"
        app:layout_constraintTop_toTopOf="@+id/vHeaderBackground"/>
    <View
        android:id="@+id/vTeamOneTotalScoreDivider"
        android:background="@color/static_white_60"
        android:layout_width="@dimen/space_1"
        android:layout_height="@dimen/space_32"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvTeamOneTotalScore"
        app:layout_constraintEnd_toStartOf="@+id/bTotalScore"
        app:layout_constraintTop_toTopOf="@+id/tvTeamOneTotalScore"/>
    <View
        android:id="@+id/vTeamTwoTotalScoreDivider"
        android:background="@color/static_white_60"
        android:layout_width="@dimen/space_1"
        android:layout_height="@dimen/space_32"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvTeamTwoTotalScore"
        app:layout_constraintEnd_toStartOf="@+id/bTotalScore"
        app:layout_constraintTop_toTopOf="@+id/tvTeamTwoTotalScore"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvTeamOneTotalScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/vTeamsDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bTotalScore"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalScoreName"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tvTeamTwoTotalScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bTotalScore"
        app:layout_constraintTop_toBottomOf="@+id/vTeamsDivider"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivTeamOneLogo"
        android:layout_width="@dimen/icon_size_32"
        android:layout_height="@dimen/icon_size_32"
        android:layout_marginStart="@dimen/space_4"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintBottom_toTopOf="@+id/vTeamsDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vHeaderBackground"/>
    <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
        android:id="@+id/ivTeamTwoLogo"
        android:layout_width="@dimen/icon_size_32"
        android:layout_height="@dimen/icon_size_32"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_4"
        app:cornerRadiusImageView="@dimen/corner_radius_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vTeamsDivider"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.FootballEventsView
        android:gravity="start"
        android:id="@+id/vTeamOneFootballEvents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/tvTeamOneName"
        app:layout_constraintEnd_toStartOf="@+id/rvPeriods"
        app:layout_constraintStart_toEndOf="@+id/ivTeamOneLogo"
        app:layout_constraintTop_toTopOf="@+id/ivTeamOneLogo"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTeamOneName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/ivTeamOneLogo"
        app:layout_constraintEnd_toStartOf="@+id/rvPeriods"
        app:layout_constraintStart_toEndOf="@+id/ivTeamOneLogo"
        app:layout_constraintTop_toBottomOf="@+id/vTeamOneFootballEvents"
        app:layout_goneMarginTop="0dp"/>
    <org.xplatform.sportgame.classic.impl.presentation.views.FootballEventsView
        android:gravity="start"
        android:id="@+id/vTeamTwoFootballEvents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/tvTeamTwoName"
        app:layout_constraintEnd_toStartOf="@+id/rvPeriods"
        app:layout_constraintStart_toEndOf="@+id/ivTeamTwoLogo"
        app:layout_constraintTop_toTopOf="@+id/ivTeamTwoLogo"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTeamTwoName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/ivTeamTwoLogo"
        app:layout_constraintEnd_toStartOf="@+id/rvPeriods"
        app:layout_constraintStart_toEndOf="@+id/ivTeamTwoLogo"
        app:layout_constraintTop_toBottomOf="@+id/vTeamTwoFootballEvents"
        app:layout_goneMarginTop="0dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rvPeriods"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:layout_marginEnd="@dimen/space_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bTotalScoreDividers"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/size_94"/>
</androidx.constraintlayout.widget.ConstraintLayout>
