<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/match_info_cards_height"
    android:layout_marginTop="@dimen/space_4">
    <TextView
        android:textAppearance="?attr/textAppearanceOverline"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/flFirstTeamLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription">
        <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/ivFirstTeamImage"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:layout_marginLeft="@dimen/space_4"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_4"
            android:layout_marginVertical="@dimen/space_4"
            app:cornerRadiusImageView="@dimen/corner_radius_8"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/ivFirstTeamFavorite"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"/>
    </FrameLayout>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvFirstTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/flFirstTeamLogo"
        app:layout_constraintEnd_toEndOf="@+id/firstTeamVerticalSeparatorView"
        app:layout_constraintStart_toEndOf="@+id/flFirstTeamLogo"
        app:layout_constraintTop_toTopOf="@+id/flFirstTeamLogo"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/dividerGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/teamsHorizontalSeparatorView"
        android:background="@color/static_white_60"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_1"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flFirstTeamLogo"/>
    <View
        android:id="@+id/firstTeamVerticalSeparatorView"
        android:background="@color/static_white_60"
        android:layout_width="@dimen/size_1"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/flFirstTeamLogo"
        app:layout_constraintEnd_toEndOf="@+id/dividerGuideline"
        app:layout_constraintStart_toStartOf="@+id/dividerGuideline"
        app:layout_constraintTop_toTopOf="@+id/flFirstTeamLogo"/>
    <View
        android:id="@+id/secondTeamVerticalSeparatorView"
        android:background="@color/static_white_60"
        android:layout_width="@dimen/size_1"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/flSecondTeamLogo"
        app:layout_constraintEnd_toEndOf="@+id/dividerGuideline"
        app:layout_constraintStart_toStartOf="@+id/dividerGuideline"
        app:layout_constraintTop_toTopOf="@+id/flSecondTeamLogo"/>
    <FrameLayout
        android:id="@+id/flSecondTeamLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamsHorizontalSeparatorView">
        <org.xplatform.ui_core.viewcomponents.imageview.RoundCornerImageView
            android:layout_gravity="center"
            android:id="@+id/ivSecondTeamImage"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:layout_marginLeft="@dimen/space_4"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginRight="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_4"
            android:layout_marginVertical="@dimen/space_4"
            app:cornerRadiusImageView="@dimen/corner_radius_8"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/ivSecondTeamFavorite"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_24"/>
    </FrameLayout>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionLightNew"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvSecondTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/flSecondTeamLogo"
        app:layout_constraintEnd_toEndOf="@+id/secondTeamVerticalSeparatorView"
        app:layout_constraintStart_toEndOf="@+id/flSecondTeamLogo"
        app:layout_constraintTop_toTopOf="@+id/flSecondTeamLogo"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:textColor="@color/static_white"
        android:gravity="end"
        android:id="@+id/tvFirstTeamScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:autoSizeMaxTextSize="@dimen/space_16"
        app:autoSizeMinTextSize="@dimen/space_10"
        app:autoSizeStepGranularity="@dimen/space_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/flFirstTeamLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/firstTeamVerticalSeparatorView"
        app:layout_constraintTop_toTopOf="@+id/flFirstTeamLogo"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:textColor="@color/static_white"
        android:gravity="end"
        android:id="@+id/tvSecondTeamScore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:autoSizeMaxTextSize="@dimen/space_16"
        app:autoSizeMinTextSize="@dimen/space_10"
        app:autoSizeStepGranularity="@dimen/space_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/flSecondTeamLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondTeamVerticalSeparatorView"
        app:layout_constraintTop_toTopOf="@+id/flSecondTeamLogo"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="?attr/textAppearanceOverline"
        android:textColor="@color/static_white_60"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvMatchPeriodInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/space_4"
        app:autoSizeMaxTextSize="@dimen/text_12"
        app:autoSizeMinTextSize="@dimen/text_10"
        app:autoSizeStepGranularity="@dimen/text_autosize_step_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flSecondTeamLogo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
