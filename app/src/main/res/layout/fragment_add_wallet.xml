<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.toolbar.base.DsNavigationBarBasic
        android:id="@+id/navigationBar"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showShadow="false"
        app:title="@string/add_wallet_title"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <org.xplatform.uikit.components.header.DsHeader
        android:id="@+id/walletNameTitle"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:headerType="small"
        app:horizontalMargin="@dimen/space_16"
        app:isLoading="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        app:title="@string/wallet_name_title"/>
    <org.xplatform.uikit.components.text_field.DsTextField
        android:id="@+id/walletNameTextField"
        android:background="@drawable/rounded_background_16"
        android:padding="@dimen/space_16"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:inputType="textCapSentences"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:hint="@string/enter_name_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/walletNameTitle"
        style="@style/Widget.DSTextField.Basic"/>
    <org.xplatform.uikit.components.header.DsHeader
        android:id="@+id/currencyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:headerType="small"
        app:horizontalMargin="@dimen/space_16"
        app:isLoading="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/walletNameTextField"
        app:title="@string/currency"/>
    <org.xplatform.uikit.components.cells.DsSettingsCell
        android:id="@+id/addWalletCell"
        android:background="@drawable/rounded_background_16"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/currencyTitle"
        style="@style/Widget.DSCell.Settings">
        <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
            android:id="@+id/addWalletIcon"
            app:srcCompat="@drawable/ic_glyph_plus_small"
            style="@style/Widget.DSCell.Left.Icon.Back"/>
        <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
            android:id="@+id/addWalletTitle"
            style="@style/Widget.DSCell.Middle.Title.L"/>
        <org.xplatform.uikit.components.cells.right.DsCellRightLabel style="@style/Widget.DSCell.Right.Icon"/>
    </org.xplatform.uikit.components.cells.DsSettingsCell>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:id="@+id/addWalletBottomBar"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        app:firstButtonText="@string/create_wallet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/progress"
        android:background="@color/static_black_60"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
