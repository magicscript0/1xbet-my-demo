<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/uikitBackground"
    android:paddingLeft="@dimen/large_horizontal_margin_dynamic"
    android:paddingTop="@dimen/space_16"
    android:paddingRight="@dimen/large_horizontal_margin_dynamic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/large_horizontal_margin_dynamic">
    <org.xplatform.uikit.components.header.DsHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerType="small"
        app:horizontalMargin="@dimen/space_16"
        app:isLoading="false"
        app:title="@string/bet_settings_bet_quick_container_title"/>
    <include
        android:id="@+id/toggleQuickBet"
        layout="@layout/settings_cell_toggle_layout"/>
    <include
        android:id="@+id/firstSumCell"
        layout="@layout/settings_cell_right_chevron_layout"/>
    <include
        android:id="@+id/secondSumCell"
        layout="@layout/settings_cell_right_chevron_layout"/>
    <include
        android:id="@+id/thirdSumCell"
        layout="@layout/settings_cell_right_chevron_layout"/>
    <org.xplatform.uikit.components.footer.DsFooter
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.DSFooter"/>
</LinearLayout>
