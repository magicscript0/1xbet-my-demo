<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size_48"
    android:layout_marginLeft="@dimen/space_4"
    android:layout_marginTop="@dimen/space_2"
    android:layout_marginRight="@dimen/space_4"
    android:layout_marginBottom="@dimen/space_2"
    android:layout_marginHorizontal="@dimen/space_4"
    android:layout_marginVertical="@dimen/space_2"
    app:cardCornerRadius="@dimen/corner_radius_8"
    style="@style/Widget.AppTheme.CardView.New">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_sport_icon"
            android:layout_width="@dimen/size_32"
            android:layout_height="@dimen/size_32"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_8"
            android:scaleType="center"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginVertical="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/uikitSecondary80"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle1New"
            android:textSize="@dimen/text_16"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tv_sport_filter_name"
            android:paddingLeft="@dimen/space_2"
            android:paddingRight="@dimen/space_2"
            android:layout_width="@dimen/size_0"
            android:layout_height="@dimen/size_0"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginRight="@dimen/space_16"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:layout_marginHorizontal="@dimen/space_16"
            android:paddingHorizontal="@dimen/space_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/touchImageView"
            app:layout_constraintStart_toEndOf="@+id/iv_sport_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/touchImageView"
            android:padding="@dimen/space_12"
            android:layout_width="@dimen/size_48"
            android:layout_height="@dimen/size_48"
            android:layout_marginRight="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sport_selector"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_drag_icon"/>
        <ImageView
            android:id="@+id/sport_selector"
            android:layout_width="@dimen/size_24"
            android:layout_height="@dimen/size_24"
            android:src="@drawable/sports_checked_selector"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
