<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:id="@+id/rootView"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:showSeparator="false"
        app:showShadow="false"
        app:title="@string/scanner"
        style="@style/Widgets.BasicNavigationBar.Title"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/segmentsContainer"
                android:background="?attr/uikitBackgroundContent"
                android:paddingLeft="@dimen/space_12"
                android:paddingTop="@dimen/space_8"
                android:paddingRight="@dimen/space_12"
                android:paddingBottom="@dimen/space_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_12"
                android:paddingVertical="@dimen/space_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/composeViewSegmentedControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <org.xplatform.uikit.components.separator.DsSeparator
                android:layout_width="0dp"
                android:layout_height="@dimen/size_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/segmentsContainer"
                style="@style/Widget.DSSeparator.Separator60"/>
            <androidx.constraintlayout.helper.widget.Flow
                android:orientation="vertical"
                android:background="@drawable/rounded_background_16"
                android:paddingLeft="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingRight="@dimen/space_16"
                android:paddingBottom="@dimen/space_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
                android:backgroundTint="?attr/uikitBackgroundContent"
                android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_16"
                app:constraint_referenced_ids="couponDescriptionTv,etCoupon"
                app:flow_verticalGap="@dimen/space_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/segmentsContainer"/>
            <TextView
                android:textColor="?attr/uikitSecondary"
                android:id="@+id/couponDescriptionTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/code_info_request"
                android:textAlignment="viewStart"
                style="@style/TextAppearance.Regular"/>
            <org.xplatform.uikit.components.text_field.DsTextField
                android:id="@+id/etCoupon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:hint="@string/coupon_number_hint"
                style="@style/Widget.DSTextField.Basic"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/loaderContainer"
        android:background="@color/static_overlay_background_40"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="@dimen/space_4">
        <org.xplatform.uikit.components.loader.DsLoader
            android:layout_gravity="center"
            android:id="@+id/loader"
            style="@style/Widget.DSLoader"/>
    </FrameLayout>
    <org.xplatform.uikit.components.bottom_bar.DsBottomBar
        android:layout_gravity="bottom"
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottomBarType="twoVerticalButtons"
        app:firstButtonStyle="@style/DSButton.Large.Secondary"
        app:firstButtonText="@string/scan"
        app:secondButtonStyle="@style/DSButton.Large.Primary"
        app:secondButtonText="@string/check"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
