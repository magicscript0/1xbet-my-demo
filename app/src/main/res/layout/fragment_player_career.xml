<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/career"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceHeadline6MediumNew"
        style="@style/Widget.AppTheme.Toolbar.New"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContent"
        android:background="@drawable/background_round_statuses"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        android:backgroundTint="?attr/uikitBackgroundContent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rvChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_4"
            android:layout_marginTop="@dimen/size_8"
            android:layout_marginRight="@dimen/space_4"
            android:layout_marginHorizontal="@dimen/space_4"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <org.xplatform.ui_core.viewcomponents.views.scrollable_table.table_view.TableViewImpl
            android:id="@+id/table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout
        android:orientation="vertical"
        android:id="@+id/shimmers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/shimmer_item_line_up"/>
            <include layout="@layout/shimmer_grand_prix_dark"/>
            <View
                android:id="@+id/separator"
                android:background="?attr/uikitSeparator"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
        </LinearLayout>
    </org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:layout_gravity="center"
        android:id="@+id/lottieEmptyView"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <View
        android:id="@+id/pinnedTableBackground"
        android:background="?attr/uikitBackgroundContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/pinnedTotalTable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pinnedTotalTable"/>
    <org.xplatform.ui_core.viewcomponents.views.scrollable_table.table_view.TableViewImpl
        android:id="@+id/pinnedTotalTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/llContent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/pinnedTableTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="pinnedTotalTable, pinnedTableBackground"/>
</androidx.constraintlayout.widget.ConstraintLayout>
