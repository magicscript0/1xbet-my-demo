<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.header.DsHeader
        android:theme="?attr/uikitTheme"
        android:id="@+id/header"
        android:paddingLeft="@dimen/extra_large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/extra_large_horizontal_margin_dynamic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        app:buttonText="@string/filter_all"
        app:headerType="large"
        app:title="@string/categories"
        style="@style/Widget.Header"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/headerShimmer"
        android:visibility="visible"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_10"
        android:radius="@dimen/radius_full"
        android:layout_marginStart="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginVertical="@dimen/space_10"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.category_card_collection.DsCategoryCardCollection
        android:orientation="horizontal"
        android:id="@+id/vCategoryCardCollection"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"/>
</LinearLayout>
