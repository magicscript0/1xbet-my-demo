<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/size_32">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgImage"
        android:padding="@dimen/space_1"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="?attr/uikitSeparator"
        app:strokeWidth="@dimen/size_2"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorPrimary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/txtAuthorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/txtMessage"
        app:layout_constraintEnd_toStartOf="@+id/imgQuouta"
        app:layout_constraintStart_toEndOf="@+id/imgImage"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textSize="@dimen/text_12"
        android:textColor="?attr/colorSecondary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/txtMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgImage"
        app:layout_constraintTop_toBottomOf="@+id/txtAuthorName"/>
    <ImageView
        android:textSize="@dimen/text_12"
        android:id="@+id/imgQuouta"
        android:layout_width="@dimen/size_14"
        android:layout_height="@dimen/size_14"
        app:layout_constraintBottom_toBottomOf="@+id/txtAuthorName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtAuthorName"
        app:srcCompat="@drawable/ic_glyph_quotation"
        app:tint="?attr/colorPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
