<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:background="@drawable/rounded_background_24"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
    android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
    android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic">
    <org.xplatform.uikit.components.header.DsHeader
        android:id="@+id/titleShimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginRight="@dimen/space_12"
        android:layout_marginHorizontal="@dimen/space_12"
        app:horizontalMarginStart="@dimen/space_4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llShimmers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="@dimen/size_144"
            android:layout_height="@dimen/size_96"
            android:radius="@dimen/radius_16"
            android:layout_marginStart="@dimen/space_12"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="@dimen/size_144"
            android:layout_height="@dimen/size_96"
            android:radius="@dimen/radius_16"
            android:layout_marginStart="@dimen/space_8"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="@dimen/size_144"
            android:layout_height="@dimen/size_96"
            android:radius="@dimen/radius_16"
            android:layout_marginStart="@dimen/space_8"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="@dimen/size_144"
            android:layout_height="@dimen/size_96"
            android:radius="@dimen/radius_16"
            android:layout_marginStart="@dimen/space_8"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="@dimen/size_144"
            android:layout_height="@dimen/size_96"
            android:radius="@dimen/radius_16"
            android:layout_marginStart="@dimen/space_8"/>
        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:layout_width="@dimen/size_144"
            android:layout_height="@dimen/size_96"
            android:radius="@dimen/radius_16"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_12"/>
    </LinearLayout>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/balanceShimmer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_56"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_12"
        android:radius="@dimen/radius_16"
        android:layout_marginHorizontal="@dimen/space_12"/>
</LinearLayout>
