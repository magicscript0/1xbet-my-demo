<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parent"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:gravity="center_vertical"
        android:id="@+id/tv_action_favorite"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/favorites_add"
        android:drawablePadding="@dimen/space_16"
        android:paddingHorizontal="@dimen/space_16"
        app:drawableStartCompat="@drawable/ic_favorite_inactive_dialog"
        app:drawableTint="?attr/uikitSecondary"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/uikitSeparator30"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:gravity="center_vertical"
        android:id="@+id/tv_add_to_home_screen"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/add_to_home_screen"
        android:drawablePadding="@dimen/space_16"
        android:paddingHorizontal="@dimen/space_16"
        app:drawableStartCompat="@drawable/ic_add_to_home_screen_new"
        app:drawableTint="?attr/uikitSecondary"/>
</LinearLayout>
