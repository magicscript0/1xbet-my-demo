<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cybergame_synthetic_card_game_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cyber_games_synthetic_card_game_height">
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:id="@+id/tvMatchDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="start"
        android:id="@+id/tvFirstPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:textDirection="ltr"
        android:layout_marginStart="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="@+id/firstPlayerScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"/>
    <include
        android:id="@+id/firstPlayerRound"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toStartOf="@+id/firstPlayerScore"
        app:layout_constraintStart_toStartOf="@+id/tvFirstPlayerName"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstPlayerName"
        layout="@layout/synthetic_highervslower_round_item"/>
    <include
        android:id="@+id/firstPlayerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/firstPlayerRound"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toEndOf="@+id/firstPlayerRound"
        app:layout_constraintTop_toTopOf="@+id/firstPlayerRound"
        layout="@layout/synthetic_highervslower_score_item"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:gravity="end"
        android:id="@+id/tvSecondPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:textDirection="ltr"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/secondPlayerScore"
        app:layout_constraintTop_toBottomOf="@+id/tvMatchDescription"/>
    <include
        android:id="@+id/secondPlayerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/secondPlayerRound"
        app:layout_constraintEnd_toStartOf="@+id/secondPlayerRound"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/secondPlayerRound"
        layout="@layout/synthetic_highervslower_score_item"/>
    <include
        android:id="@+id/secondPlayerRound"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="@+id/tvSecondPlayerName"
        app:layout_constraintStart_toEndOf="@+id/secondPlayerScore"
        app:layout_constraintTop_toBottomOf="@+id/tvSecondPlayerName"
        layout="@layout/synthetic_highervslower_round_item"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
