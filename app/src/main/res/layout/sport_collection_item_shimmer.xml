<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flShimmerContainer"
    android:background="@drawable/bg_rounded_corners_12_content_background"
    android:layout_width="@dimen/size_56"
    android:layout_height="@dimen/size_64">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:radius="@dimen/radius_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSShimmer.Primary"/>
</FrameLayout>
