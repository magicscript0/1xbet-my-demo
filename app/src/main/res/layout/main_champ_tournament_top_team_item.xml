<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/teamContainer"
            android:background="@drawable/the_international_tournament_top_team_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivTeam"
                android:paddingLeft="@dimen/space_4"
                android:paddingTop="@dimen/space_10"
                android:paddingRight="@dimen/space_4"
                android:paddingBottom="@dimen/space_10"
                android:layout_width="@dimen/size_44"
                android:layout_height="@dimen/size_58"
                android:layout_margin="@dimen/space_10"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/ivPartnerBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_x_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivFirstWinBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-2dp"
            android:src="@drawable/ic_aegis_badge"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ImageView
            android:id="@+id/ivSecondWinBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_aegis_badge"
            android:layout_marginEnd="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="@+id/ivFirstWinBadge"
            app:layout_constraintEnd_toEndOf="@+id/ivFirstWinBadge"
            app:layout_constraintTop_toTopOf="@+id/ivFirstWinBadge"/>
        <ImageView
            android:id="@+id/ivThirdWinBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_aegis_badge"
            android:layout_marginEnd="@dimen/space_12"
            app:layout_constraintBottom_toBottomOf="@+id/ivSecondWinBadge"
            app:layout_constraintEnd_toEndOf="@+id/ivSecondWinBadge"
            app:layout_constraintTop_toTopOf="@+id/ivSecondWinBadge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.AppTheme.Caption.Medium"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/tvTeamName"
        android:layout_width="@dimen/size_64"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:lines="2"/>
</LinearLayout>
