<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:background="@drawable/bg_rounded_top_corners_8dp_mask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:minHeight="@dimen/size_64"
        android:elevation="@dimen/elevation_2"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginHorizontal="@dimen/space_8">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/dateAndTagFlow"
            android:layout_width="@dimen/size_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            app:constraint_referenced_ids="tvDate,tvFreeToto,tvLive,tvPromo,tvEventTag, autoSubTag"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="@dimen/space_4"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="@dimen/space_2"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toTopOf="@+id/tvType"
            app:layout_constraintEnd_toStartOf="@+id/imageBellContainer"
            app:layout_constraintStart_toEndOf="@+id/ivSubGameImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/space_16"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tvLive"
            android:background="@drawable/bg_rounded_corners_4dp_red_soft"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_14"
            android:layout_marginStart="@dimen/space_4">
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/white_circle"
                android:layout_width="@dimen/size_3"
                android:layout_height="@dimen/size_3"
                android:layout_marginStart="@dimen/space_4"/>
            <TextView
                android:textAppearance="?attr/textAppearanceOverlineBold"
                android:textColor="@color/static_white"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/live_game"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/space_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivSubGameImage"
            android:visibility="gone"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceOverlineBold"
            android:textSize="@dimen/text_10"
            android:textColor="@color/static_white"
            android:gravity="center_vertical"
            android:id="@+id/tvPromo"
            android:background="@drawable/bg_rounded_corners_4dp_primary_new"
            android:paddingLeft="@dimen/space_4"
            android:paddingRight="@dimen/space_4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_14"
            android:text="@string/promo"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/space_4"
            android:paddingHorizontal="@dimen/space_4"/>
        <TextView
            android:textAppearance="?attr/textAppearanceOverlineBold"
            android:textSize="@dimen/text_10"
            android:textColor="?attr/uikitStaticWhite"
            android:id="@+id/tvEventTag"
            android:background="@drawable/bg_rounded_corners_4dp_primary_new"
            android:paddingLeft="@dimen/space_4"
            android:paddingRight="@dimen/space_4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_14"
            android:layout_marginStart="@dimen/space_4"
            android:backgroundTint="?attr/uikitStaticPurple"
            android:paddingHorizontal="@dimen/space_4"/>
        <ImageView
            android:id="@+id/autoSubTag"
            android:background="@drawable/circle_background_primary"
            android:paddingLeft="@dimen/space_2"
            android:paddingRight="@dimen/space_2"
            android:layout_width="@dimen/size_14"
            android:layout_height="@dimen/size_14"
            android:src="@drawable/ic_glyph_move_horizontal_large"
            android:paddingHorizontal="@dimen/space_2"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionNew"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginStart="@dimen/space_16"
            app:layout_goneMarginStart="@dimen/space_16"/>
        <TextView
            android:textAppearance="?attr/textAppearanceOverlineBold"
            android:textColor="@color/static_white"
            android:id="@+id/tvFreeToto"
            android:background="@drawable/rounded_background_4"
            android:paddingLeft="@dimen/space_4"
            android:paddingRight="@dimen/space_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/free_toto_history"
            android:layout_marginStart="@dimen/space_16"
            android:backgroundTint="@color/static_green"
            android:paddingHorizontal="@dimen/space_4"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2Bold"
            android:textSize="@dimen/text_18"
            android:textColor="?attr/uikitTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_10"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/space_16"
            app:autoSizeMaxTextSize="@dimen/text_18"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/center"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/ivSubGameImage"
            app:layout_constraintTop_toBottomOf="@+id/dateAndTagFlow"
            app:layout_constraintWidth_max="wrap"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/uikitTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvNumberSymbol"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/number_symbol"
            android:maxLines="2"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_4"
            app:autoSizeMaxTextSize="@dimen/text_14"
            app:autoSizeMinTextSize="@dimen/text_9"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@+id/tvType"
            app:layout_constraintEnd_toStartOf="@+id/tvNumber"
            app:layout_constraintStart_toEndOf="@+id/tvType"
            app:layout_constraintTop_toTopOf="@+id/tvType"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/uikitTextPrimary"
            android:gravity="center_vertical"
            android:id="@+id/tvNumber"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:layout_marginEnd="@dimen/space_8"
            app:autoSizeMaxTextSize="@dimen/text_14"
            app:autoSizeMinTextSize="@dimen/text_9"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@+id/tvType"
            app:layout_constraintEnd_toStartOf="@+id/imageBellContainer"
            app:layout_constraintStart_toEndOf="@+id/tvNumberSymbol"
            app:layout_constraintTop_toTopOf="@+id/tvType"/>
        <FrameLayout
            android:id="@+id/imageBellContainer"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:paddingStart="@dimen/space_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imageMoreContainer"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/imageBell"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="?attr/uikitPrimary"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/imageMoreContainer"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:paddingStart="@dimen/space_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/imageMore"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_action_more"
                app:tint="?attr/uikitPrimary"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <org.xplatform.ui_core.viewcomponents.views.TicketDividerWithShadowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_2"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom"
        android:background="@drawable/bg_rounded_bottom_corners_8dp"
        android:paddingTop="@dimen/space_10"
        android:paddingBottom="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:elevation="@dimen/elevation_2"
        android:backgroundTint="?attr/uikitBackgroundContent"
        android:layout_marginHorizontal="@dimen/space_8">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvBetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvBetDescription"
            app:layout_constraintStart_toEndOf="@+id/betTitleImage"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
            android:id="@+id/tvBetDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvBetTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvChampName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvBetTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvBetTitle"/>
        <ImageView
            android:id="@+id/betTitleImage"
            android:layout_width="@dimen/size_16"
            android:layout_height="@dimen/size_16"
            android:layout_marginTop="@dimen/space_2"
            app:layout_constraintBottom_toBottomOf="@+id/tvChampName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/aggregatorBetTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvAggregatorBetTypeTitle,tvAggregatorBetType"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:ellipsize="end"
            android:id="@+id/tvAggregatorBetTypeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvAggregatorBetType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvChampName"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvAggregatorBetType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAggregatorBetTypeTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/coefGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvBetCoefTitle,tvBetCoef"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvBetCoeffTypeTitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvBetCoef"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAggregatorBetTypeTitle"
            app:layout_goneMarginTop="@dimen/space_16"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvBetCoeffType"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tvBetCoeffTypeTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetCoeffTypeTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/grSubGameGroup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvBetTitleSubgame, tvSubgameBet, tvSubgameCoef"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvBetTitleSubgame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding_8"
            app:layout_constraintEnd_toStartOf="@+id/tvSubgameCoef"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBetCoeffType"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvSubgameBet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvSubgameCoef"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBetTitleSubgame"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1MediumNew"
            android:textColor="?attr/uikitTextPrimary"
            android:gravity="center"
            android:id="@+id/tvSubgameCoef"
            android:background="@drawable/transaction_history_rectangle_corn"
            android:paddingLeft="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingRight="@dimen/space_12"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="ltr"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/tvSubgameBet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetTitleSubgame"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvBetCoefTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvBetCoef"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubgameBet"
            app:layout_goneMarginTop="@dimen/space_16"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvBetCoef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="ltr"
            app:layout_constraintBottom_toBottomOf="@+id/tvBetCoefTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetCoefTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/betValueGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvBetValueTitle,tvBetValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvBetValueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvBetValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBetCoefTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvBetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetValueTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/taxExciseGroup"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTaxExciseTitle,tvTaxExciseValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvTaxExciseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvTaxExciseValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBetValueTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvTaxExciseValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTaxExciseTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vatTaxGroup"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvVatTaxTitle,tvVatTaxValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvVatTaxTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvVatTaxValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTaxExciseTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvVatTaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvVatTaxTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/stakeAfterTaxGroup"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvStakeAfterTaxTitle,tvStakeAfterTaxValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvStakeAfterTaxTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvStakeAfterTaxValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvVatTaxTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvStakeAfterTaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvStakeAfterTaxTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/taxGroup"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTaxTitle,tvTaxValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvTaxTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvTaxValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStakeAfterTaxTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvTaxValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTaxTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/taxFeeGroup"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTaxFeeTitle,tvTaxFeeValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvTaxFeeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvTaxFeeValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTaxTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvTaxFeeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTaxFeeTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/betWinGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvBetWinTitle,tvBetWin"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvBetWinTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvBetWin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTaxFeeTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvBetWin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetWinTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/payoutGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="payoutTitle,payoutSum"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/payoutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textDirection="locale"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/payoutSum"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBetWinTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/payoutSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/payoutTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/autoSaleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvAutoSaleTitle,tvAutoSaleValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvAutoSaleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/auto_sale_order_with_colon"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/tvAutoSaleValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/payoutTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/tvAutoSaleValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAutoSaleTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/advanceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="advanceTitle,advanceValue"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/advanceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/advance_with_colon"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/advanceValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAutoSaleTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/advanceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/advanceTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/statusGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvBetStatusTitle,imageBetStatus,tvBetStatus"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/tvBetStatusTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/status_with_colon"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintEnd_toStartOf="@+id/imageBetStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/advanceTitle"/>
        <ImageView
            android:id="@+id/imageBetStatus"
            android:layout_width="@dimen/space_16"
            android:layout_height="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/tvBetStatus"
            app:layout_constraintEnd_toStartOf="@+id/tvBetStatus"
            app:layout_constraintTop_toTopOf="@+id/tvBetStatus"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody2Bold"
            android:textColor="@color/static_green"
            android:id="@+id/tvBetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvBetStatusTitle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceCaptionNew"
            android:id="@+id/tvApproveId"
            android:background="@drawable/rounded_background_8"
            android:padding="@dimen/space_8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:backgroundTint="?attr/uikitBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBetStatusTitle"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/sellButtonTopBarrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvApproveId, tvBetWinTitle"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/flSale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:backgroundTint="?attr/uikitBackgroundContent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sellButtonTopBarrier">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                style="@style/Widget.AppTheme.SolidButton.New"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
