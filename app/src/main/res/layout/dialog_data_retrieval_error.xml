<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/size_400">
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/errorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_32"
        android:layout_marginRight="@dimen/space_32"
        android:layout_marginHorizontal="@dimen/space_32"
        style="@style/TextStyle.Headline.Regular"/>
</FrameLayout>
