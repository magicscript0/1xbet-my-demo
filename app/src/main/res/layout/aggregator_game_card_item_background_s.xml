<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardImageView
        android:id="@+id/ivBanner"
        android:tag="bannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_4"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:shapeAppearance="@style/ShapeAppearance.Radius12"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llActionCard"
        android:background="@drawable/rounded_background_16_content"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/space_8">
        <ImageView
            android:id="@+id/ivActionCardIcon"
            android:layout_width="@dimen/size_20"
            android:layout_height="@dimen/size_20"
            android:layout_marginBottom="@dimen/space_12"
            app:tint="?attr/uikitPrimary"/>
        <TextView
            android:textColor="?attr/uikitPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvActionCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/TextAppearance.Text.Medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:layout_gravity="start|bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:minHeight="@dimen/size_52"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/space_8">
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:maxLines="1"
            style="@style/TextStyle.Text.Medium.TextPrimary"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.view.GameCardBackgroundLTag
                android:ellipsize="end"
                android:id="@+id/tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/space_4"
                style="@style/Widget.DSTag.RectangularS.Primary"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/TextStyle.Caption.Regular.L.Secondary"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/viewAction"
        android:layout_width="@dimen/size_48"
        android:layout_height="@dimen/size_48"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/ivAction"
        android:background="@drawable/rounded_background_10"
        android:padding="@dimen/space_6"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:layout_margin="@dimen/space_8"
        android:contentDescription="@null"
        android:backgroundTint="?attr/uikitStaticBlack60"
        app:tint="?attr/uikitStaticWhite"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:radius="@dimen/radius_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
