<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:showSeparator="true"
        app:showShadow="false"
        app:title="@string/registration"
        style="@style/Widgets.BasicNavigationBar.Subtitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContent"
        android:paddingTop="@dimen/space_12"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintBottom_toTopOf="@+id/flBtnRegistrationContainer"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
    <FrameLayout
        android:id="@+id/flBtnRegistrationContainer"
        android:background="@drawable/background_register_btn"
        android:padding="@dimen/space_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_8"
        app:layout_constraintBottom_toBottomOf="parent">
        <org.xplatform.uikit.components.buttons.DsButton
            android:id="@+id/btnRegistration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:dsButtonLabel="@string/offer_to_auth_registration_button"
            style="@style/DSButton.Large.Commerce"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ffProgress"
        android:background="@color/static_black_60"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/elevation_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/navigationBar">
        <org.xplatform.uikit.components.loader.DsLoader
            android:layout_gravity="center"
            android:id="@+id/lLoader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            style="@style/Widget.DSLoader"/>
    </FrameLayout>
    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/lecLottie"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/navigationBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
