<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.views.LoadableShapeableImageView
        android:id="@+id/uikitCategoryCardPicture"
        android:tag="categoryCardPicture"
        android:layout_width="@dimen/size_84"
        android:layout_height="@dimen/size_128"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.Radius16"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start|bottom"
        android:layout_gravity="bottom"
        android:id="@+id/uikitCategoryCardLabel"
        android:layout_width="@dimen/size_68"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/space_8"
        style="@style/TextStyle.Caption.Bold.L.StaticWhite"/>
</merge>
