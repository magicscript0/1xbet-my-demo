<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:background="@drawable/bg_rounded_corners_12dp"
    android:paddingLeft="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingRight="@dimen/space_16"
    android:paddingBottom="@dimen/space_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_60"
    android:backgroundTint="?attr/uikitBackgroundContent"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">
    <ImageView
        android:id="@+id/ivIcon"
        android:visibility="gone"
        android:layout_width="@dimen/icon_size_16"
        android:layout_height="@dimen/icon_size_16"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"/>
    <TextView
        android:textSize="@dimen/text_16"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginStart="@dimen/space_8"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_autosize_step_2"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        style="@style/TextStyle.Text.Medium.TextPrimary"/>
    <TextView
        android:id="@+id/tvDescription"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_goneMarginTop="0dp"
        style="@style/TextStyle.Text.Regular.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
