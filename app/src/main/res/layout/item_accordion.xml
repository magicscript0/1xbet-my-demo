    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/size_64">
    <org.xplatform.uikit.components.cells.left.DsCellLeftIcon
        android:id="@+id/icon"
        style="@style/Widget.DSCell.Left.Icon.Back"/>
    <org.xplatform.uikit.components.cells.middle.DsCellMiddleTitle
        android:id="@+id/title"
        style="@style/Widget.DSCell.Middle.Title.L"/>
    <org.xplatform.uikit.components.cells.right.DsCellRightAccordion
        android:id="@+id/accordion"
        style="@style/Widget.DSCell.Right.Accordion"/>
</org.xplatform.uikit.components.cells.DsSettingsCell>
