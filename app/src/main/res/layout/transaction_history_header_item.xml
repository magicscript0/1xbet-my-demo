<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.ui_core.viewcomponents.views.TicketDividerWithShadowLayout
        android:id="@+id/ticketDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_76"
        android:translationZ="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_4"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        app:cardBackgroundColor="?attr/uikitBackground">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_rounded_top_corners_8dp_mask"
                android:paddingBottom="@dimen/space_8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_64"
                android:backgroundTint="?attr/uikitBackgroundContent">
                <TextView
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?attr/uikitSecondary"
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginStart="@dimen/space_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2Bold"
                    android:textSize="@dimen/text_18"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDate"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginStart="@dimen/space_8"
                    app:layout_constraintBottom_toBottomOf="@+id/tvType"
                    app:layout_constraintStart_toEndOf="@+id/tvType"
                    app:layout_constraintTop_toTopOf="@+id/tvType"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <org.xplatform.ui_core.viewcomponents.views.TicketDivider
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_12"
                app:ticketBottomBackgroundColor="?attr/uikitBackgroundContent"
                app:ticketDividerColor="?attr/uikitSeparator"
                app:ticketDividerWidth="@dimen/size_1"
                app:ticketTopBackgroundColor="?attr/uikitBackgroundContent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom"
                android:background="@drawable/bg_rounded_bottom_corners_8dp"
                android:paddingTop="@dimen/space_10"
                android:paddingBottom="@dimen/space_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:backgroundTint="?attr/uikitBackgroundContent">
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="?attr/uikitSecondary"
                    android:id="@+id/tvBetCoefTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/coefficient_with_colon"
                    android:layout_marginEnd="@dimen/space_8"
                    app:layout_constraintEnd_toStartOf="@+id/tvBetCoef"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2Bold"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvBetCoef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/tvBetCoefTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvBetCoefTitle"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="?attr/uikitSecondary"
                    android:id="@+id/tvBetValueTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/starting_bet"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBetCoefTitle"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2Bold"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvBetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBetCoefTitle"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="?attr/uikitSecondary"
                    android:id="@+id/tvReceivedSumTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/history_bill_received"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBetValueTitle"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2Bold"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvReceivedSum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBetValueTitle"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="?attr/uikitSecondary"
                    android:id="@+id/tvCurrentValueTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/current_sum_with_colon"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvReceivedSumTitle"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2Bold"
                    android:textColor="?attr/uikitTextPrimary"
                    android:id="@+id/tvCurrentValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvReceivedSumTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
