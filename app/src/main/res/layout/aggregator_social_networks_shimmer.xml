<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerSocialHeaderCenter"
        android:layout_width="@dimen/space_128"
        android:layout_height="@dimen/space_24"
        android:radius="@dimen/radius_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSShimmer"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerSocialHeaderRight"
        android:layout_width="@dimen/space_128"
        android:layout_height="@dimen/space_24"
        android:radius="@dimen/radius_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSShimmer"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerSocialSubHeaderCenter"
        android:layout_width="@dimen/size_198"
        android:layout_height="@dimen/size_14"
        android:radius="@dimen/radius_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerSocialHeaderCenter"
        style="@style/Widget.DSShimmer"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerSocialSubHeaderRight"
        android:layout_width="@dimen/size_160"
        android:layout_height="@dimen/size_14"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_16"
        android:layout_marginStart="@dimen/extra_large_horizontal_margin_dynamic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerSocialHeaderRight"
        style="@style/Widget.DSShimmer"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerContent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_144"
        android:layout_marginLeft="@dimen/large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/size_10"
        android:layout_marginRight="@dimen/large_horizontal_margin_dynamic"
        android:radius="@dimen/radius_16"
        android:layout_marginHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.DSShimmer"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSocialNetworksShimmer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
