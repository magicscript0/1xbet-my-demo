<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivGameBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/statistic_background_image_height"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/default_background"/>
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/staticNavigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:backgroundColor="?attr/uikitStaticTransparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationBarStyle="title"
        app:navigationIconTint="?attr/uikitStaticWhite"
        app:showSeparator="false"
        app:title="@string/statistic_info_players_stat"
        app:titleTextColor="?attr/uikitStaticWhite"/>
    <org.xplatform.statistic.statistic_core.presentation.view.CoreHeadView
        android:id="@+id/teamCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/staticNavigationBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:background="@drawable/background_round_statuses"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layoutDirection="ltr"
        android:backgroundTint="?attr/uikitBackgroundContent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teamCardView">
        <org.xplatform.uikit.components.segmented_control.DsSegmentedGroup
            android:theme="?attr/uikitTheme"
            android:id="@+id/teamTabs"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_8"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginVertical="@dimen/space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rvInnings"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:overScrollMode="never"
            android:paddingStart="@dimen/space_12"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/teamTabs"/>
        <org.xplatform.ui_core.viewcomponents.views.scrollable_table.scrollable.ScrollablePanel
            android:id="@+id/scrollablePanel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_8"
            app:layout_constraintBottom_toTopOf="@+id/flResultContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvInnings"/>
        <FrameLayout
            android:id="@+id/flResultContainer"
            android:background="@drawable/bg_rounded_top_corners_16dp_new"
            android:paddingLeft="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingRight="@dimen/space_16"
            android:paddingBottom="@dimen/space_24"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="@dimen/elevation_8"
            android:backgroundTint="?attr/uikitBackgroundContent"
            android:paddingHorizontal="@dimen/space_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="center_vertical"
                android:id="@+id/btnResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_results_caps"
                style="@style/Widget.AppTheme.SolidButton.New"/>
        </FrameLayout>
        <org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout
            android:orientation="vertical"
            android:id="@+id/shimmers"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include layout="@layout/shimmer_players_statistic_cricket"/>
        </org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout>
        <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
            android:id="@+id/lottieEmptyView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvInnings"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
