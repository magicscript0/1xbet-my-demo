<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:textColor="@color/static_white"
        android:layout_gravity="center"
        android:id="@+id/game_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_gravity="center"
        android:id="@+id/title_shimmer"
        android:background="@drawable/loader_title"
        android:layout_width="@dimen/space_64"
        android:layout_height="@dimen/space_12"/>
</FrameLayout>
