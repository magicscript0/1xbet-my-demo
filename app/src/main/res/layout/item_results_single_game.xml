<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_4"
    android:elevation="@dimen/elevation_2">
    <ImageView
        android:id="@+id/champ_icon"
        android:padding="@dimen/space_8"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/champ_name"
        app:layout_constraintEnd_toStartOf="@+id/champ_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/uikitSecondary"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:id="@+id/champ_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/champ_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/champ_icon"
        app:layout_constraintTop_toTopOf="@+id/champ_icon"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2New"
        android:gravity="center"
        android:id="@+id/game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/champ_name"
        app:layout_goneMarginBottom="@dimen/space_8"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:gravity="center"
        android:id="@+id/date"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game"
        app:layout_goneMarginBottom="@dimen/space_8"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:gravity="center"
        android:id="@+id/info"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        app:layout_constraintBottom_toTopOf="@+id/info_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/date"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumHighlightNew"
        android:textSize="@dimen/text_12"
        android:gravity="center_vertical"
        android:id="@+id/info_button"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:minHeight="@dimen/size_24"
        android:text="@string/additional_info"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
