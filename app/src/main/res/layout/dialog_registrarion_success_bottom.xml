<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:id="@+id/registrationSuccessDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/iconSpacing"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivSuccessLogoGradient"
        android:background="@drawable/background_new_circle"
        android:padding="@dimen/space_16"
        android:layout_width="@dimen/size_72"
        android:layout_height="@dimen/size_72"
        android:backgroundTint="?attr/uikitCommerceTint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconSpacing"
        app:srcCompat="@drawable/circle"
        app:tint="@color/static_white"/>
    <ImageView
        android:id="@+id/successLogo"
        android:layout_width="@dimen/size_40"
        android:layout_height="@dimen/size_40"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/ivSuccessLogoGradient"
        app:layout_constraintEnd_toEndOf="@+id/ivSuccessLogoGradient"
        app:layout_constraintStart_toStartOf="@+id/ivSuccessLogoGradient"
        app:layout_constraintTop_toTopOf="@+id/ivSuccessLogoGradient"
        app:srcCompat="@drawable/ic_glyph_circle_check"
        app:tint="?attr/uikitCommerce"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/successTitleSpacing"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivSuccessLogoGradient"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetTitle
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/successTitle"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/successful_registraration"
        android:maxLines="2"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/successTitleSpacing"
        style="@style/TextStyle.Title.Bold.M"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/loginPasswordContainerSpacing"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/successTitle"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/loginPasswordContainer"
        android:background="@drawable/round_background_16"
        android:padding="@dimen/space_16"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:backgroundTint="?attr/uikitBackground"
        android:layout_marginHorizontal="@dimen/space_16"
        app:constraint_referenced_ids="loginFlowElements,passwordFlowElements"
        app:flow_maxElementsWrap="1"
        app:flow_verticalGap="@dimen/space_16"
        app:flow_verticalStyle="packed"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginPasswordContainerSpacing"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/loginFlowElements"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_16"
        app:constraint_referenced_ids="loginTitle,login"
        app:flow_horizontalGap="@dimen/space_8"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/loginTitle"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:text="@string/login_title_with_colon"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/space_6"
        app:layout_constraintHorizontal_weight="1"
        style="@style/TextStyle.Headline.Regular"/>
    <TextView
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/login"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/space_6"
        app:layout_constraintHorizontal_weight="2"
        style="@style/TextStyle.Title.Bold.S"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/passwordFlowElements"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_16"
        app:constraint_referenced_ids="passwordTitle,password"
        app:flow_horizontalGap="@dimen/space_8"
        app:flow_horizontalStyle="spread_inside"
        app:flow_wrapMode="none"/>
    <TextView
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:id="@+id/passwordTitle"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/password_title_with_colon"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/space_6"
        app:layout_constraintHorizontal_weight="1"
        style="@style/TextStyle.Headline.Regular"/>
    <TextView
        android:textColor="?attr/uikitTextPrimary"
        android:ellipsize="end"
        android:gravity="end"
        android:id="@+id/password"
        android:layout_width="@dimen/size_0"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textDirection="locale"
        android:layoutDirection="locale"
        android:layout_marginStart="@dimen/space_6"
        app:layout_constraintHorizontal_weight="2"
        style="@style/TextStyle.Title.Bold.S"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/copySendButtonsSpacing"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginPasswordContainer"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/TextAppearance.Text.Medium"
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/copyLoginPassword"
        android:background="@drawable/round_background_16"
        android:padding="@dimen/space_12"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_48"
        android:layout_marginBottom="@dimen/space_16"
        android:minWidth="@dimen/size_80"
        android:minHeight="@dimen/size_36"
        android:text="@string/copy_info"
        android:maxLines="1"
        android:paddingStart="@dimen/space_8"
        android:layout_marginStart="@dimen/space_16"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_autosize_step_1"
        app:autoSizeTextType="uniform"
        app:backgroundTint="?attr/uikitBackground"
        app:icon="@drawable/ic_glyph_copy"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_8"
        app:iconSize="@dimen/size_20"
        app:iconTint="?attr/uikitSecondary"
        app:layout_constraintEnd_toStartOf="@+id/sendLoginPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/copySendButtonsSpacing"
        app:shapeAppearance="@style/ShapeAppearance.Radius10"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/TextAppearance.Text.Medium"
        android:textColor="?attr/uikitSecondary"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/sendLoginPassword"
        android:background="@drawable/round_background_16"
        android:padding="@dimen/space_12"
        android:layout_width="@dimen/size_0"
        android:layout_height="@dimen/size_48"
        android:minWidth="@dimen/size_80"
        android:minHeight="@dimen/size_36"
        android:text="@string/share"
        android:maxLines="1"
        android:paddingStart="@dimen/space_8"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeStepGranularity="@dimen/text_autosize_step_1"
        app:autoSizeTextType="uniform"
        app:backgroundTint="?attr/uikitBackground"
        app:icon="@drawable/ic_glyph_share"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_8"
        app:iconSize="@dimen/size_20"
        app:iconTint="?attr/uikitSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/copyLoginPassword"
        app:layout_constraintTop_toBottomOf="@+id/copySendButtonsSpacing"
        app:shapeAppearance="@style/ShapeAppearance.Radius10"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/nextButtonSpacing"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sendLoginPassword"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetButton
        android:id="@+id/nextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextButtonSpacing"
        app:presetButtonStyle="@style/DSButton.Large.Commerce"
        app:presetButtonText="@string/next"/>
    <org.xplatform.uikit.components.bottom_sheet.presets.DsPresetSpacing
        android:id="@+id/bottomSpacing"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nextButton"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/clSnackbarContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/nextButton"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
