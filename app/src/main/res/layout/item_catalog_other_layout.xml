<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/uikitBackgroundContent"
    android:paddingTop="@dimen/space_16"
    android:paddingBottom="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/space_16">
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textSize="@dimen/text_18"
        android:ellipsize="end"
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_toStartOf="@+id/all_view"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
        android:textColor="?attr/uikitPrimary"
        android:id="@+id/all_view"
        android:background="@drawable/bg_rounded_12dp"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/all"
        android:paddingStart="@dimen/space_14"
        android:paddingEnd="13dp"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_alignParentEnd="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/catalog_recycler_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_view"
        android:paddingStart="@dimen/space_16"/>
</RelativeLayout>
