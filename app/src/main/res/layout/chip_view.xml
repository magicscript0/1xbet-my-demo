<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/chipsContainer"
        android:background="@drawable/rounded_background_14"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_32">
        <androidx.cardview.widget.CardView
            android:id="@+id/left_icon"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="@dimen/space_6"
            android:layout_marginStart="@dimen/space_6"
            android:layout_marginEnd="@dimen/space_4"
            android:elevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/texts"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="@dimen/space_6">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/texts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/icon_right"
            app:layout_constraintStart_toEndOf="@+id/left_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="@dimen/space_16"
            app:layout_goneMarginStart="@dimen/space_16">
            <TextView
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:importantForAccessibility="no"
                style="@style/TextStyle.Text.Regular"/>
            <TextView
                android:id="@+id/secondaryText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/space_4"
                style="@style/TextStyle.Text.Medium"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/icon_right"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="@dimen/space_6"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_6"
            android:elevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/texts"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/action"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
