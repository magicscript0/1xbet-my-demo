<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tvPoints"
        android:layout_width="@dimen/size_36"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvRoundDifference"
        android:layout_width="@dimen/size_36"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvPoints"
        app:layout_constraintEnd_toStartOf="@+id/tvPoints"
        app:layout_constraintTop_toTopOf="@+id/tvPoints"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvLosses"
        android:layout_width="@dimen/size_46"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvRoundDifference"
        app:layout_constraintEnd_toStartOf="@+id/tvRoundDifference"
        app:layout_constraintTop_toTopOf="@+id/tvRoundDifference"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvWins"
        android:layout_width="@dimen/size_46"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvLosses"
        app:layout_constraintEnd_toStartOf="@+id/tvLosses"
        app:layout_constraintTop_toTopOf="@+id/tvLosses"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <TextView
        android:textSize="@dimen/text_14"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvNumber"
        android:layout_width="@dimen/size_24"
        android:layout_height="wrap_content"
        android:text="@string/number"
        android:maxLines="1"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Text.Regular.Secondary"/>
    <ImageView
        android:id="@+id/imgTeam"
        android:layout_width="@dimen/size_28"
        android:layout_height="@dimen/size_28"
        android:layout_marginStart="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/tvNumber"
        app:layout_constraintStart_toEndOf="@+id/tvNumber"
        app:layout_constraintTop_toTopOf="@+id/tvNumber"
        app:layout_constraintVertical_bias="0.523"/>
    <TextView
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="@+id/imgTeam"
        app:layout_constraintEnd_toStartOf="@+id/tvWins"
        app:layout_constraintStart_toEndOf="@+id/imgTeam"
        app:layout_constraintTop_toTopOf="@+id/imgTeam"
        style="@style/TextStyle.Text.Regular.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
