<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatar"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
        app:srcCompat="@drawable/ic_user_profile"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messageContainer"
        android:background="@drawable/message_inbox_bg"
        android:paddingLeft="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:textSize="@dimen/text_10"
            android:textColor="@android:color/white"
            android:id="@+id/txtBotLabel"
            android:background="@drawable/bot_label_bg"
            android:paddingLeft="@dimen/space_4"
            android:paddingTop="@dimen/space_2"
            android:paddingRight="@dimen/space_4"
            android:paddingBottom="@dimen/space_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/consultant_label_bot"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingVertical="@dimen/space_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2MediumNew"
            android:textSize="@dimen/text_12"
            android:textColor="?attr/colorPrimary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/txtAuthorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/space_10"
            app:layout_constraintBottom_toTopOf="@+id/recyclerImages"
            app:layout_constraintEnd_toStartOf="@+id/txtBotLabel"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerImages"
            android:layout_width="@dimen/size_338"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <org.xplatform.ui_core.viewcomponents.views.FixedSelectionTextView
            android:textSize="@dimen/text_16"
            android:textColor="?attr/uikitTextPrimary"
            android:textColorLink="?attr/uikitPrimary"
            android:id="@+id/messageTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginTop="@dimen/size_4"
            android:layout_marginRight="@dimen/space_8"
            android:textIsSelectable="true"
            android:textDirection="locale"
            android:layout_marginHorizontal="@dimen/space_8"
            app:layout_constraintBottom_toTopOf="@+id/txtTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recyclerImages"/>
        <TextView
            android:textSize="@dimen/text_10"
            android:textColor="?attr/uikitTextPrimary"
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4"
            android:layout_marginEnd="@dimen/space_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/messageTextView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/imgError"
        android:visibility="invisible"
        android:layout_width="@dimen/size_24"
        android:layout_height="@dimen/size_24"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_8"
        app:srcCompat="@drawable/ic_error_message"/>
</LinearLayout>
