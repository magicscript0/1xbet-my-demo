<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="?attr/uikitBackground"
    android:paddingLeft="@dimen/space_8"
    android:paddingTop="@dimen/space_8"
    android:paddingRight="@dimen/space_8"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_8"
    android:paddingVertical="@dimen/space_8">
    <Button
        android:textSize="@dimen/text_14"
        android:textColor="@color/static_white"
        android:id="@+id/login_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_login"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/space_4"
        android:translationZ="@dimen/elevation_2"
        android:stateListAnimator="@null"
        android:backgroundTint="?attr/uikitPrimary"
        style="@style/Widget.AppTheme.SolidButton.New"/>
    <Button
        android:textSize="@dimen/text_14"
        android:textColor="@color/static_white"
        android:id="@+id/registration_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/registration"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_4"
        android:translationZ="@dimen/elevation_2"
        android:stateListAnimator="@null"
        style="@style/Widget.AppTheme.SolidButton.New.CallToAction"/>
</LinearLayout>
