<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.header.HeaderLarge
        android:id="@+id/header"
        android:tag="tag_header_classic_popular_category"
        android:paddingLeft="@dimen/extra_large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:paddingHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        app:buttonText="@string/filter_all"
        app:title="@string/categories"
        style="@style/Widget.Header"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/headerShimmer"
        android:layout_width="@dimen/size_128"
        android:layout_height="@dimen/size_20"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_10"
        android:radius="@dimen/radius_full"
        android:layout_marginStart="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginVertical="@dimen/space_10"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit_aggregator.aggregatorgamecardcollection.AggregatorGameCardCollection
        android:orientation="horizontal"
        android:id="@+id/rvContent"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        android:layout_marginVertical="0dp"
        style="@style/Widget.AggregatorGameCardCollection.BackgroundL.Horizontal"/>
</LinearLayout>
