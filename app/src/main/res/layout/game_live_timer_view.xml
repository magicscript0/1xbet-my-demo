<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/liveTimerMinutes"
        android:background="@drawable/cybergame_line_timer_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/liveTimerColonOne"
        app:layout_constraintHeight_min="@dimen/space_14"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/liveTimerSeconds"
        app:layout_constraintWidth_min="@dimen/space_26"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:id="@+id/liveTimerColonOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_2"
        android:layout_marginRight="@dimen/space_2"
        android:text="@string/colon_symbol"
        android:layout_marginHorizontal="@dimen/space_2"
        app:layout_constraintBottom_toBottomOf="@+id/liveTimerSeconds"
        app:layout_constraintEnd_toStartOf="@+id/liveTimerSeconds"
        app:layout_constraintStart_toEndOf="@+id/liveTimerMinutes"
        app:layout_constraintTop_toTopOf="@+id/liveTimerMinutes"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/liveTimerSeconds"
        android:background="@drawable/cybergame_line_timer_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        app:layout_constraintBottom_toTopOf="@+id/lineTimerDate"
        app:layout_constraintEnd_toStartOf="@+id/lineTimerColonTwo"
        app:layout_constraintHeight_min="@dimen/space_14"
        app:layout_constraintStart_toEndOf="@+id/liveTimerColonOne"
        app:layout_constraintTop_toBottomOf="@+id/lineTimerDays"
        app:layout_constraintWidth_min="@dimen/space_26"/>
</merge>
