<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSettings"
        android:paddingLeft="@dimen/large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/large_horizontal_margin_dynamic"
        android:paddingBottom="@dimen/space_16"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/large_horizontal_margin_dynamic"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <FrameLayout
        android:id="@+id/flLoader"
        android:background="@color/static_black_60"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <org.xplatform.uikit.components.loader.DsLoader
            android:layout_gravity="center"
            android:id="@+id/lLoader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            style="@style/Widget.DSLoader"/>
    </FrameLayout>
</FrameLayout>
