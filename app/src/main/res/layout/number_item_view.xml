<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/ripple_circle"
    android:padding="@dimen/space_16"
    android:layout_width="@dimen/number_button_size"
    android:layout_height="@dimen/number_button_size"
    app:tint="?attr/uikitSecondary">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6New"
        android:textSize="@dimen/number_button_text_main"
        android:gravity="center"
        android:id="@+id/digit_item_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionMediumNew"
        android:gravity="center"
        android:id="@+id/letters_item_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:autoSizeMaxTextSize="@dimen/text_14"
        app:autoSizeMinTextSize="@dimen/text_10"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"/>
</LinearLayout>
