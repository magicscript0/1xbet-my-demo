<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:layout_marginBottom="@dimen/space_8"
    android:layout_marginVertical="@dimen/space_8">
    <ImageView
        android:id="@+id/terroristsStatIv"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        android:layout_marginLeft="@dimen/space_4"
        android:layout_marginRight="@dimen/space_4"
        android:layout_marginHorizontal="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/indicatorContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/indicatorContainer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/icon_size_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/roundWinIndicator"
            android:background="@drawable/cs2_round_stats_indicator"
            android:layout_width="@dimen/space_24"
            android:layout_height="@dimen/space_4"
            android:backgroundTint="@color/static_white"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/roundTextBackground"
            android:background="@drawable/circled32_rectangle"
            android:layout_width="@dimen/icon_size_14"
            android:layout_height="@dimen/icon_size_12"
            android:backgroundTint="@color/static_white"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/text_10"
        android:textColor="@color/static_black"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/roundText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/space_1"
        android:letterSpacing="0"
        app:layout_constraintBottom_toBottomOf="@+id/indicatorContainer"
        app:layout_constraintEnd_toEndOf="@+id/indicatorContainer"
        app:layout_constraintStart_toStartOf="@+id/indicatorContainer"
        app:layout_constraintTop_toTopOf="@+id/indicatorContainer"/>
    <ImageView
        android:id="@+id/counterTerroristsStatIv"
        android:layout_width="@dimen/icon_size_24"
        android:layout_height="@dimen/icon_size_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/indicatorContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
