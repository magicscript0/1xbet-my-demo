<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="35dp"
    android:layout_marginRight="35dp">
    <ImageView
        android:id="@+id/ticketIv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/lottery_ticket_single"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="1:0.65"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_vertical_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.175"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_horizontal_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.405"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_vertical_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.815"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_horizontal_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.705"/>
    <org.xplatform.bonus_games.impl.lottery.presentation.views.ErasableView
        android:id="@+id/erasable_view"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/guide_horizontal_2"
        app:layout_constraintEnd_toEndOf="@+id/guide_vertical_2"
        app:layout_constraintStart_toStartOf="@+id/guide_vertical_1"
        app:layout_constraintTop_toTopOf="@+id/guide_horizontal_1"/>
    <View
        android:id="@+id/disableView"
        android:background="@color/static_white_60"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ticketIv"
        app:layout_constraintLeft_toLeftOf="@+id/ticketIv"
        app:layout_constraintRight_toRightOf="@+id/ticketIv"
        app:layout_constraintTop_toTopOf="@+id/ticketIv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
