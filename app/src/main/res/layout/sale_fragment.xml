<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHistorySale"
    android:background="?attr/uikitBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layout_constraintBottom_toTopOf="@+id/flSale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <org.xplatform.ui_core.viewcomponents.views.TicketDividerWithShadowLayout
                        android:id="@+id/ticketDivider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_72"
                        android:translationZ="@dimen/space_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/space_8"
                        app:cardBackgroundColor="?attr/uikitBackgroundContent">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateLayoutChanges="true">
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/header"
                                android:background="@drawable/bg_rounded_top_corners_8dp_mask"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/space_64"
                                android:animateLayoutChanges="true"
                                android:backgroundTint="?attr/uikitBackgroundContent">
                                <androidx.constraintlayout.widget.Guideline
                                    android:orientation="vertical"
                                    android:id="@+id/center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintGuide_percent="0.55"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceCaption"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvDescription"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_16"
                                    android:layout_marginStart="@dimen/space_16"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2Bold"
                                    android:textSize="@dimen/text_18"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:gravity="center_vertical"
                                    android:id="@+id/tvType"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:includeFontPadding="false"
                                    android:layout_marginStart="@dimen/space_16"
                                    app:autoSizeMaxTextSize="@dimen/text_18"
                                    app:autoSizeMinTextSize="@dimen/text_9"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform"
                                    app:layout_constrainedWidth="true"
                                    app:layout_constraintEnd_toStartOf="@+id/center"
                                    app:layout_constraintHorizontal_bias="0"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvDescription"
                                    app:layout_constraintWidth_max="wrap"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:gravity="center_vertical"
                                    android:id="@+id/tvNumber"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:maxLines="2"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:autoSizeMaxTextSize="@dimen/text_14"
                                    app:autoSizeMinTextSize="@dimen/text_9"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvType"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/tvType"
                                    app:layout_constraintTop_toTopOf="@+id/tvType"/>
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/tvLive"
                                    android:background="@drawable/bg_rounded_corner_4dp_red_soft"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/space_14"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">
                                    <ImageView
                                        android:background="@drawable/white_circle"
                                        android:layout_width="@dimen/space_4"
                                        android:layout_height="@dimen/space_4"
                                        android:layout_marginStart="@dimen/space_4"/>
                                    <TextView
                                        android:textAppearance="?attr/textAppearanceCaptionBold"
                                        android:textSize="@dimen/text_9"
                                        android:textColor="@color/static_white"
                                        android:gravity="center_vertical"
                                        android:paddingLeft="@dimen/space_4"
                                        android:paddingRight="@dimen/space_4"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:text="@string/live_game"
                                        android:includeFontPadding="false"
                                        android:paddingHorizontal="@dimen/space_4"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/bottom"
                                android:background="?attr/uikitBackgroundContent"
                                android:paddingTop="@dimen/space_10"
                                android:paddingBottom="@dimen/space_16"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_12"
                                android:animateLayoutChanges="true"
                                android:paddingStart="@dimen/space_16"
                                android:paddingEnd="@dimen/space_16">
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvBetCoefTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/coefficient_with_colon"
                                    android:layout_marginEnd="@dimen/space_8"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvBetCoef"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_8"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvBetValueTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:text="@string/history_bet_rate"
                                    android:layout_marginEnd="@dimen/space_8"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvBetCoefTitle"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvBetValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvBetCoefTitle"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvBetCurrentValueTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:text="@string/current_sum_with_colon"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvBetValueTitle"
                                    app:layout_goneMarginTop="@dimen/space_16"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvBetCurrentValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvBetValueTitle"
                                    app:layout_goneMarginTop="@dimen/space_16"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <View
                                android:background="?attr/uikitSeparator"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/space_1"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/saleContainer"
                                android:background="?attr/uikitBackgroundContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:animateLayoutChanges="true">
                                <androidx.constraintlayout.widget.Group
                                    android:id="@+id/autoSaleGroup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:constraint_referenced_ids="tvAutoSaleTitle,tvAutoSaleStartValue,tvAutoSaleEndValue,tvAutoSaleValue,seekBarAutoSale"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvAutoSaleTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_16"
                                    android:text="@string/history_coupon_will_sold_at"
                                    android:layout_marginStart="@dimen/space_16"
                                    android:layout_marginEnd="@dimen/space_76"
                                    app:layout_constraintEnd_toStartOf="@+id/tvAutoSaleValue"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceHeadline5"
                                    android:textColor="?attr/uikitPrimary"
                                    android:gravity="end"
                                    android:id="@+id/tvAutoSaleValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvAutoSaleTitle"
                                    app:layout_constraintEnd_toEndOf="parent"/>
                                <SeekBar
                                    android:gravity="center"
                                    android:id="@+id/seekBarAutoSale"
                                    android:background="@android:color/transparent"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:maxHeight="@dimen/space_6"
                                    android:progressDrawable="@drawable/seek_bar_progress_drawable"
                                    android:thumb="@drawable/seek_bar_thumb"
                                    android:splitTrack="false"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvAutoSaleTitle"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvAutoSaleStartValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_16"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/seekBarAutoSale"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvAutoSaleEndValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/seekBarAutoSale"/>
                                <androidx.constraintlayout.widget.Group
                                    android:id="@+id/newBetGroup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:constraint_referenced_ids="tvNewBetValueTitle,tvNewBetValue,seekBarNewBetValue,tvNewBetStartValue,tvNewBetEndValue"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvNewBetValueTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_42"
                                    android:text="@string/new_sum_coupon"
                                    android:layout_marginStart="@dimen/space_16"
                                    android:layout_marginEnd="@dimen/space_76"
                                    app:layout_constraintEnd_toStartOf="@+id/tvNewBetValue"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvAutoSaleStartValue"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceHeadline5"
                                    android:textColor="?attr/uikitPrimary"
                                    android:gravity="end"
                                    android:id="@+id/tvNewBetValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvNewBetValueTitle"
                                    app:layout_constraintEnd_toEndOf="parent"/>
                                <SeekBar
                                    android:gravity="center"
                                    android:id="@+id/seekBarNewBetValue"
                                    android:background="@android:color/transparent"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:maxHeight="@dimen/space_6"
                                    android:progressDrawable="@drawable/seek_bar_progress_drawable"
                                    android:thumb="@drawable/seek_bar_thumb"
                                    android:splitTrack="false"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintHorizontal_bias="0"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvNewBetValueTitle"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvNewBetStartValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_16"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/seekBarNewBetValue"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvNewBetEndValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/seekBarNewBetValue"/>
                                <androidx.constraintlayout.widget.Group
                                    android:id="@+id/paymentGroup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:constraint_referenced_ids="tvPaymentTitle,tvPaymentValue,seekBarPayment,tvPaymentStartValue,tvPaymentEndValue"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceSubtitle2"
                                    android:textColor="?attr/uikitSecondary"
                                    android:id="@+id/tvPaymentTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_42"
                                    android:text="@string/history_bill_will_credited_with_colon"
                                    android:layout_marginStart="@dimen/space_16"
                                    android:layout_marginEnd="@dimen/space_76"
                                    app:layout_constraintEnd_toStartOf="@+id/tvPaymentValue"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvNewBetStartValue"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceHeadline5"
                                    android:textColor="?attr/uikitPrimary"
                                    android:gravity="end"
                                    android:id="@+id/tvPaymentValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvPaymentTitle"
                                    app:layout_constraintEnd_toEndOf="parent"/>
                                <SeekBar
                                    android:gravity="center"
                                    android:id="@+id/seekBarPayment"
                                    android:background="@android:color/transparent"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:maxHeight="@dimen/space_6"
                                    android:progressDrawable="@drawable/seek_bar_progress_drawable"
                                    android:thumb="@drawable/seek_bar_thumb"
                                    android:splitTrack="false"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvPaymentTitle"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvPaymentStartValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/space_32"
                                    android:progress="50"
                                    android:layout_marginStart="@dimen/space_16"
                                    app:layout_constraintBottom_toTopOf="@+id/infoGroup"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/seekBarPayment"/>
                                <TextView
                                    android:textAppearance="?attr/textAppearanceBody2Bold"
                                    android:textColor="?attr/uikitTextPrimary"
                                    android:id="@+id/tvPaymentEndValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_16"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvPaymentStartValue"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="@+id/tvPaymentStartValue"/>
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/infoGroup"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_16"
                                    android:layout_marginBottom="@dimen/space_16"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvPaymentStartValue">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/infoImage"
                                        android:layout_width="@dimen/space_24"
                                        android:layout_height="@dimen/space_24"
                                        android:tint="?attr/uikitPrimary"
                                        android:layout_marginStart="@dimen/space_16"
                                        app:srcCompat="@drawable/ic_info"/>
                                    <TextView
                                        android:textAppearance="?attr/textAppearanceBody2"
                                        android:textColor="?attr/uikitPrimary"
                                        android:id="@+id/infoText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/only_full_sale_for_coupon"
                                        android:layout_marginStart="@dimen/space_16"/>
                                </LinearLayout>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>
            <View
                android:background="@drawable/background_shade_new"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_24"
                android:layout_marginBottom="-16dp"
                app:layout_constraintBottom_toTopOf="@+id/flSale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/flSale"
                android:background="@drawable/bg_rounded_top_corners_16dp_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/uikitBackgroundContent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center_vertical"
                    android:id="@+id/btnSale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_16"
                    android:text="@string/history_btn_sale"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCancellationReason"
                    style="@style/Widget.AppTheme.SolidButton.New"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <org.xplatform.uikit.components.lottie.LottieView
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <FrameLayout
        android:id="@+id/fl_loading"
        android:background="@color/static_black_20"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationZ="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="?attr/uikitSecondary"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
