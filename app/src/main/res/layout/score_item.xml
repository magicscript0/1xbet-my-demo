<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/topScore"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:maxLength="3"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
    <org.xplatform.uikit.components.separator.DsSeparator
        android:id="@+id/horizontalSeparator"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_2"
        style="@style/Widget.DSSeparator.Separator60"/>
    <TextView
        android:gravity="center"
        android:id="@+id/botScore"
        android:layout_width="@dimen/size_32"
        android:layout_height="@dimen/size_32"
        android:maxLength="3"
        style="@style/TextStyle.Caption.Medium.L.TextPrimary"/>
</LinearLayout>
