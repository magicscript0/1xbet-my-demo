<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.header.DsHeader
        android:id="@+id/header"
        android:paddingLeft="@dimen/extra_large_horizontal_margin_dynamic"
        android:paddingRight="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        app:buttonText="@string/filter_all"
        app:headerType="large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/categories"/>
    <org.xplatform.uikit.components.category_card_collection.DsCategoryCardCollection
        android:orientation="horizontal"
        android:id="@+id/vCategoryCardCollection"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
