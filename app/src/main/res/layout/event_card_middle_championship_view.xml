<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/firstTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:maxLines="2"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/firstTeamLogo"
        style="@style/TextStyle.Text.Medium.Shrink.TextPrimary"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/firstTeamLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/score"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSSportTeamLogo.Size64"/>
    <org.xplatform.uikit.components.counter.DsCounter
        android:id="@+id/firstTeamCounter"
        android:visibility="gone"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:translationX="@dimen/space_4"
        android:translationY="@dimen/space_2"
        app:counterComponentStyle="red_card"
        app:layout_constraintBottom_toBottomOf="@+id/firstTeamLogo"
        app:layout_constraintRight_toRightOf="@+id/firstTeamLogo"/>
    <org.xplatform.uikit_sport.score.SportScore
        android:id="@+id/score"
        android:layout_width="@dimen/size_108"
        android:layout_height="@dimen/size_40"
        app:layout_constraintBottom_toBottomOf="@+id/firstTeamLogo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/firstTeamLogo"
        style="@style/Widget.Score.Large"/>
    <org.xplatform.uikit.components.timer.DsTimer
        android:id="@+id/timer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintLeft_toLeftOf="@+id/score"
        app:layout_constraintRight_toRightOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/score"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/caption"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/score"
        app:layout_constraintRight_toRightOf="@+id/score"
        app:layout_constraintTop_toBottomOf="@+id/timer"
        style="@style/TextStyle.Caption.Regular.M.Secondary"/>
    <org.xplatform.uikit.components.team_logo.DsTeamLogo
        android:id="@+id/secondTeamLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/score"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.DSSportTeamLogo.Size64"/>
    <org.xplatform.uikit.components.counter.DsCounter
        android:id="@+id/secondTeamCounter"
        android:visibility="gone"
        android:layout_width="@dimen/size_16"
        android:layout_height="@dimen/size_16"
        android:translationX="-4dp"
        android:translationY="@dimen/space_2"
        app:counterComponentStyle="red_card"
        app:layout_constraintBottom_toBottomOf="@+id/secondTeamLogo"
        app:layout_constraintLeft_toLeftOf="@+id/secondTeamLogo"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/secondTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:maxLines="2"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toRightOf="@+id/score"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secondTeamLogo"
        style="@style/TextStyle.Text.Medium.Shrink.TextPrimary"/>
</merge>
