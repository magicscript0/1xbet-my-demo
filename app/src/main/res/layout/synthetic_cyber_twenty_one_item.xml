<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cybergame_synthetic_card_game_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cyber_games_synthetic_card_game_height">
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:id="@+id/tvMatchDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:maxLines="2"
        android:textDirection="locale"
        android:layoutDirection="ltr"
        android:layout_marginEnd="@dimen/space_6"
        app:layout_constraintBottom_toTopOf="@+id/vPlayerCardsView"
        app:layout_constraintEnd_toStartOf="@+id/tvPlayerScore"
        app:layout_constraintStart_toStartOf="@+id/vPlayerCardsView"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:id="@+id/tvPlayerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/vPlayerCardsView"
        app:layout_constraintEnd_toEndOf="@+id/vPlayerCardsView"/>
    <View
        android:id="@+id/vPlayerCardsView"
        android:background="@drawable/cybergame_synthetic_card_field_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cyber_games_synthetic_card_field_height"
        android:layout_marginBottom="@dimen/space_32"
        android:layout_marginStart="@dimen/space_24"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vDealerCardsView"
        app:layout_constraintStart_toStartOf="parent"/>
    <org.xplatform.ui_core.CardHorizontalRowView
        android:id="@+id/playerCardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/vPlayerCardsView"
        app:layout_constraintEnd_toEndOf="@+id/vPlayerCardsView"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vPlayerCardsView"
        app:layout_constraintTop_toTopOf="@+id/vPlayerCardsView"
        app:layout_constraintVertical_bias="0"
        app:playing_card_height="@dimen/size_42"
        app:playing_card_width="@dimen/size_30"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/tvDealerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:maxLines="2"
        android:layout_marginStart="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/vDealerCardsView"
        app:layout_constraintEnd_toEndOf="@+id/vDealerCardsView"
        app:layout_constraintStart_toEndOf="@+id/tvDealerScore"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="@dimen/text_12"
        android:textColor="@color/static_white"
        android:id="@+id/tvDealerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@+id/vDealerCardsView"
        app:layout_constraintStart_toStartOf="@+id/vDealerCardsView"/>
    <View
        android:id="@+id/vDealerCardsView"
        android:background="@drawable/cybergame_synthetic_card_field_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/cyber_games_synthetic_card_field_height"
        android:layout_marginBottom="@dimen/space_32"
        android:layout_marginStart="@dimen/space_24"
        android:layout_marginEnd="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vPlayerCardsView"/>
    <org.xplatform.ui_core.CardHorizontalRowView
        android:id="@+id/dealerCardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="@+id/vDealerCardsView"
        app:layout_constraintEnd_toEndOf="@+id/vDealerCardsView"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vDealerCardsView"
        app:layout_constraintTop_toTopOf="@+id/vDealerCardsView"
        app:playing_card_height="@dimen/size_42"
        app:playing_card_width="@dimen/size_30"/>
</androidx.constraintlayout.widget.ConstraintLayout>
