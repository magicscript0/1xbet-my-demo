<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/uikitTheme"
    android:paddingTop="@dimen/space_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/coefBackground"
        android:background="@drawable/rounded_background_16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:backgroundTint="?attr/uikitBackground"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintBottom_toBottomOf="@+id/tvTeamsName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:maxLines="3"
        android:layout_marginStart="@dimen/space_28"
        android:layout_marginEnd="@dimen/space_16"
        android:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/coefView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TextStyle.Headline.Medium.TextPrimary"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tvTeamsName"
        android:paddingBottom="@dimen/space_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/betconstructor_teams"
        android:maxLines="2"
        android:layout_marginStart="@dimen/space_28"
        android:layout_marginEnd="@dimen/space_16"
        android:autoSizeMinTextSize="@dimen/text_12"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/coefView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus"
        style="@style/TextStyle.Caption.Regular.L.Secondary"/>
    <org.xplatform.ui_core.AnimatedCoefficientView
        android:id="@+id/coefView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_28"
        app:coefficientArrowSize="@dimen/size_24"
        app:layout_constraintBottom_toBottomOf="@+id/tvTeamsName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/coefBackground"
        app:textStyle="@style/TextStyle.Title.Bold.M.TextPrimary"/>
    <org.xplatform.uikit.components.segmented_control.DsSegmentedGroup
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginRight="@dimen/space_16"
        android:layout_marginHorizontal="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coefBackground"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
