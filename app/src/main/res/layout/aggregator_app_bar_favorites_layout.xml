<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/uikitBackgroundContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:layout_gravity="top"
        android:id="@+id/collapsingToolbarLayout"
        android:background="?attr/uikitBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_scrollFlags="snap|enterAlways|exitUntilCollapsed|scroll">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/uikitBackgroundContent"
            android:paddingBottom="@dimen/space_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceHeadline5BoldNew"
                android:layout_gravity="top"
                android:id="@+id/tvCollapsingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/favorites_name"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"/>
            <TextView
                android:textAppearance="?attr/textAppearanceCaptionNew"
                android:id="@+id/tvCollapsingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/casino_favorites_description"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"/>
        </LinearLayout>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
    <org.xplatform.ui_core.viewcomponents.tabs.TabLayoutRectangle
        android:id="@+id/tvCollapsingTabLayout"
        android:background="?attr/uikitBackgroundContent"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginStart="@dimen/space_4"
        app:tabGravity="center"
        style="@style/Widget.AppTheme.TabLayout.New"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/viewShadow"
        android:background="@drawable/shadow_reverse"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
</com.google.android.material.appbar.AppBarLayout>
