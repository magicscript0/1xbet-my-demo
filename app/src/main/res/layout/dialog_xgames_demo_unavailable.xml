<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline6MediumNew"
        android:textSize="@dimen/text_20"
        android:textColor="?attr/uikitPrimary"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/attention"/>
    <TextView
        android:textAppearance="?attr/textAppearanceSubtitle1New"
        android:textSize="@dimen/text_16"
        android:textColor="?attr/uikitTextPrimary"
        android:gravity="center"
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/demo_dialog_unavailable_description"/>
    <Button
        android:textSize="@dimen/text_16"
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/offer_to_auth_registration_button"
        android:textAllCaps="false"
        style="@style/Widget.AppTheme.SolidButton.New.Green"/>
    <Button
        android:textSize="@dimen/text_16"
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/offer_to_auth_login_button"
        android:textAllCaps="false"
        style="@style/Widget.AppTheme.SolidButton.New"/>
    <Button
        android:textSize="@dimen/text_16"
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_40"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/demo_dialog_back_to_games_section_button_text"
        android:textAllCaps="false"
        style="@style/Widget.AppTheme.TextButton.New"/>
</LinearLayout>
