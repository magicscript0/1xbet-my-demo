<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?attr/uikitTheme"
    android:orientation="vertical"
    android:background="?attr/uikitBackground"
    android:paddingBottom="@dimen/space_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerItem1"
        android:layout_width="@dimen/size_80"
        android:layout_height="@dimen/size_12"
        android:layout_marginTop="@dimen/space_16"
        android:radius="@dimen/radius_16"
        android:layout_marginStart="@dimen/space_16"
        style="@style/Widget.DSShimmer.Primary"/>
    <org.xplatform.uikit.components.shimmer.DsShimmerView
        android:id="@+id/shimmerItem2"
        android:layout_width="@dimen/size_192"
        android:layout_height="@dimen/size_28"
        android:layout_marginTop="@dimen/space_8"
        android:radius="@dimen/radius_12"
        android:layout_marginStart="@dimen/space_16"
        style="@style/Widget.DSShimmer.Primary"/>
</LinearLayout>
