<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clBaseBottomSheetRootContainer"
    android:background="@drawable/bottom_sheet_corner_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            android:id="@+id/top_view"
            android:background="@drawable/bg_bottom_sheet_top_view"
            android:layout_width="30dp"
            android:layout_height="3dp"
            android:layout_marginTop="@dimen/space_8"/>
        <TextView
            android:textAppearance="?attr/textAppearanceSubtitle2BoldNew"
            android:textSize="@dimen/text_18"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:tag="baseBottomSheetDialogTitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBody1New"
            android:textSize="@dimen/text_14"
            android:textColor="?attr/uikitSecondary"
            android:gravity="center"
            android:id="@+id/tv_sub_title"
            android:paddingLeft="@dimen/space_16"
            android:paddingRight="@dimen/space_16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_20"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginRight="@dimen/space_20"
            android:layout_marginHorizontal="@dimen/space_20"
            android:paddingHorizontal="@dimen/space_16"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="top_view,tv_title,tv_sub_title"/>
        <FrameLayout
            android:id="@+id/container"
            android:tag="baseBottomSheetDialogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/progressView"
        android:background="@color/static_black_60"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <org.xplatform.ui_core.viewcomponents.views.RadialProgressView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
