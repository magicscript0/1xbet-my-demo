<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:theme="?attr/uikitTheme">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:background="@drawable/two_team_score_background"
        android:paddingLeft="@dimen/space_16"
        android:paddingRight="@dimen/space_16"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_96"
        android:layout_margin="@dimen/space_8"
        android:paddingHorizontal="@dimen/space_16">
        <TextView
            android:textColor="?attr/uikitStaticWhite"
            android:id="@+id/tvGameType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Caption.Regular.M"/>
        <org.xplatform.uikit.components.team_logo.DsTeamLogo
            android:id="@+id/ivTeam"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="@+id/tvTeam"
            app:layout_constraintEnd_toStartOf="@+id/tvTeam"
            app:layout_constraintTop_toTopOf="@+id/tvTeam"
            style="@style/Widget.DSSportTeamLogo.Size32.Static"/>
        <TextView
            android:textColor="?attr/uikitStaticWhite"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvTeam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:maxLines="2"
            android:layout_marginStart="@dimen/space_48"
            app:autoSizeMaxTextSize="@dimen/text_14"
            app:autoSizeMinTextSize="@dimen/text_12"
            app:autoSizeStepGranularity="@dimen/text_2"
            app:autoSizeTextType="uniform"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextStyle.Text.Medium"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvGameType,ivTeam,tvTeam"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
