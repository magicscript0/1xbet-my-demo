<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/gameRootView"
    android:background="@color/static_transparent"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/space_8">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_18"
        android:textColor="?attr/uikitTextPrimary"
        android:gravity="center"
        android:layout_gravity="center"
        android:padding="@dimen/space_8"
        android:paddingLeft="@dimen/space_32"
        android:paddingTop="@dimen/space_8"
        android:paddingRight="@dimen/space_32"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:text="@string/games_bet_setting"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/space_8"
        android:paddingHorizontal="@dimen/space_32"
        android:paddingVertical="@dimen/space_8"/>
    <View
        android:background="?attr/uikitSeparator"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_1"
        android:paddingVertical="@dimen/space_8"/>
    <TextView
        android:textColor="?attr/uikitPrimary"
        android:id="@+id/xgames_quick_bet_subtitle"
        android:padding="@dimen/space_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:text="@string/games_quick_bets_subtitle_default"
        android:fontFamily="sans-serif-medium"
        android:layout_marginHorizontal="@dimen/space_8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/space_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_marginRight="@dimen/space_8"
        android:layout_marginHorizontal="@dimen/space_8">
        <androidx.appcompat.widget.AppCompatEditText
            android:gravity="center"
            android:id="@+id/small_bet_value"
            android:background="@drawable/quick_bet_border"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:paddingVertical="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mid_bet_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextAppearance.AppTheme.New.Body2.Medium.Primary"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:gravity="center"
            android:id="@+id/mid_bet_value"
            android:background="@drawable/quick_bet_border"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:inputType="numberDecimal"
            android:layout_marginHorizontal="@dimen/space_8"
            android:paddingVertical="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/max_bet_value"
            app:layout_constraintStart_toEndOf="@+id/small_bet_value"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextAppearance.AppTheme.New.Body2.Medium.Primary"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:gravity="center"
            android:id="@+id/max_bet_value"
            android:background="@drawable/quick_bet_border"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:paddingVertical="@dimen/space_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mid_bet_value"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextAppearance.AppTheme.New.Body2.Medium.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textAppearance="?attr/textAppearanceCaptionNew"
        android:ellipsize="end"
        android:id="@+id/xgames_current_limits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_marginRight="@dimen/space_16"
        android:text="@string/games_quick_bets_range"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/space_16"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/xgames_auto_spin_settings_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/uikitPrimary"
            android:id="@+id/xgames_auto_spin_subtitle"
            android:padding="@dimen/space_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:text="@string/games_auto_spin_subtitle"
            android:fontFamily="sans-serif-medium"
            android:layout_marginHorizontal="@dimen/space_8"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/space_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:layout_marginHorizontal="@dimen/space_8">
            <org.xplatform.core.presentation.bet_settings.ChipView
                android:id="@+id/spin_endless"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:image_drawable="@drawable/ic_infinity"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/spin_5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <org.xplatform.core.presentation.bet_settings.ChipView
                android:id="@+id/spin_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/spin_10"
                app:layout_constraintStart_toEndOf="@+id/spin_endless"
                app:layout_constraintTop_toTopOf="parent"
                app:text="5"/>
            <org.xplatform.core.presentation.bet_settings.ChipView
                android:id="@+id/spin_10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/spin_25"
                app:layout_constraintStart_toEndOf="@+id/spin_5"
                app:layout_constraintTop_toTopOf="parent"
                app:text="10"/>
            <org.xplatform.core.presentation.bet_settings.ChipView
                android:id="@+id/spin_25"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_marginRight="@dimen/space_8"
                android:layout_marginHorizontal="@dimen/space_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/spin_50"
                app:layout_constraintStart_toEndOf="@+id/spin_10"
                app:layout_constraintTop_toTopOf="parent"
                app:text="25"/>
            <org.xplatform.core.presentation.bet_settings.ChipView
                android:id="@+id/spin_50"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/spin_25"
                app:layout_constraintTop_toTopOf="parent"
                app:text="50"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/text_14"
            android:textColor="?attr/uikitSecondary"
            android:id="@+id/xgames_auto_spin_comment"
            android:paddingLeft="@dimen/space_8"
            android:paddingRight="@dimen/space_8"
            android:paddingBottom="@dimen/space_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_8"
            android:layout_marginRight="@dimen/space_8"
            android:text="@string/autospin_comment"
            android:layout_marginHorizontal="@dimen/space_8"
            android:paddingHorizontal="@dimen/space_8"/>
    </LinearLayout>
</LinearLayout>
