<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomViewRootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:theme="?attr/uikitTheme"
    tools:parentTag="android.widget.LinearLayout">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        style="@style/TextStyle.Title.Bold.M"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_32"
        android:gravity="center"
        android:textColor="?attr/uikitTextPrimary"
        android:visibility="gone"
        tools:text="Какой то текст, очень очень очень очень очень длинный текст"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/extra_large_horizontal_margin_dynamic"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_24"
        android:gravity="center"
        android:textSize="@dimen/text_16"
        tools:text="Какой то текст, очень очень очень очень очень длинный текст" />

    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/whatsNewBtn"
        style="@style/DSButton.Large.WarningStatic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_12"
        app:dsButtonLabel="@string/whats_new_question"
        app:dsButtonType="label" />

    <org.xplatform.uikit.components.buttons.DsButton
        android:id="@+id/updateBtn"
        style="@style/DSButton.Large.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        app:dsButtonLabel="@string/update_app_button"
        app:dsButtonType="label" />
</merge>

