<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.xplatform.uikit.components.navigation_bar.DsNavigationBar
        android:id="@+id/navigationBarAggregator"
        app:navigationBarStyle="title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/uikitSecondary"
        app:showShadow="false"
        app:title="@string/gifts_title" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigationBarAggregator">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/static_transparent"
            app:elevation="@dimen/elevation_0">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

                <org.xplatform.uikit.components.account_selection.DsAccountSelection
                    android:id="@+id/accountSelection"
                    style="@style/Widget.DSAccountSelection.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginBottom="@dimen/size_8"
                    android:elevation="@dimen/elevation_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/navigationBarAggregator"
                    app:topUpButtonText="@string/top_up" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <org.xplatform.uikit.components.separator.DsSeparator
                android:id="@+id/dsSeparator"
                style="@style/Widget.DSSeparator.Separator60" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBonuses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/uikitBackground"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_28"
            android:splitMotionEvents="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            tools:itemCount="3"
            tools:visibility="visible" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <org.xplatform.uikit.components.lottie_empty.DSLottieEmptyContainer
        android:id="@+id/lottieErrorView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/static_transparent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/navigationBarAggregator"
        tools:visibility="visible" />

    <org.xplatform.ui_core.viewcomponents.layouts.constraint.ShimmerConstraintLayout
        android:id="@+id/shimmer_aggregator_gift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_56"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigationBarAggregator">

        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:id="@+id/view12"
            style="@style/Widget.DSShimmer.Primary"
            android:layout_width="@dimen/shimmer_size_80"
            android:layout_height="@dimen/shimmer_size_32"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginTop="@dimen/space_12"
            android:radius="@dimen/radius_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <org.xplatform.uikit.components.shimmer.DsShimmerView
            android:id="@+id/view11"
            style="@style/Widget.DSShimmer.Primary"
            android:layout_width="@dimen/shimmer_size_80"
            android:layout_height="@dimen/shimmer_size_32"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginTop="@dimen/space_12"
            android:radius="@dimen/radius_16"
            app:layout_constraintStart_toEndOf="@+id/view12"
            app:layout_constraintTop_toTopOf="parent" />

        <org.xplatform.uikit.components.shimmer.DsShimmerView
            style="@style/Widget.DSShimmer.Primary"
            android:layout_width="@dimen/shimmer_size_80"
            android:layout_height="@dimen/shimmer_size_32"
            android:layout_marginStart="@dimen/space_8"
            android:layout_marginTop="@dimen/space_12"
            android:radius="@dimen/radius_16"
            app:layout_constraintStart_toEndOf="@+id/view11"
            app:layout_constraintTop_toTopOf="parent" />

    </org.xplatform.ui_core.viewcomponents.layouts.constraint.ShimmerConstraintLayout>

    <org.xplatform.ui_core.viewcomponents.layouts.linear.ShimmerLinearLayout
        android:id="@+id/llShimmer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shimmer_aggregator_gift" />

</androidx.constraintlayout.widget.ConstraintLayout>
