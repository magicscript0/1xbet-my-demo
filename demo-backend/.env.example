# ---------------------------------------------------------------------------
# Demo Cashier backend — environment configuration (DEMO ONLY)
# Copy to .env (or export in your shell). NEVER reuse production credentials.
# ---------------------------------------------------------------------------

# Admin bearer token. The Admin UI asks for this value before any write.
# REQUIRED. If empty, /admin/api/* write endpoints are disabled (503).
DEMO_ADMIN_TOKEN=demo-admin-token-change-me

# SQLite database file (created automatically, seeded on first run).
# Relative paths are resolved against the demo-backend/ directory.
DEMO_DB_PATH=data/demo_payments.db

# Network binding for the Demo API + Gateway + Admin.
DEMO_HOST=0.0.0.0
DEMO_PORT=8000

# Gateway-level cache TTL (seconds) for server-rendered demo cashier responses.
DEMO_CACHE_TTL=30

# Display name of the deployment (shown in UI badges).
DEMO_ENV_NAME=Demo Cashier (Isolated)
